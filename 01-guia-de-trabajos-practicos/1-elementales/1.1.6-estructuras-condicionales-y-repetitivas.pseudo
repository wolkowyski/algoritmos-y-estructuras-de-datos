// --------------------------------------------------------------------------
// Ejercicio 1.1.6
// Escriba un algoritmo que permita ingresar 3 valores numéricos y determine
// cuál es el mayor, el medio y el menor. (era el 3 de los complementarios)
// --------------------------------------------------------------------------

Acción Ejercicio1_1_6 es
//Ambiente
    Variables
        a, b, c: Real
        mayor, medio, menor: Real
//Algoritmo
    Escribir ("Ingrese 3 valores numéricos")
    Leer (a, b, c)
        // Primero busco el mayor; los otros dos se ordenan entre sí
        Si (a >= b) y (a >= c) Entonces
            mayor:= a
            Si b >= c Entonces
                medio:= b
                menor:= c
            Sino
                medio:= c
                menor:= b
            FinSi
        Sino
            Si (b >= a) y (b >= c) Entonces
                mayor:= b
                Si a >= c Entonces
                    medio:= a
                    menor:= c
                Sino
                    medio:= c
                    menor:= a
                FinSi
            Sino
                mayor:= c
                Si a >= b Entonces
                    medio:= a
                    menor:= b
                Sino
                    medio:= b
                    menor:= a
                FinSi
            FinSi
        FinSi
    Escribir ("El número mayor es: ", mayor, ", el intermedio es: ", medio, " y el menor es: ", menor)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.7
// Escriba un algoritmo que acepte dos números, calcule la suma e imprima el
// mensaje de acuerdo al resultado obtenido.
//   Suma <= 50 | Suma > 50 y <= 100 | Suma > 100 y <= 200 | Suma > 200
// --------------------------------------------------------------------------

Acción Ejercicio1_1_7 es
//Ambiente
    Variables
        num1, num2, suma: Real
//Algoritmo
    Escribir ("Ingrese 2 números")
    Leer (num1, num2)
        suma:= num1 + num2
        // Según solo sirve para valores puntuales; para rangos uso Si anidados
        Si suma <= 50 Entonces
            Escribir ("El resultado de la suma es menor o igual que 50")
        Sino
            Si suma <= 100 Entonces
                Escribir ("El resultado de la suma es mayor que 50 y menor o igual que 100")
            Sino
                Si suma <= 200 Entonces
                    Escribir ("El resultado de la suma es mayor que 100 y menor o igual que 200")
                Sino
                    Escribir ("El resultado de la suma es mayor que 200")
                FinSi
            FinSi
        FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.8
// Escriba un algoritmo que permita conocer la edad de una persona, con solo
// ingresar la fecha de nacimiento y la fecha actual, ambas en el formato:
// DIA, MES, AÑO
// --------------------------------------------------------------------------

Acción Ejercicio1_1_8 es
//Ambiente
    Variables
        DiaA, DiaN: 1..31
        MesA, MesN: 1..12
        AñoA, AñoN: N(4)
        Edad: Entero
//Algoritmo
    Escribir ("Ingrese día, mes y año actual")
    Leer (DiaA, MesA, AñoA)
    Escribir ("Ingrese día, mes y año de nacimiento")
    Leer (DiaN, MesN, AñoN)
        Edad:= AñoA - AñoN
            // Si todavía no cumplió años este año, le resto uno
            Si ((MesN = MesA) y (DiaN > DiaA)) o (MesN > MesA) Entonces
                Edad:= Edad - 1
            FinSi
    Escribir ("La edad es: ", Edad)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.9
// Una persona decide realizar un viaje a Europa, para lo cual necesita una
// determinada cantidad de euros. La persona tiene ahorrada una cierta suma en
// dólares y desea saber si es suficiente y, en caso de haber diferencia (de más
// o de menos) a cuántos pesos equivale. Prever que se ingresen las
// equivalencias de monedas necesarias.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_9 es
//Ambiente
    Variables
        dolares_ahorrados: Real
        precio_viaje: Real            // en euros
        cotizacion_dolar_a_euro: Real // cuántos euros vale 1 dólar
        cotizacion_euro_a_peso: Real  // cuántos pesos vale 1 euro
        ahorro_en_euros: Real
        diferencia_euros: Real
        diferencia_pesos: Real
//Algoritmo
    Escribir ("Ingrese la cantidad de dólares ahorrados")
    Leer (dolares_ahorrados)
    Escribir ("Ingrese el precio del viaje en euros")
    Leer (precio_viaje)
    Escribir ("Ingrese la cotización actual del dólar a euro")
    Leer (cotizacion_dolar_a_euro)
    Escribir ("Ingrese la cotización actual del euro a peso argentino")
    Leer (cotizacion_euro_a_peso)

        ahorro_en_euros:= dolares_ahorrados * cotizacion_dolar_a_euro

    Si precio_viaje > ahorro_en_euros Entonces
        diferencia_euros:= precio_viaje - ahorro_en_euros // lo que falta
        diferencia_pesos:= diferencia_euros * cotizacion_euro_a_peso
        Escribir ("Los dólares ahorrados no alcanzan: el viaje cuesta ", precio_viaje, " euros y usted dispone de ", ahorro_en_euros, ". Le faltan ", diferencia_pesos, " pesos.")
    SiNo
        diferencia_euros:= ahorro_en_euros - precio_viaje // lo que sobra
        diferencia_pesos:= diferencia_euros * cotizacion_euro_a_peso
        Escribir ("Los dólares ahorrados alcanzan: el viaje cuesta ", precio_viaje, " euros y usted posee ", ahorro_en_euros, ". Le sobran ", diferencia_pesos, " pesos.")
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.10
// Dados dos números enteros A y B generar un algoritmo que permita determinar
// si A es divisor de B o B es divisor de A.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_10 es
//Ambiente
    Variables
        num1, num2: Entero // MOD solo tiene sentido con enteros
//Algoritmo
    Escribir ("Ingrese 2 números enteros distintos de cero")
    Leer (num1, num2)
    Si num1 mod num2 = 0 Entonces
        Escribir (num2, " es divisor de ", num1)
    Sino
        Escribir (num2, " no es divisor de ", num1)
    FinSi
    Si num2 mod num1 = 0 Entonces
        Escribir (num1, " es divisor de ", num2)
    Sino
        Escribir (num1, " no es divisor de ", num2)
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.11
// Dado un año ingresado por el usuario, emitir el mensaje 'ACTUAL' si
// corresponde al año en curso, 'PASADO' si es menor y 'FUTURO' si es mayor.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_11 es
//Ambiente
    Constantes
        año_actual = 2023
    Variables
        año: Entero(4)
//Algoritmo
    Escribir ("Ingrese un año")
    Leer (año)
    // Se compara contra el año en curso, no contra valores fijos como 2022 o 2024
    Si año = año_actual Entonces
        Escribir ("ACTUAL")
    Sino
        Si año < año_actual Entonces
            Escribir ("PASADO")
        Sino
            Escribir ("FUTURO")
        FinSi
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.12
// Escriba un algoritmo que acepte un número entero mayor a 100 y menor a 1000,
// y muestre cómo está compuesto (unidades, decenas y centenas) y si es múltiplo
// de 3 (todo número cuya suma de sus dígitos sea múltiplo de 3, lo es también).
// --------------------------------------------------------------------------

Acción Ejercicio1_1_12 es
//Ambiente
    Variables
        num, aux: Entero(3)
        uni, dec, cent: 0..9
//Algoritmo
    Escribir ("Ingrese un número mayor a 100 y menor a 1000")
    Leer (num)
    Si (num > 100) y (num < 1000) Entonces
        aux:= num // trabajo sobre una copia para no perder el número original
        uni:= aux mod 10
        aux:= TRUNC(aux / 10)
        dec:= aux mod 10
        aux:= TRUNC(aux / 10)
        cent:= aux mod 10
        Escribir ("El número ingresado está compuesto por ", uni, " unidades, ", dec, " decenas y ", cent, " centenas.")
        Si (uni + dec + cent) mod 3 = 0 Entonces
            Escribir ("Además, es múltiplo de 3")
        SiNo
            Escribir ("Pero no es múltiplo de 3")
        FinSi
    SiNo
        Escribir ("Ingrese un valor mayor a 100 y menor a 1000")
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.13
// Escriba un algoritmo que acepte un número entero mayor a 100 y menor a 1000
// que representa una suma de dinero e indique cuántos billetes de cada
// denominación necesita, suponiendo que solo existen billetes de 100, 10 y 1.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_13 es
//Ambiente
    Variables
        num: Entero(4)
        b100, b10, b1: Entero
//Algoritmo
    Escribir ("Ingrese un número entero mayor a 100 y menor a 1000")
    Leer (num)
        Si (num > 100) y (num < 1000) Entonces
            b100:= TRUNC(num / 100)
            b10:= TRUNC((num - b100 * 100) / 10)
            b1:= num - b100 * 100 - b10 * 10
            Escribir ("Se necesitan ", b100, " billetes de 100 pesos, ", b10, " billetes de 10 pesos y ", b1, " billetes de 1 peso")
        SiNo
            Escribir ("El número ingresado no cumple con los requisitos solicitados")
        FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.14
// En un experimento se obtuvieron un conjunto de pares de valores (S, V) y se
// requiere que desarrolle un programa que determine e imprima:
//   a. Cuántos pares (S, V) tienen el mismo valor de S que el primer par.
//   b. Primer valor de S mayor que V.
//   c. En cuántos pares (S, V) se cumple que S es el doble de V.
//   d. Productoria de los valores de S no nulos, donde V es nulo.
// Fin de datos: se ingresa S = 9999.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_14 es
//Ambiente
    Constantes
        fin = 9999
    Variables
        S, V, primer_S, primer_S_mayor: Real
        cont_igual_primero, cont_doble: Entero
        productoria: Real
        encontrado, hay_producto: Lógico
//Algoritmo
    cont_igual_primero:= 0
    cont_doble:= 0
    productoria:= 1 // neutro de la multiplicación
    encontrado:= Falso
    hay_producto:= Falso

    Escribir ("Ingrese el primer par S, V (S = 9999 para terminar)")
    Leer (S, V)
    primer_S:= S

    Mientras S <> fin Hacer
        Si S = primer_S Entonces // a. incluye al primer par
            cont_igual_primero:= cont_igual_primero + 1
        FinSi
        Si (S > V) y (No encontrado) Entonces // b. me quedo solo con el primero
            primer_S_mayor:= S
            encontrado:= Verdadero
        FinSi
        Si S = 2 * V Entonces // c.
            cont_doble:= cont_doble + 1
        FinSi
        Si (V = 0) y (S <> 0) Entonces // d.
            productoria:= productoria * S
            hay_producto:= Verdadero
        FinSi
        Escribir ("Ingrese el siguiente par S, V (S = 9999 para terminar)")
        Leer (S, V)
    FinMientras

    Escribir ("a. Pares con el mismo S que el primero: ", cont_igual_primero)
    Si encontrado Entonces
        Escribir ("b. Primer S mayor que V: ", primer_S_mayor)
    Sino
        Escribir ("b. Ningún par cumple S > V")
    FinSi
    Escribir ("c. Pares donde S es el doble de V: ", cont_doble)
    Si hay_producto Entonces
        Escribir ("d. Productoria de los S no nulos con V nulo: ", productoria)
    Sino
        Escribir ("d. No hubo pares con V nulo y S no nulo")
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.15
// Hacer un algoritmo que calcule la altura aproximada de un edificio en pies,
// ingresando como dato la cantidad de pisos del mismo y la altura promedio de
// cada piso, en metros. (1 m = 3.28 pies)
// --------------------------------------------------------------------------

Acción Ejercicio1_1_15 es
//Ambiente
    Constantes
        conversion = 3,28
    Variables
        pisos: Entero
        prom_h: Real
        alt_edif, alt_edif_pies: Real
//Algoritmo
    Escribir ("Ingrese la cantidad de pisos")
    Leer (pisos)
    Escribir ("Ingrese la altura promedio de cada piso, en metros")
    Leer (prom_h)
    alt_edif:= pisos * prom_h
    alt_edif_pies:= alt_edif * conversion
    Escribir ("La altura aproximada del edificio en pies es de ", alt_edif_pies)
FinAcción


// Modifique el algoritmo del punto 1 para que permita calcular la altura de
// 50 edificios.

Acción Ejercicio1_1_15_b es
//Ambiente
    Constantes
        conversion = 3,28
    Variables
        pisos, i: Entero
        prom_h: Real
        alt_edif, alt_edif_pies: Real
//Algoritmo
    Para i:= 1 hasta 50 Hacer // cantidad conocida de antemano: ciclo Para
        Escribir ("Edificio ", i, ": ingrese la cantidad de pisos")
        Leer (pisos)
        Escribir ("Ingrese la altura promedio de cada piso, en metros")
        Leer (prom_h)
        alt_edif:= pisos * prom_h
        alt_edif_pies:= alt_edif * conversion
        Escribir ("La altura aproximada del edificio en pies es de ", alt_edif_pies)
    FinPara
FinAcción


// Modifique el algoritmo del punto 1 para que permita calcular la altura de
// una cantidad indeterminada de edificios. Prevea una condición de fin.

Acción Ejercicio1_1_15_c es
//Ambiente
    Constantes
        conversion = 3,28
    Variables
        pisos: Entero
        prom_h: Real
        alt_edif, alt_edif_pies: Real
        op: Caracter // como op puede ser S o N, es un carácter
//Algoritmo
    Escribir ("¿Posee algún edificio para calcular? S/N")
    Leer (op)
    Mientras op = "S" Hacer // cantidad desconocida: ciclo Mientras
        Escribir ("Ingrese la cantidad de pisos")
        Leer (pisos)
        Escribir ("Ingrese la altura promedio de cada piso, en metros")
        Leer (prom_h)
        alt_edif:= pisos * prom_h
        alt_edif_pies:= alt_edif * conversion
        Escribir ("La altura aproximada del edificio en pies es de ", alt_edif_pies)
        Escribir ("¿Desea continuar? S/N") // pregunto si tiene más edificios para calcular, sino se vuelve un bucle infinito
        Leer (op) // vuelvo a leer y se repite el ciclo hasta que op sea distinto de S
    FinMientras
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.17
// Elabore un algoritmo que calcule el producto de dos enteros A y B empleando
// sólo la operación suma.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_17 es
//Ambiente
    Variables
        a, b, i, result: Entero
//Algoritmo
    result:= 0
    Escribir ("Ingrese 2 números enteros (el segundo no negativo): ")
    Leer (a, b)
    Para i:= 1 hasta b Hacer // sumo a consigo mismo b veces
        result:= result + a
    FinPara
    Escribir ("El producto es: ", result)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.18
// Elabore un algoritmo que calcule el cociente de dos enteros F y G y el Resto
// de la operación, empleando sólo las operaciones suma y diferencia.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_18 es
//Ambiente
    Variables
        F, G, cociente, resto: Entero
//Algoritmo
    Escribir ("Ingrese 2 valores enteros positivos (dividendo y divisor)")
    Leer (F, G)
    cociente:= 0
    resto:= F
    Mientras resto >= G Hacer // con >= también se cuenta la resta que deja resto 0
        resto:= resto - G
        cociente:= cociente + 1
    FinMientras
    Escribir ("El cociente es: ", cociente, " y el resto es: ", resto)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.19
// Escribir un algoritmo que ingrese una variable V y emita el valor de ésta,
// su cuadrado y su cubo.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_19 es
Ambiente
    Variables
        V, V2, V3: Real
Proceso
    Escribir ("Ingrese una Variable/Número")
    Leer (V)
    V2:= V * V
    V3:= V * V * V
    Escribir ("El valor de la Variable es: ", V, " Su cuadrado es: ", V2, " y su cubo es: ", V3)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.20
// Teniendo en cuenta el ejercicio anterior, realizar un incremento de la
// variable V en forma constante y creciente recalculando los demás valores
// 10 veces.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_20 es
Ambiente
    Variables
        V, V2, V3: Real
        i: Entero
Proceso
    Escribir ("Ingrese una Variable/Número")
    Leer (V)
    Para i:= 1 hasta 10 Hacer
        V2:= V * V
        V3:= V * V * V
        // Emito dentro del ciclo para mostrar los 10 recálculos, no solo el último
        Escribir ("V: ", V, " - Cuadrado: ", V2, " - Cubo: ", V3)
        V:= V + 1
    FinPara
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.21
// Repita el ejercicio anterior con un cálculo de n veces, con n > 1. Por
// final emitir la suma de los cuadrados de V.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_21 es
Ambiente
    Variables
        V, V2, V3, suma_cuadrados: Real
        n, i: Entero
Proceso
    Escribir ("Ingrese una Variable/Número")
    Leer (V)
    Repetir
        Escribir ("¿Cuántas veces desea recalcular? (n > 1)")
        Leer (n)
    Hasta que n > 1
    suma_cuadrados:= 0
    Para i:= 1 hasta n Hacer
        V2:= V * V
        V3:= V * V * V
        Escribir ("V: ", V, " - Cuadrado: ", V2, " - Cubo: ", V3)
        suma_cuadrados:= suma_cuadrados + V2
        V:= V + 1
    FinPara
    Escribir ("La suma de los cuadrados es: ", suma_cuadrados)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.22
// Escriba un algoritmo que determine si un número es primo.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_22 es
Ambiente
    Variables
        num, divisor: Entero
        es_primo: Lógico
Proceso
    Escribir ("Ingrese un número entero mayor a 1")
    Leer (num)
    es_primo:= (num > 1)
    divisor:= 2
    // Alcanza con probar hasta la raíz cuadrada del número
    Mientras es_primo y (divisor * divisor <= num) Hacer
        Si num mod divisor = 0 Entonces
            es_primo:= Falso
        FinSi
        divisor:= divisor + 1
    FinMientras
    Si es_primo Entonces
        Escribir (num, " es primo")
    Sino
        Escribir (num, " no es primo")
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.23
// Escriba un algoritmo para calcular cada renglón de una factura (valor
// unitario * cantidad vendida) y el total de la misma, suponiendo que el
// número de renglones es variable. Emitir un mensaje de error si el valor
// unitario es <= 0. Prueba de escritorio con 4 renglones.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_23 es
Ambiente
    Variables
        renglones, i, cantidad: Entero
        valor_unitario, importe, total: Real
Proceso
    Escribir ("Ingrese la cantidad de renglones de la factura")
    Leer (renglones)
    total:= 0
    Para i:= 1 hasta renglones Hacer
        Escribir ("Renglón ", i, ": ingrese valor unitario y cantidad vendida")
        Leer (valor_unitario, cantidad)
        Si valor_unitario <= 0 Entonces
            Escribir ("Error: el valor unitario debe ser mayor a 0, el renglón no se suma")
        Sino
            importe:= valor_unitario * cantidad
            Escribir ("Importe del renglón ", i, ": ", importe)
            total:= total + importe
        FinSi
    FinPara
    Escribir ("Total de la factura: ", total)
FinAcción

// Prueba de escritorio (4 renglones):
//   i | valor_unitario | cantidad | importe | total
//   1 |      100       |    2     |   200   |  200
//   2 |       50       |    3     |   150   |  350
//   3 |        0       |    5     |  error  |  350
//   4 |       25       |    4     |   100   |  450



// --------------------------------------------------------------------------
// Ejercicio 1.1.24
// Dado un importe de dinero, calcular e informar cuánto corresponde pagar por
// un impuesto, en cuántas cuotas y el valor de las mismas.
//   IMPUESTO = 10% del importe dado.
//   Importes > $500 y <= $1000 se pagan en dos cuotas; > $1000 en tres cuotas
//   (el resto, en una). Finaliza cuando se ingresa 9999 como importe.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_24 es
Ambiente
    Constantes
        tasa = 0,10
        fin = 9999
    Variables
        importe, impuesto, valor_cuota: Real
        cuotas: 1..3
Proceso
    Escribir ("Ingrese un importe (9999 para terminar)")
    Leer (importe)
    Mientras importe <> fin Hacer
        impuesto:= importe * tasa
        Si importe > 1000 Entonces
            cuotas:= 3
        Sino
            Si importe > 500 Entonces
                cuotas:= 2
            Sino
                cuotas:= 1
            FinSi
        FinSi
        valor_cuota:= impuesto / cuotas
        Escribir ("Impuesto: ", impuesto, " en ", cuotas, " cuota/s de ", valor_cuota)
        Escribir ("Ingrese un importe (9999 para terminar)")
        Leer (importe)
    FinMientras
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.25
// Elabore un algoritmo para calcular los primeros 50 números de FIBONACCI,
// sabiendo que F1 = 1, F2 = 1 y Fn = Fn-1 + Fn-2.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_25 es
Ambiente
    Variables
        anterior, actual, siguiente: Entero
        i: Entero
Proceso
    anterior:= 1
    actual:= 1
    Escribir (anterior)
    Escribir (actual)
    Para i:= 3 hasta 50 Hacer
        siguiente:= anterior + actual
        Escribir (siguiente)
        anterior:= actual // corro la "ventana" de dos valores
        actual:= siguiente
    FinPara
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.26
// Imprimir las coordenadas (X,Y) de una función cuadrática Y = aX² + bX + c,
// haciendo variar X en el intervalo [20, -20] con un decremento de 2.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_26 es
Ambiente
    Variables
        a, b, c, Y: Real
        X: Entero
Proceso
    Escribir ("Ingrese los coeficientes a, b y c")
    Leer (a, b, c)
    Para X:= 20 hasta -20, -2 Hacer // paso negativo: decremento de 2
        Y:= a * X**2 + b * X + c
        Escribir ("(", X, ", ", Y, ")")
    FinPara
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.27
// Repita el ejercicio anterior de modo que sea posible estudiar varias
// funciones, terminando al ingresar 9999 para el término cuadrático.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_27 es
Ambiente
    Constantes
        fin = 9999
    Variables
        a, b, c, Y: Real
        X: Entero
Proceso
    Escribir ("Ingrese el término cuadrático a (9999 para terminar)")
    Leer (a)
    Mientras a <> fin Hacer
        Escribir ("Ingrese b y c")
        Leer (b, c)
        Para X:= 20 hasta -20, -2 Hacer
            Y:= a * X**2 + b * X + c
            Escribir ("(", X, ", ", Y, ")")
        FinPara
        Escribir ("Ingrese el término cuadrático a (9999 para terminar)")
        Leer (a)
    FinMientras
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.28
// Encontrar todas las cifras de tres dígitos que cumplan con la condición de
// que la suma de los cubos de sus dígitos sea igual al número que la cifra
// representa (153, 370, 371 y 407).
// --------------------------------------------------------------------------

Acción Ejercicio1_1_28 es
Ambiente
    Variables
        num, cent, dec, uni: Entero
Proceso
    Para num:= 100 hasta 999 Hacer
        cent:= TRUNC(num / 100)
        dec:= TRUNC(num / 10) mod 10
        uni:= num mod 10
        Si cent**3 + dec**3 + uni**3 = num Entonces
            Escribir (num)
        FinSi
    FinPara
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.29
// Escriba un algoritmo para imprimir los números primos menores a un valor
// dado n. (Reutiliza la idea del 1.1.22)
// --------------------------------------------------------------------------

Acción Ejercicio1_1_29 es
Ambiente
    Variables
        n, num, divisor: Entero
        es_primo: Lógico
Proceso
    Escribir ("Ingrese n")
    Leer (n)
    Para num:= 2 hasta n - 1 Hacer
        es_primo:= Verdadero
        divisor:= 2
        Mientras es_primo y (divisor * divisor <= num) Hacer
            Si num mod divisor = 0 Entonces
                es_primo:= Falso
            FinSi
            divisor:= divisor + 1
        FinMientras
        Si es_primo Entonces
            Escribir (num)
        FinSi
    FinPara
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.30
// Una empresa de transportes desea conocer el sueldo de sus 100 choferes,
// según la categoría (1 o 2) y la asistencia (perfecta: si o no). Sueldo =
// básico + 2% del básico por cada año de antigüedad + $200 de premio por
// asistencia perfecta. Básico: $700 categoría 1 y $500 categoría 2.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_30 es
Ambiente
    Constantes
        premio = 200
    Variables
        i, antiguedad: Entero
        categoria: 1..2
        asistencia: Caracter // "S" o "N"
        basico, sueldo: Real
Proceso
    Para i:= 1 hasta 100 Hacer
        Escribir ("Chofer ", i, ": ingrese categoría (1/2), años de antigüedad y asistencia perfecta (S/N)")
        Leer (categoria, antiguedad, asistencia)
        Si categoria = 1 Entonces
            basico:= 700
        Sino
            basico:= 500
        FinSi
        sueldo:= basico + basico * 0,02 * antiguedad
        Si asistencia = "S" Entonces
            sueldo:= sueldo + premio
        FinSi
        Escribir ("Sueldo del chofer ", i, ": ", sueldo)
    FinPara
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.31
// Una fábrica textil produce telas de dos calidades (primera y segunda) y de
// dos materiales (seda y algodón). Calcular el peso de varias piezas de tela:
// peso neto + % por apresto + peso del núcleo de cartón.
//   - Se conoce el peso del m2 y la longitud de cada pieza.
//   - Apresto: 2% para seda y 7% para algodón.
//   - Núcleo: 400 gr para telas de primera y 300 gr para las de segunda.
//   - Finalizar cuando la variable FIN sea igual a 'SI'.
// (Se toma la longitud en m2 de tela, como indica el enunciado.)
// --------------------------------------------------------------------------

Acción Ejercicio1_1_31 es
Ambiente
    Variables
        peso_m2, longitud, peso_neto, apresto, nucleo, peso_total: Real
        calidad: Caracter // "P" primera, "S" segunda
        material: Caracter // "S" seda, "A" algodón
        FIN: AN(2)
Proceso
    Escribir ("¿Terminar? (SI/NO)")
    Leer (FIN)
    Mientras FIN <> "SI" Hacer
        Escribir ("Ingrese peso del m2 (en gr), longitud, calidad (P/S) y material (S/A)")
        Leer (peso_m2, longitud, calidad, material)
        peso_neto:= peso_m2 * longitud
        Si material = "S" Entonces
            apresto:= peso_neto * 0,02
        Sino
            apresto:= peso_neto * 0,07
        FinSi
        Si calidad = "P" Entonces
            nucleo:= 400
        Sino
            nucleo:= 300
        FinSi
        peso_total:= peso_neto + apresto + nucleo
        Escribir ("Peso total de la pieza: ", peso_total, " gr")
        Escribir ("¿Terminar? (SI/NO)")
        Leer (FIN)
    FinMientras
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.32
// La fecha del domingo de Pascua corresponde al primer domingo después de la
// primera luna llena que sigue al equinoccio de primavera. La secuencia de
// cálculos (método de Gauss, válido para 1900-2099) es:
//   A = año MOD 19   B = año MOD 4   C = año MOD 7
//   D = (19*A + 24) MOD 30   E = (2*B + 4*C + 6*D + 5) MOD 7
//   Pascua = 22 + D + E de marzo (si pasa de 31, es D + E - 9 de abril)
// --------------------------------------------------------------------------

Acción Ejercicio1_1_32 es
Ambiente
    Variables
        año, A, B, C, D, E, dia: Entero
Proceso
    Escribir ("Ingrese el año")
    Leer (año)
    A:= año mod 19
    B:= año mod 4
    C:= año mod 7
    D:= (19 * A + 24) mod 30
    E:= (2 * B + 4 * C + 6 * D + 5) mod 7
    dia:= 22 + D + E
    Si dia <= 31 Entonces
        Escribir ("El domingo de Pascua es el ", dia, " de marzo")
    Sino
        Escribir ("El domingo de Pascua es el ", dia - 31, " de abril")
    FinSi
FinAcción



// --------------------------------------------------------------------------
// Ejercicios 1.1.33 y 1.1.34
// Escribir un algoritmo que permita imprimir la siguiente sucesión. Considere
// que N es un número par, que se ingresa.
// Pendiente: las sucesiones venían como imagen en la guía y no quedaron
// copiadas en este archivo.
// --------------------------------------------------------------------------



// --------------------------------------------------------------------------
// Ejercicio 1.1.35
// Indicar cuántos billetes de cada denominación se necesitan para una suma de
// dinero, suponiendo que solo existen billetes de 500, 100, 50, 20, 10, 5 y 1.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_35 es
Ambiente
    Variables
        importe, resto: Entero
        b500, b100, b50, b20, b10, b5, b1: Entero
Proceso
    Escribir ("Ingrese el importe (entero)")
    Leer (importe)
    // Siempre se usa primero el billete más grande posible
    resto:= importe
    b500:= TRUNC(resto / 500)
    resto:= resto mod 500
    b100:= TRUNC(resto / 100)
    resto:= resto mod 100
    b50:= TRUNC(resto / 50)
    resto:= resto mod 50
    b20:= TRUNC(resto / 20)
    resto:= resto mod 20
    b10:= TRUNC(resto / 10)
    resto:= resto mod 10
    b5:= TRUNC(resto / 5)
    b1:= resto mod 5
    Escribir ("500: ", b500, " | 100: ", b100, " | 50: ", b50, " | 20: ", b20, " | 10: ", b10, " | 5: ", b5, " | 1: ", b1)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.1.36
// Todo número cuya suma de sus dígitos sea múltiplo de 3 lo es también.
// Ej: 117 -> 1+1+7 = 9 que es múltiplo de 3, entonces 117 es múltiplo de 3.
// Determinar si un número es múltiplo de 3 en función de esa afirmación.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_36 es
Ambiente
    Variables
        num, aux, suma_digitos: Entero
Proceso
    Escribir ("Ingrese un número entero positivo")
    Leer (num)
    aux:= num
    suma_digitos:= 0
    Mientras aux > 0 Hacer // voy "sacando" el último dígito
        suma_digitos:= suma_digitos + aux mod 10
        aux:= TRUNC(aux / 10)
    FinMientras
    Si suma_digitos mod 3 = 0 Entonces
        Escribir (num, " es múltiplo de 3 (sus dígitos suman ", suma_digitos, ")")
    Sino
        Escribir (num, " no es múltiplo de 3 (sus dígitos suman ", suma_digitos, ")")
    FinSi
FinAcción
