// --------------------------------------------------------------------------
// Ejercicio 1.7
// Escriba un algoritmo que permita ingresar 3 valores numéricos y determine
// cuál es el mayor, el medio y el menor.
// (era el 3 de los complementarios)
// --------------------------------------------------------------------------

Acción Ejercicio1_7 es
//Ambiente
    Variables
        a, b, c: Real
        mayor, medio, menor: Real
//Algoritmo
    Escribir ("Ingrese 3 valores numéricos")
    Leer (a, b, c)
        // Primero busco el mayor; los otros dos se ordenan entre sí
        Si (a >= b) y (a >= c) Entonces
            mayor:= a
            Si b >= c Entonces
                medio:= b
                menor:= c
            Sino
                medio:= c
                menor:= b
            FinSi
        Sino
            Si (b >= a) y (b >= c) Entonces
                mayor:= b
                Si a >= c Entonces
                    medio:= a
                    menor:= c
                Sino
                    medio:= c
                    menor:= a
                FinSi
            Sino
                mayor:= c
                Si a >= b Entonces
                    medio:= a
                    menor:= b
                Sino
                    medio:= b
                    menor:= a
                FinSi
            FinSi
        FinSi
    Escribir ("El número mayor es: ", mayor, ", el intermedio es: ", medio, " y el menor es: ", menor)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.8
// Escriba un algoritmo que acepte dos números, calcule la suma e imprima el
// mensaje de acuerdo al resultado obtenido.
//
// * Suma <= 50
// * Suma > 50 y <= 100
// * Suma > 100 y <= 200
// * Suma > 200
// --------------------------------------------------------------------------

Acción Ejercicio1_8 es
//Ambiente
    Variables
        num1, num2, suma: Real
//Algoritmo
    Escribir ("Ingrese 2 números")
    Leer (num1, num2)
        suma:= num1 + num2
        // Según solo sirve para valores puntuales; para rangos uso Si anidados
        Si suma <= 50 Entonces
            Escribir ("El resultado de la suma es menor o igual que 50")
        Sino
            Si suma <= 100 Entonces
                Escribir ("El resultado de la suma es mayor que 50 y menor o igual que 100")
            Sino
                Si suma <= 200 Entonces
                    Escribir ("El resultado de la suma es mayor que 100 y menor o igual que 200")
                Sino
                    Escribir ("El resultado de la suma es mayor que 200")
                FinSi
            FinSi
        FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.9
// Escriba un algoritmo que permita conocer la edad de una persona, con solo
// ingresar la fecha de nacimiento y la fecha actual, ambas en el formato:
// DIA, MES, AÑO
// --------------------------------------------------------------------------

Acción Ejercicio1_9 es
//Ambiente
    Variables
        DiaA, DiaN: 1..31
        MesA, MesN: 1..12
        AñoA, AñoN: N(4)
        Edad: Entero
//Algoritmo
    Escribir ("Ingrese día, mes y año actual")
    Leer (DiaA, MesA, AñoA)
    Escribir ("Ingrese día, mes y año de nacimiento")
    Leer (DiaN, MesN, AñoN)
        Edad:= AñoA - AñoN
            // Si todavía no cumplió años este año, le resto uno
            Si ((MesN = MesA) y (DiaN > DiaA)) o (MesN > MesA) Entonces
                Edad:= Edad - 1
            FinSi
    Escribir ("La edad es: ", Edad)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.10
// Una persona decide realizar un viaje a Europa, para lo cual necesita una
// determinada cantidad de euros. La persona tiene ahorrada una cierta suma
// en dólares y desea saber si es suficiente y, en caso de haber diferencia
// (de más o de menos) a cuantos pesos equivale. Realice un algoritmo que
// solucione el problema, para lo cual deberá prever que se ingresen las
// equivalencias de monedas que considere necesarias (por ejemplo la
// cotizacion en pesos de dólar y/o del euro, o a cuantos euros equivale un
// dólar).
// --------------------------------------------------------------------------

Acción Ejercicio1_10 es
//Ambiente
    Variables
        dolares_ahorrados: Real
        precio_viaje: Real            // en euros
        cotizacion_dolar_a_euro: Real // cuántos euros vale 1 dólar
        cotizacion_euro_a_peso: Real  // cuántos pesos vale 1 euro
        ahorro_en_euros: Real
        diferencia_euros: Real
        diferencia_pesos: Real
//Algoritmo
    Escribir ("Ingrese la cantidad de dólares ahorrados")
    Leer (dolares_ahorrados)
    Escribir ("Ingrese el precio del viaje en euros")
    Leer (precio_viaje)
    Escribir ("Ingrese la cotización actual del dólar a euro")
    Leer (cotizacion_dolar_a_euro)
    Escribir ("Ingrese la cotización actual del euro a peso argentino")
    Leer (cotizacion_euro_a_peso)

        ahorro_en_euros:= dolares_ahorrados * cotizacion_dolar_a_euro

    Si precio_viaje > ahorro_en_euros Entonces
        diferencia_euros:= precio_viaje - ahorro_en_euros // lo que falta
        diferencia_pesos:= diferencia_euros * cotizacion_euro_a_peso
        Escribir ("Los dólares ahorrados no alcanzan: el viaje cuesta ", precio_viaje, " euros y usted dispone de ", ahorro_en_euros, ". Le faltan ", diferencia_pesos, " pesos.")
    SiNo
        diferencia_euros:= ahorro_en_euros - precio_viaje // lo que sobra
        diferencia_pesos:= diferencia_euros * cotizacion_euro_a_peso
        Escribir ("Los dólares ahorrados alcanzan: el viaje cuesta ", precio_viaje, " euros y usted posee ", ahorro_en_euros, ". Le sobran ", diferencia_pesos, " pesos.")
    FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.11
// Dados dos números enteros A y B generar un algoritmo que permita
// determinar si A es divisor de B o B es divisor de A.
// --------------------------------------------------------------------------

Acción Ejercicio1_11 es
//Ambiente
    Variables
        num1, num2: Entero // MOD solo tiene sentido con enteros
//Algoritmo
    Escribir ("Ingrese 2 números enteros distintos de cero")
    Leer (num1, num2)
    Si num1 mod num2 = 0 Entonces
        Escribir (num2, " es divisor de ", num1)
    Sino
        Escribir (num2, " no es divisor de ", num1)
    FinSi
    Si num2 mod num1 = 0 Entonces
        Escribir (num1, " es divisor de ", num2)
    Sino
        Escribir (num1, " no es divisor de ", num2)
    FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.12
// Escriba un algoritmo que acepte un número entero mayor a 100 y menor a
// 1000, y muestre cómo está compuesto (unidades, decenas y centenas) y si es
// múltiplo de 3 (Recordar: todo número cuya suma de sus dígitos sea múltiplo
// de 3, lo es también).
// --------------------------------------------------------------------------

Acción Ejercicio1_12 es
//Ambiente
    Variables
        num, aux: Entero(3)
        uni, dec, cent: 0..9
//Algoritmo
    Escribir ("Ingrese un número mayor a 100 y menor a 1000")
    Leer (num)
    Si (num > 100) y (num < 1000) Entonces
        aux:= num // trabajo sobre una copia para no perder el número original
        uni:= aux mod 10
        aux:= TRUNC(aux / 10)
        dec:= aux mod 10
        aux:= TRUNC(aux / 10)
        cent:= aux mod 10
        Escribir ("El número ingresado está compuesto por ", uni, " unidades, ", dec, " decenas y ", cent, " centenas.")
        Si (uni + dec + cent) mod 3 = 0 Entonces
            Escribir ("Además, es múltiplo de 3")
        SiNo
            Escribir ("Pero no es múltiplo de 3")
        FinSi
    SiNo
        Escribir ("Ingrese un valor mayor a 100 y menor a 1000")
    FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.13
// Escriba un algoritmo que acepte un número entero mayor a 100 y menor a
// 1000 que representa una suma de
// dinero e indique cuantos billetes de cada denominación necesita,
// suponiendo que solo existen billetes de 100, 10 y 1 peso.
// --------------------------------------------------------------------------

Acción Ejercicio1_13 es
//Ambiente
    Variables
        num: Entero(4)
        b100, b10, b1: Entero
//Algoritmo
    Escribir ("Ingrese un número entero mayor a 100 y menor a 1000")
    Leer (num)
        Si (num > 100) y (num < 1000) Entonces
            b100:= TRUNC(num / 100)
            b10:= TRUNC((num - b100 * 100) / 10)
            b1:= num - b100 * 100 - b10 * 10
            Escribir ("Se necesitan ", b100, " billetes de 100 pesos, ", b10, " billetes de 10 pesos y ", b1, " billetes de 1 peso")
        SiNo
            Escribir ("El número ingresado no cumple con los requisitos solicitados")
        FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.14
// Escriba un algoritmo que lea el monto total de una compra en un
// supermercado y determine el total a pagar según los siguientes criterios:
//
// Si el monto de la compra supera los $ 200.000, se aplica un 15% de
// descuento.
//
// Luego se consulta el tipo de entrega (el usuario ingresa el número de
// opción):
//
// * Opción 1 → retiro en sucursal, no se suma ningún cargo adicional.
// * Opción 2 → envío a domicilio dentro de Resistencia, se suma un 5% sobre
// el monto final.
// * Opción 3 → envío a domicilio fuera de Resistencia, se suma un 10% sobre
// el monto final.
// --------------------------------------------------------------------------

Acción Ejercicio1_14 es
Ambiente
    Variables
        monto, total: Real
        opcion: 1..3
Proceso
    Escribir ("Ingrese el monto total de la compra")
    Leer (monto)
    total:= monto
    Si monto > 200000 Entonces
        total:= monto * 0,85 // 15% de descuento
    FinSi
    Escribir ("Tipo de entrega: 1- retiro en sucursal | 2- envío en Resistencia | 3- envío fuera de Resistencia")
    Leer (opcion)
    Según opcion Hacer // el recargo se calcula sobre el monto con el descuento ya aplicado
        1: total:= total
        2: total:= total * 1,05
        3: total:= total * 1,10
    FinSegún
    Escribir ("El total a pagar es: ", total)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.15
// 1. Hacer un algoritmo que calcule la altura aproximada de un edificio en
// pies, ingresando como dato la cantidad de pisos del mismo y la altura
// promedio de cada piso, en metros. (1 m = 3.28 pies)
// 2. Modifique el algoritmo del punto 1. para que permita calcular la altura
// de 50 edificios.
// 3. Modifique el algoritmo del punto 1. para que permita calcular la altura
// de una cantidad indeterminada de edificios. Prevea una condición de fin.
// --------------------------------------------------------------------------

Acción Ejercicio1_15 es
//Ambiente
    Constantes
        conversion = 3,28
    Variables
        pisos: Entero
        prom_h: Real
        alt_edif, alt_edif_pies: Real
//Algoritmo
    Escribir ("Ingrese la cantidad de pisos")
    Leer (pisos)
    Escribir ("Ingrese la altura promedio de cada piso, en metros")
    Leer (prom_h)
    alt_edif:= pisos * prom_h
    alt_edif_pies:= alt_edif * conversion
    Escribir ("La altura aproximada del edificio en pies es de ", alt_edif_pies)
FinAcción


// Modifique el algoritmo del punto 1 para que permita calcular la altura de
// 50 edificios.

Acción Ejercicio1_15_b es
//Ambiente
    Constantes
        conversion = 3,28
    Variables
        pisos, i: Entero
        prom_h: Real
        alt_edif, alt_edif_pies: Real
//Algoritmo
    Para i:= 1 hasta 50 Hacer // cantidad conocida de antemano: ciclo Para
        Escribir ("Edificio ", i, ": ingrese la cantidad de pisos")
        Leer (pisos)
        Escribir ("Ingrese la altura promedio de cada piso, en metros")
        Leer (prom_h)
        alt_edif:= pisos * prom_h
        alt_edif_pies:= alt_edif * conversion
        Escribir ("La altura aproximada del edificio en pies es de ", alt_edif_pies)
    FinPara
FinAcción


// Modifique el algoritmo del punto 1 para que permita calcular la altura de
// una cantidad indeterminada de edificios. Prevea una condición de fin.

Acción Ejercicio1_15_c es
//Ambiente
    Constantes
        conversion = 3,28
    Variables
        pisos: Entero
        prom_h: Real
        alt_edif, alt_edif_pies: Real
        op: Caracter // como op puede ser S o N, es un carácter
//Algoritmo
    Escribir ("¿Posee algún edificio para calcular? S/N")
    Leer (op)
    Mientras op = "S" Hacer // cantidad desconocida: ciclo Mientras
        Escribir ("Ingrese la cantidad de pisos")
        Leer (pisos)
        Escribir ("Ingrese la altura promedio de cada piso, en metros")
        Leer (prom_h)
        alt_edif:= pisos * prom_h
        alt_edif_pies:= alt_edif * conversion
        Escribir ("La altura aproximada del edificio en pies es de ", alt_edif_pies)
        Escribir ("¿Desea continuar? S/N") // pregunto si tiene más edificios para calcular, sino se vuelve un bucle infinito
        Leer (op) // vuelvo a leer y se repite el ciclo hasta que op sea distinto de S
    FinMientras
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.16
// 1. Diseñe un algoritmo que obtenga el porcentaje de alumnos de ISI, IQ e
// IEM, sobre el total de egresados de la UTN-FRRe de un año.
// 2. Modifique el algoritmo del punto 1. para que permita obtener e informar
// los mismos porcentajes pero para varias Facultades y al final emitir el
// total de alumnos por carrera y total general.
// --------------------------------------------------------------------------

// 1. Un año de egresados de la UTN-FRRe: se ingresa la carrera de cada
//    egresado y se termina con "FIN".
Acción Ejercicio1_16_a es
Ambiente
    Variables
        carrera: AN(3)
        isi, iq, iem, total: Entero
Proceso
    isi:= 0; iq:= 0; iem:= 0; total:= 0
    Escribir ("Carrera del egresado (ISI, IQ, IEM) o FIN para terminar")
    Leer (carrera)
    Mientras carrera <> "FIN" Hacer
        Según carrera Hacer
            "ISI": isi:= isi + 1
            "IQ": iq:= iq + 1
            "IEM": iem:= iem + 1
        FinSegún
        total:= total + 1
        Leer (carrera)
    FinMientras
    Si total > 0 Entonces
        Escribir ("ISI: ", isi * 100 / total, "% - IQ: ", iq * 100 / total, "% - IEM: ", iem * 100 / total, "%")
    FinSi
FinAcción


// 2. Lo mismo para varias facultades, con totales por carrera y general.
Acción Ejercicio1_16_b es
Ambiente
    Variables
        facultad: AN(30)
        carrera: AN(3)
        isi, iq, iem, total: Entero              // de la facultad actual
        tot_isi, tot_iq, tot_iem, tot_gral: Entero // de todas las facultades
Proceso
    tot_isi:= 0; tot_iq:= 0; tot_iem:= 0; tot_gral:= 0
    Escribir ("Nombre de la facultad (FIN para terminar)")
    Leer (facultad)
    Mientras facultad <> "FIN" Hacer
        isi:= 0; iq:= 0; iem:= 0; total:= 0 // se reinician en cada facultad
        Escribir ("Carrera del egresado (ISI, IQ, IEM) o FIN para pasar a otra facultad")
        Leer (carrera)
        Mientras carrera <> "FIN" Hacer
            Según carrera Hacer
                "ISI": isi:= isi + 1
                "IQ": iq:= iq + 1
                "IEM": iem:= iem + 1
            FinSegún
            total:= total + 1
            Leer (carrera)
        FinMientras
        Si total > 0 Entonces
            Escribir (facultad, " -> ISI: ", isi * 100 / total, "% - IQ: ", iq * 100 / total, "% - IEM: ", iem * 100 / total, "%")
        FinSi
        tot_isi:= tot_isi + isi; tot_iq:= tot_iq + iq; tot_iem:= tot_iem + iem
        tot_gral:= tot_gral + total
        Escribir ("Nombre de la facultad (FIN para terminar)")
        Leer (facultad)
    FinMientras
    Escribir ("Totales -> ISI: ", tot_isi, " - IQ: ", tot_iq, " - IEM: ", tot_iem, " - General: ", tot_gral)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.17
// Elabore un algoritmo que calcule el producto de dos enteros A y B
// empleando sólo la operación suma.
// --------------------------------------------------------------------------

Acción Ejercicio1_17 es
//Ambiente
    Variables
        a, b, i, result: Entero
//Algoritmo
    result:= 0
    Escribir ("Ingrese 2 números enteros (el segundo no negativo): ")
    Leer (a, b)
    Para i:= 1 hasta b Hacer // sumo a consigo mismo b veces
        result:= result + a
    FinPara
    Escribir ("El producto es: ", result)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.18
// Elabore un algoritmo que calcule el Cociente de dos enteros y el Resto de
// la operación, empleando sólo las operaciones suma y diferencia.
// --------------------------------------------------------------------------

Acción Ejercicio1_18 es
//Ambiente
    Variables
        F, G, cociente, resto: Entero
//Algoritmo
    Escribir ("Ingrese 2 valores enteros positivos (dividendo y divisor)")
    Leer (F, G)
    cociente:= 0
    resto:= F
    Mientras resto >= G Hacer // con >= también se cuenta la resta que deja resto 0
        resto:= resto - G
        cociente:= cociente + 1
    FinMientras
    Escribir ("El cociente es: ", cociente, " y el resto es: ", resto)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.19
// Escribir un algoritmo que ingrese una variable V y emita el valor de ésta,
// su cuadrado y su cubo.
// --------------------------------------------------------------------------

Acción Ejercicio1_19 es
Ambiente
    Variables
        V, V2, V3: Real
Proceso
    Escribir ("Ingrese una Variable/Número")
    Leer (V)
    V2:= V * V
    V3:= V * V * V
    Escribir ("El valor de la Variable es: ", V, " Su cuadrado es: ", V2, " y su cubo es: ", V3)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.20
// Teniendo en cuenta el ejercicio anterior, realizar un incremento de la
// variable V en forma constante y creciente recalculando los demás valores
// 10 veces. Por ejemplo
//
// V=2
//
//    V    V2    V3
//    2     4     8
//    3     9    27
// ....  ....  ....
//   12   144  1728
// --------------------------------------------------------------------------

Acción Ejercicio1_20 es
Ambiente
    Variables
        V, V2, V3: Real
        i: Entero
Proceso
    Escribir ("Ingrese una Variable/Número")
    Leer (V)
    Para i:= 1 hasta 10 Hacer
        V2:= V * V
        V3:= V * V * V
        // Emito dentro del ciclo para mostrar los 10 recálculos, no solo el último
        Escribir ("V: ", V, " - Cuadrado: ", V2, " - Cubo: ", V3)
        V:= V + 1
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.21
// Repita el ejercicio anterior con un cálculo de n veces, con n > 1. Por
// final emitir la suma de los cuadrados de V.
// --------------------------------------------------------------------------

Acción Ejercicio1_21 es
Ambiente
    Variables
        V, V2, V3, suma_cuadrados: Real
        n, i: Entero
Proceso
    Escribir ("Ingrese una Variable/Número")
    Leer (V)
    Repetir
        Escribir ("¿Cuántas veces desea recalcular? (n > 1)")
        Leer (n)
    Hasta que n > 1
    suma_cuadrados:= 0
    Para i:= 1 hasta n Hacer
        V2:= V * V
        V3:= V * V * V
        Escribir ("V: ", V, " - Cuadrado: ", V2, " - Cubo: ", V3)
        suma_cuadrados:= suma_cuadrados + V2
        V:= V + 1
    FinPara
    Escribir ("La suma de los cuadrados es: ", suma_cuadrados)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.22
// Escriba un algoritmo que determine si un número es primo.
// --------------------------------------------------------------------------

Acción Ejercicio1_22 es
Ambiente
    Variables
        num, divisor: Entero
        es_primo: Lógico
Proceso
    Escribir ("Ingrese un número entero mayor a 1")
    Leer (num)
    es_primo:= (num > 1)
    divisor:= 2
    // Alcanza con probar hasta la raíz cuadrada del número
    Mientras es_primo y (divisor * divisor <= num) Hacer
        Si num mod divisor = 0 Entonces
            es_primo:= Falso
        FinSi
        divisor:= divisor + 1
    FinMientras
    Si es_primo Entonces
        Escribir (num, " es primo")
    Sino
        Escribir (num, " no es primo")
    FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.23
// Escriba un algoritmo para calcular cada renglón de una factura (valor
// unitario * cantidad vendida) y el total de la misma, suponiendo que el
// número de renglones es variable. Emitir un mensaje de error si el valor
// unitario es <= 0. Realizar la prueba de escritorio con los siguientes
// valores:
// Cantidad de renglones: 4
//
// | Valor Unitario | Cantidad Vendida |
// | --- | --- |
// | 2 | 10 |
// | 1 | 25 |
// | 3 | 15 |
// | 2 | 8.5 |
// --------------------------------------------------------------------------

Acción Ejercicio1_23 es
Ambiente
    Variables
        renglones, i, cantidad: Entero
        valor_unitario, importe, total: Real
Proceso
    Escribir ("Ingrese la cantidad de renglones de la factura")
    Leer (renglones)
    total:= 0
    Para i:= 1 hasta renglones Hacer
        Escribir ("Renglón ", i, ": ingrese valor unitario y cantidad vendida")
        Leer (valor_unitario, cantidad)
        Si valor_unitario <= 0 Entonces
            Escribir ("Error: el valor unitario debe ser mayor a 0, el renglón no se suma")
        Sino
            importe:= valor_unitario * cantidad
            Escribir ("Importe del renglón ", i, ": ", importe)
            total:= total + importe
        FinSi
    FinPara
    Escribir ("Total de la factura: ", total)
FinAcción

// Prueba de escritorio (4 renglones):
//   i | valor_unitario | cantidad | importe | total
//   1 |      100       |    2     |   200   |  200
//   2 |       50       |    3     |   150   |  350
//   3 |        0       |    5     |  error  |  350
//   4 |       25       |    4     |   100   |  450


// --------------------------------------------------------------------------
// Ejercicio 1.24
// Escribir un algoritmo que, dado un importe dinero, permia calcular e
// informar cuanto corresponde pagar por un impuesto, en cuantas cuotas y el
// valor de las mismas. Tener en cuenta los siguientes datos:
//
// * IMPUESTO = 10% del importe dado.
// * Los importes mayores que 500 y menor o igual que 1000 se pagan en dos
// cuotas.
// * Los mayores de $1000 en tres cuotas.
//   El algoritmo debe permitir tratar varios importes finalizando cuando se
//   ingresa 9999 como importe.
// --------------------------------------------------------------------------

Acción Ejercicio1_24 es
Ambiente
    Constantes
        tasa = 0,10
        fin = 9999
    Variables
        importe, impuesto, valor_cuota: Real
        cuotas: 1..3
Proceso
    Escribir ("Ingrese un importe (9999 para terminar)")
    Leer (importe)
    Mientras importe <> fin Hacer
        impuesto:= importe * tasa
        Si importe > 1000 Entonces
            cuotas:= 3
        Sino
            Si importe > 500 Entonces
                cuotas:= 2
            Sino
                cuotas:= 1
            FinSi
        FinSi
        valor_cuota:= impuesto / cuotas
        Escribir ("Impuesto: ", impuesto, " en ", cuotas, " cuota/s de ", valor_cuota)
        Escribir ("Ingrese un importe (9999 para terminar)")
        Leer (importe)
    FinMientras
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.25
// Elabore un algoritmo para calcular los primeros 50 números de FIBONACCI,
// sabiendo que dichos números cumplen con lo siguiente:
//
// A_0=0, A_1=1, A_2=A_0+A_1, ..., A_n=A_{(n-1)}+A_{(n-2)}
// --------------------------------------------------------------------------

Acción Ejercicio1_25 es
Ambiente
    Variables
        anterior, actual, siguiente: Entero
        i: Entero
Proceso
    anterior:= 1
    actual:= 1
    Escribir (anterior)
    Escribir (actual)
    Para i:= 3 hasta 50 Hacer
        siguiente:= anterior + actual
        Escribir (siguiente)
        anterior:= actual // corro la "ventana" de dos valores
        actual:= siguiente
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.26
// Generar un algoritmo para imprimir las coordenadas (X,Y) de una función
// cuadrática, de la forma: Y = aX^2+bX+c, haciendo variar X en el intervalo
// [20, -20] con un decremento de 2.
// --------------------------------------------------------------------------

Acción Ejercicio1_26 es
Ambiente
    Variables
        a, b, c, Y: Real
        X: Entero
Proceso
    Escribir ("Ingrese los coeficientes a, b y c")
    Leer (a, b, c)
    Para X:= 20 hasta -20, -2 Hacer // paso negativo: decremento de 2
        Y:= a * X**2 + b * X + c
        Escribir ("(", X, ", ", Y, ")")
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.27
// Repita el ejercicio anterior de modo que sea posible estudiar varias
// funciones, indicando que se desea terminar al ingresar 9999 para el
// término cuadrático.
// --------------------------------------------------------------------------

Acción Ejercicio1_27 es
Ambiente
    Constantes
        fin = 9999
    Variables
        a, b, c, Y: Real
        X: Entero
Proceso
    Escribir ("Ingrese el término cuadrático a (9999 para terminar)")
    Leer (a)
    Mientras a <> fin Hacer
        Escribir ("Ingrese b y c")
        Leer (b, c)
        Para X:= 20 hasta -20, -2 Hacer
            Y:= a * X**2 + b * X + c
            Escribir ("(", X, ", ", Y, ")")
        FinPara
        Escribir ("Ingrese el término cuadrático a (9999 para terminar)")
        Leer (a)
    FinMientras
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.28
// Construya un algoritmo capaz de encontrar todas las cifras de tres dígitos
// que cumplan con la condición de que la suma de los cubos de sus dígitos
// sea igual al número que la cifra representa.
// --------------------------------------------------------------------------

Acción Ejercicio1_28 es
Ambiente
    Variables
        num, cent, dec, uni: Entero
Proceso
    Para num:= 100 hasta 999 Hacer
        cent:= TRUNC(num / 100)
        dec:= TRUNC(num / 10) mod 10
        uni:= num mod 10
        Si cent**3 + dec**3 + uni**3 = num Entonces
            Escribir (num)
        FinSi
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.29
// Escriba un algoritmo para imprimir los números primos menores a un valor
// dado n.
// --------------------------------------------------------------------------

Acción Ejercicio1_29 es
Ambiente
    Variables
        n, num, divisor: Entero
        es_primo: Lógico
Proceso
    Escribir ("Ingrese n")
    Leer (n)
    Para num:= 2 hasta n - 1 Hacer
        es_primo:= Verdadero
        divisor:= 2
        Mientras es_primo y (divisor * divisor <= num) Hacer
            Si num mod divisor = 0 Entonces
                es_primo:= Falso
            FinSi
            divisor:= divisor + 1
        FinMientras
        Si es_primo Entonces
            Escribir (num)
        FinSi
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.30
// Escriba un algoritmo para resolver el siguiente problema: Una empresa de
// transportes desea conocer el sueldo de sus 100 choferes. Estos se calculan
// teniendo en cuenta la categoría (1 o 2) y la asistencia (perfecta: si o
// no).
// El sueldo se obtiene sumando el sueldo básico, más el 2% de antigüedad por
// cada año trabajado y $200 de premio por asistencia.
// El sueldo básico es de 700 para choferes de categoría 1 y de 500.- para
// los de categoría 2.
// --------------------------------------------------------------------------

Acción Ejercicio1_30 es
Ambiente
    Constantes
        premio = 200
    Variables
        i, antiguedad: Entero
        categoria: 1..2
        asistencia: Caracter // "S" o "N"
        basico, sueldo: Real
Proceso
    Para i:= 1 hasta 100 Hacer
        Escribir ("Chofer ", i, ": ingrese categoría (1/2), años de antigüedad y asistencia perfecta (S/N)")
        Leer (categoria, antiguedad, asistencia)
        Si categoria = 1 Entonces
            basico:= 700
        Sino
            basico:= 500
        FinSi
        sueldo:= basico + basico * 0,02 * antiguedad
        Si asistencia = "S" Entonces
            sueldo:= sueldo + premio
        FinSi
        Escribir ("Sueldo del chofer ", i, ": ", sueldo)
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.31
// Una fábrica textil produce telas de dos calidades distintas (primera y
// segunda) y de dos materiales distintos (seda y algodón). Generar un
// algoritmo que calcule el peso de varias piezas de tela, el cual está dado
// por la suma del peso neto, más un porcentaje por el apresto, más el peso
// del núcleo de cartón.
// Para realizar el cálculo, tener en cuenta la siguiente información, para
// cada pieza:
//
// * El peso del m2 y la longitud de cada pieza.
// * Al peso neto de la tela hay que sumarle un porcentaje por cada pieza,
// debido al apresto, el cual es del 2% para las telas de seda y del 7% para
// las de algodón.
// * También se debe considerar el núcleo de cartón, que es de 400 gr. para
// los rollos de telas de primera y de 300 gr. en los de segunda.
//
// Finalizar cuando la variable FIN sea igual a 'SI'.
// --------------------------------------------------------------------------

Acción Ejercicio1_31 es
Ambiente
    Variables
        peso_m2, longitud, peso_neto, apresto, nucleo, peso_total: Real
        calidad: Caracter // "P" primera, "S" segunda
        material: Caracter // "S" seda, "A" algodón
        FIN: AN(2)
Proceso
    Escribir ("¿Terminar? (SI/NO)")
    Leer (FIN)
    Mientras FIN <> "SI" Hacer
        Escribir ("Ingrese peso del m2 (en gr), longitud, calidad (P/S) y material (S/A)")
        Leer (peso_m2, longitud, calidad, material)
        peso_neto:= peso_m2 * longitud
        Si material = "S" Entonces
            apresto:= peso_neto * 0,02
        Sino
            apresto:= peso_neto * 0,07
        FinSi
        Si calidad = "P" Entonces
            nucleo:= 400
        Sino
            nucleo:= 300
        FinSi
        peso_total:= peso_neto + apresto + nucleo
        Escribir ("Peso total de la pieza: ", peso_total, " gr")
        Escribir ("¿Terminar? (SI/NO)")
        Leer (FIN)
    FinMientras
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.32
// La fecha del domingo de Pascua corresponde al primer domingo después de la
// primera luna llena que sigue al equinoccio de primavera. La secuencia de
// cálculos que permite conocer esta fecha es:
//
// A = anio mod 19
// B = anio mod 4
// C = anio mod 7
// D = ( 19 * A + 24 ) mod 30
// E = ( 2 * B + 4 * C + 6 * D + 5 ) mod 7
// N = ( 22 + D + E )
//
// Donde N indica el número del día del mes de marzo (o abril si N es
// superior a 31) correpondiente al domingo de Pascua. Realizar un algoritmo
// que determine esta fecha para los años comprendidos entre 1990 y 2010
// --------------------------------------------------------------------------

Acción Ejercicio1_32 es
Ambiente
    Variables
        año, A, B, C, D, E, dia: Entero
Proceso
    Escribir ("Ingrese el año")
    Leer (año)
    A:= año mod 19
    B:= año mod 4
    C:= año mod 7
    D:= (19 * A + 24) mod 30
    E:= (2 * B + 4 * C + 6 * D + 5) mod 7
    dia:= 22 + D + E
    Si dia <= 31 Entonces
        Escribir ("El domingo de Pascua es el ", dia, " de marzo")
    Sino
        Escribir ("El domingo de Pascua es el ", dia - 31, " de abril")
    FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.33
// Escribir un algoritmo que permita imprimir la siguiente sucesión.
// Considere que N es un número par, que se ingresa.
//
//     2   4   6    8  ...  N
//     4   6   8   10  ...  N
//     6   8  10   12  ...  N
//     ....
//     ....
//     N
// --------------------------------------------------------------------------

Acción Ejercicio1_33 es
Ambiente
    Variables
        N, inicio, j: Entero
Proceso
    Repetir
        Escribir ("Ingrese un número par N")
        Leer (N)
    Hasta que N mod 2 = 0
    // Cada fila empieza 2 más adelante que la anterior y siempre termina en N
    Para inicio:= 2 hasta N, 2 Hacer
        Para j:= inicio hasta N, 2 Hacer
            Escribir (j, " ") // en la misma línea
        FinPara
        Escribir () // salto de línea
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.34
// Escribir un algoritmo que permita imprimir la siguiente sucesión.
// Considere que N es un número par, que se ingresa.
//
//     2   4   6   ............    N
//     2   4   6   ........    N-2
//     2   4   6   ...     N-4
//     ...........
//     2   4   6
//     2   4
//     2
// --------------------------------------------------------------------------

Acción Ejercicio1_34 es
Ambiente
    Variables
        N, fin, j: Entero
Proceso
    Repetir
        Escribir ("Ingrese un número par N")
        Leer (N)
    Hasta que N mod 2 = 0
    // Todas las filas empiezan en 2; el final baja de a 2 hasta llegar a 2
    Para fin:= N hasta 2, -2 Hacer
        Para j:= 2 hasta fin, 2 Hacer
            Escribir (j, " ") // en la misma línea
        FinPara
        Escribir () // salto de línea
    FinPara
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.35
// Escriba un algoritmo que acepte un número entero que representa una suma
// de dinero e indique cuantos billetes
// de cada denominación necesita, suponiendo que solo existen billetes de
// 500, 100, 50, 20, 10, 5 y 1 peso.
// --------------------------------------------------------------------------

Acción Ejercicio1_35 es
Ambiente
    Variables
        importe, resto: Entero
        b500, b100, b50, b20, b10, b5, b1: Entero
Proceso
    Escribir ("Ingrese el importe (entero)")
    Leer (importe)
    // Siempre se usa primero el billete más grande posible
    resto:= importe
    b500:= TRUNC(resto / 500)
    resto:= resto mod 500
    b100:= TRUNC(resto / 100)
    resto:= resto mod 100
    b50:= TRUNC(resto / 50)
    resto:= resto mod 50
    b20:= TRUNC(resto / 20)
    resto:= resto mod 20
    b10:= TRUNC(resto / 10)
    resto:= resto mod 10
    b5:= TRUNC(resto / 5)
    b1:= resto mod 5
    Escribir ("500: ", b500, " | 100: ", b100, " | 50: ", b50, " | 20: ", b20, " | 10: ", b10, " | 5: ", b5, " | 1: ", b1)
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.36
// Todo número cuya suma de sus dígitos sea múltiplo de 3 lo es también.
//
// Ej: 117 → 1+1+7 = 9 que es múltiplo de 3 , entonces 117 es múltiplo de 3.
//
// Realizar un algoritmo que determine si un número es múltiplo de 3 en
// función de la afirmación antes realizada.
// --------------------------------------------------------------------------

Acción Ejercicio1_36 es
Ambiente
    Variables
        num, aux, suma_digitos: Entero
Proceso
    Escribir ("Ingrese un número entero positivo")
    Leer (num)
    aux:= num
    suma_digitos:= 0
    Mientras aux > 0 Hacer // voy "sacando" el último dígito
        suma_digitos:= suma_digitos + aux mod 10
        aux:= TRUNC(aux / 10)
    FinMientras
    Si suma_digitos mod 3 = 0 Entonces
        Escribir (num, " es múltiplo de 3 (sus dígitos suman ", suma_digitos, ")")
    Sino
        Escribir (num, " no es múltiplo de 3 (sus dígitos suman ", suma_digitos, ")")
    FinSi
FinAcción


// ==========================================================================
//  Ejercicios de la versión anterior de la guía (ya no figuran en la actual)
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 1.1.11
// Dado un año ingresado por el usuario, emitir el mensaje 'ACTUAL' si
// corresponde al año en curso, 'PASADO' si es menor y 'FUTURO' si es mayor.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_11 es
//Ambiente
    Constantes
        año_actual = 2023
    Variables
        año: Entero(4)
//Algoritmo
    Escribir ("Ingrese un año")
    Leer (año)
    // Se compara contra el año en curso, no contra valores fijos como 2022 o 2024
    Si año = año_actual Entonces
        Escribir ("ACTUAL")
    Sino
        Si año < año_actual Entonces
            Escribir ("PASADO")
        Sino
            Escribir ("FUTURO")
        FinSi
    FinSi
FinAcción


// --------------------------------------------------------------------------
// Ejercicio 1.1.14
// En un experimento se obtuvieron un conjunto de pares de valores (S, V) y se
// requiere que desarrolle un programa que determine e imprima:
//   a. Cuántos pares (S, V) tienen el mismo valor de S que el primer par.
//   b. Primer valor de S mayor que V.
//   c. En cuántos pares (S, V) se cumple que S es el doble de V.
//   d. Productoria de los valores de S no nulos, donde V es nulo.
// Fin de datos: se ingresa S = 9999.
// --------------------------------------------------------------------------

Acción Ejercicio1_1_14 es
//Ambiente
    Constantes
        fin = 9999
    Variables
        S, V, primer_S, primer_S_mayor: Real
        cont_igual_primero, cont_doble: Entero
        productoria: Real
        encontrado, hay_producto: Lógico
//Algoritmo
    cont_igual_primero:= 0
    cont_doble:= 0
    productoria:= 1 // neutro de la multiplicación
    encontrado:= Falso
    hay_producto:= Falso

    Escribir ("Ingrese el primer par S, V (S = 9999 para terminar)")
    Leer (S, V)
    primer_S:= S

    Mientras S <> fin Hacer
        Si S = primer_S Entonces // a. incluye al primer par
            cont_igual_primero:= cont_igual_primero + 1
        FinSi
        Si (S > V) y (No encontrado) Entonces // b. me quedo solo con el primero
            primer_S_mayor:= S
            encontrado:= Verdadero
        FinSi
        Si S = 2 * V Entonces // c.
            cont_doble:= cont_doble + 1
        FinSi
        Si (V = 0) y (S <> 0) Entonces // d.
            productoria:= productoria * S
            hay_producto:= Verdadero
        FinSi
        Escribir ("Ingrese el siguiente par S, V (S = 9999 para terminar)")
        Leer (S, V)
    FinMientras

    Escribir ("a. Pares con el mismo S que el primero: ", cont_igual_primero)
    Si encontrado Entonces
        Escribir ("b. Primer S mayor que V: ", primer_S_mayor)
    Sino
        Escribir ("b. Ningún par cumple S > V")
    FinSi
    Escribir ("c. Pares donde S es el doble de V: ", cont_doble)
    Si hay_producto Entonces
        Escribir ("d. Productoria de los S no nulos con V nulo: ", productoria)
    Sino
        Escribir ("d. No hubo pares con V nulo y S no nulo")
    FinSi
FinAcción
