//  Guía de Trabajos Prácticos 1.2 - Subacciones (funciones y procedimientos)
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 1.2.1
// Realice una función que dado un número devuelva su cuadrado.
// --------------------------------------------------------------------------

Acción Ejercicio1_2_1 es
Ambiente
    num, result: entero

    Función Cuadrado (n: entero): entero es
        Cuadrado:= n ** 2 // el valor se devuelve asignándolo al nombre de la función
    FinFunción

Proceso
    Escribir ("Bienvenido! Este programa calcula el cuadrado de un número... Por favor, ingrese un número entero.")
    Leer (num)
    result:= Cuadrado(num)
    Escribir ("El cuadrado del número ingresado es: ", result)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.2.2
// Diseñe una función que devuelva la suma de los dígitos del número natural
// suministrado como parámetro.
// --------------------------------------------------------------------------

Acción Ejercicio1_2_2 es
Ambiente
    num, result: entero

    Función Suma_dig (N: entero): entero es
        Ambiente
            acum, dig: entero
        Proceso
            acum:= 0
            Mientras N > 0 hacer
                dig:= N mod 10      // último dígito
                acum:= acum + dig
                N:= N div 10        // lo saco del número
            FinMientras
            Suma_dig:= acum // se asigna una sola vez, al terminar el ciclo
    FinFunción

Proceso
    Escribir ("Ingrese un número")
    Leer (num)
    result:= Suma_dig(num) // llamada de la función
    Escribir ("La suma de sus dígitos es: ", result)
FinAcción



// --------------------------------------------------------------------------
// Ejercicio 1.2.3
// Diseñe una función que permita ingresar 3 números y devuelva el mínimo valor.
// El programa principal debe permitir que este proceso se repita la cantidad
// de veces que el usuario desee.
// --------------------------------------------------------------------------

Acción Ejercicio1_2_3 es
Ambiente
    op: caracter

    Función Minimo: real es
        Ambiente
            a, b, c, min: real
        Proceso
            Escribir ("Ingrese 3 números")
            Leer (a, b, c)
            min:= a
            Si b < min entonces
                min:= b
            FinSi
            Si c < min entonces
                min:= c
            FinSi
            Minimo:= min
    FinFunción

Proceso
    Repetir
        Escribir ("El mínimo es: ", Minimo)
        Escribir ("¿Desea repetir? S/N")
        Leer (op)
    Hasta que op = "N"
FinAcción
