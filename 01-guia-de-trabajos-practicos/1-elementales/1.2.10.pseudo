// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 1.2 - Subacciones (funciones y procedimientos)
//  Ejercicio 1.2.10
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 1.2.10
// Escribir un único procedimiento `mostrar_nro` que reciba como parámetro un
// dígito y lo muestre por pantalla de la misma forma que se indica en el
// ejercicio 9.
// --------------------------------------------------------------------------

// Un único procedimiento: cada fila del dígito se arma con una función que
// devuelve el "dibujo" de esa fila según el dígito.
Procedimiento mostrar_nro (d: 0..9) es
    Ambiente
        fila: 1..5

        Función Fila (d: 0..9; f: 1..5): AN(5) es
            // Patrones de cada fila: L = "*    "... se usan 4 formas de fila
            //   T = "*****"  A = "*   *"  D = "    *"  I = "*    "
            Según d hacer
                0: Según f hacer 1, 5: Fila:= "*****"  2, 3, 4: Fila:= "*   *" FinSegún
                1: Fila:= "    *"
                2: Según f hacer 1, 3, 5: Fila:= "*****"  2: Fila:= "    *"  4: Fila:= "*    " FinSegún
                3: Según f hacer 1, 3, 5: Fila:= "*****"  2, 4: Fila:= "    *" FinSegún
                4: Según f hacer 1, 2: Fila:= "*   *"  3: Fila:= "*****"  4, 5: Fila:= "    *" FinSegún
                5: Según f hacer 1, 3, 5: Fila:= "*****"  2: Fila:= "*    "  4: Fila:= "    *" FinSegún
                6: Según f hacer 1, 3, 5: Fila:= "*****"  2: Fila:= "*    "  4: Fila:= "*   *" FinSegún
                7: Según f hacer 1: Fila:= "*****"  2, 3, 4, 5: Fila:= "    *" FinSegún
                8: Según f hacer 1, 3, 5: Fila:= "*****"  2, 4: Fila:= "*   *" FinSegún
                9: Según f hacer 1, 3, 5: Fila:= "*****"  2: Fila:= "*   *"  4: Fila:= "    *" FinSegún
            FinSegún
        FinFunción

    Proceso
        Para fila:= 1 hasta 5 hacer
            Escribir(Fila(d, fila))
        FinPara
FinProcedimiento
