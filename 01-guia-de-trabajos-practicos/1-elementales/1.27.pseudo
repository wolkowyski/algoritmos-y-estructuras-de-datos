//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 1.1 - Datos y Estructuras Elementales
//  Estructuras condicionales y repetitivas
//  Ejercicio 1.27
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 1.27
// Repita el ejercicio anterior de modo que sea posible estudiar varias
// funciones, indicando que se desea terminar al ingresar 9999 para el
// término cuadrático.
// --------------------------------------------------------------------------

Acción Ejercicio1_27 es
Ambiente
    Constantes
        fin = 9999
    Variables
        a, b, c, Y: Real
        X: Entero
Proceso
    Escribir ("Ingrese el término cuadrático a (9999 para terminar)")
    Leer (a)
    Mientras a <> fin Hacer
        Escribir ("Ingrese b y c")
        Leer (b, c)
        Para X:= 20 hasta -20, -2 Hacer
            Y:= a * X**2 + b * X + c
            Escribir ("(", X, ", ", Y, ")")
        FinPara
        Escribir ("Ingrese el término cuadrático a (9999 para terminar)")
        Leer (a)
    FinMientras
FinAcción
