//  Estructuras condicionales y repetitivas
//  Ejercicio 1.30
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 1.30
// Escriba un algoritmo para resolver el siguiente problema: Una empresa de
// transportes desea conocer el sueldo de sus 100 choferes. Estos se calculan
// teniendo en cuenta la categoría (1 o 2) y la asistencia (perfecta: si o
// no).
// El sueldo se obtiene sumando el sueldo básico, más el 2% de antigüedad por
// cada año trabajado y $200 de premio por asistencia.
// El sueldo básico es de 700 para choferes de categoría 1 y de 500.- para
// los de categoría 2.
// --------------------------------------------------------------------------

Acción Ejercicio1_30 es
Ambiente
    Constantes
        premio = 200
    Variables
        i, antiguedad: Entero
        categoria: 1..2
        asistencia: Caracter // "S" o "N"
        basico, sueldo: Real
Proceso
    Para i:= 1 hasta 100 Hacer
        Escribir ("Chofer ", i, ": ingrese categoría (1/2), años de antigüedad y asistencia perfecta (S/N)")
        Leer (categoria, antiguedad, asistencia)
        Si categoria = 1 Entonces
            basico:= 700
        Sino
            basico:= 500
        FinSi
        sueldo:= basico + basico * 0,02 * antiguedad
        Si asistencia = "S" Entonces
            sueldo:= sueldo + premio
        FinSi
        Escribir ("Sueldo del chofer ", i, ": ", sueldo)
    FinPara
FinAcción
