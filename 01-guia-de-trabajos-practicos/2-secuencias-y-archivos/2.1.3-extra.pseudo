// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 2.1 - Secuencias de datos elementales (extra)
//  Página "Secuencias de datos elementales - Extra" de la guía
//  Ejercicio 2.1.3
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 2.1.3 (extra)
// Desglosar una secuencia de enteros que contiene monotonías crecientes en dos
// secuencias de salida, copiando las monotonías alternativamente en una y en
// otra.
// Entrada: 2,5,8,11,14,17, 15, 10,11,20,44, 12,14,16
// Salida 1: 2,5,8,11,14,17, 10,11,20,44
// Salida 2: 15, 12,14,16
// Si te animás: sumar los valores de cada salida e informar la suma mayor.
// --------------------------------------------------------------------------

Acción Extra2_1_3 es
    Ambiente
        Sec, Sal1, Sal2: secuencia de enteros
        v, anterior: entero
        en_sal1: booleano // indica a qué salida va la monotonía actual
        suma1, suma2: entero
    Proceso
        ARR(Sec)
        CREAR(Sal1)
        CREAR(Sal2)
        suma1:= 0
        suma2:= 0
        en_sal1:= Verdadero
        AVZ(Sec, v)
        anterior:= v
        Mientras NFDS(Sec) hacer
            Si v < anterior entonces // se cortó la monotonía: cambio de salida
                en_sal1:= No en_sal1
            FinSi
            Si en_sal1 entonces
                ESC(Sal1, v)
                suma1:= suma1 + v
            Sino
                ESC(Sal2, v)
                suma2:= suma2 + v
            FinSi
            anterior:= v
            AVZ(Sec, v)
        FinMientras
        Si suma1 >= suma2 entonces
            Escribir ("La suma mayor es la de la salida 1: ", suma1)
        Sino
            Escribir ("La suma mayor es la de la salida 2: ", suma2)
        FinSi
        CERRAR(Sec)
        CERRAR(Sal1)
        CERRAR(Sal2)
FinAcción
