// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 2.1 - Secuencias de datos elementales
//  Primitivas de secuencias usadas en la cátedra
//    ARR(S)     arranca (abre) la secuencia S para leer
//    AVZ(S, v)  avanza y deja en v el elemento actual
//    CREAR(S)   crea una secuencia de salida
//    ESC(S, v)  escribe v en la secuencia de salida
//    NFDS(S)    "no fin de secuencia"
//    CERRAR(S)  cierra la secuencia
//  Ejercicio 2.1.9
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 2.1.9
// Se dispone de una secuencia de caracteres. Se desea determinar la cantidad
// de palabras que comienzan con la letra 'I'.
// --------------------------------------------------------------------------

Acción Ejercicio2_1_9 es
Ambiente
    Sec: secuencia de caracteres
    v: caracter
    cont: entero
Proceso
    ARR(Sec)
    AVZ(Sec, v)
    cont:= 0
    Mientras NFDS(Sec) hacer
        Mientras NFDS(Sec) y (v = " ") hacer // salteo blancos
            AVZ(Sec, v)
        FinMientras
        Si NFDS(Sec) entonces // estoy en la primera letra de una palabra
            Si v = "I" entonces
                cont:= cont + 1
            FinSi
            Mientras NFDS(Sec) y (v <> " ") hacer // recorro el resto de la palabra
                AVZ(Sec, v)
            FinMientras
        FinSi
    FinMientras
    Escribir ("Palabras que empiezan con I: ", cont)
    CERRAR(Sec)
FinAcción
