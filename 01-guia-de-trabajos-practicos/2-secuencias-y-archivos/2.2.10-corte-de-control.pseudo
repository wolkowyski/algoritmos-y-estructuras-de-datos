// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 2.2 - Ejercicio 2.2.10 (corte de control de un nivel)
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 2.2.10
// Del archivo general de alumnos de la U.T.N. - Facultad Regional
// Resistencia, ordenado por carrera, se desea emitir la cantidad de alumnos
// correspondientes a cada carrera y el total general.
// --------------------------------------------------------------------------

Accion Ejercicio2_2_10 es
Ambiente
	Alumno = Registro
		Carrera: AN(3)
		Legajo: N(5)
		Apellido_Nombre: AN(50)
	FinRegistro
	ALUMNOS: Archivo de Alumno ordenado por Carrera
	Reg: Alumno
	ResCarrera: AN(3)
	TotCarrera, TotGral: entero

	Procedimiento CorteCarrera es
		Escribir("Carrera ", ResCarrera, ": ", TotCarrera, " alumnos")
		TotGral:= TotGral + TotCarrera
		TotCarrera:= 0
		ResCarrera:= Reg.Carrera
	FinProcedimiento

Proceso
	Abrir E/(ALUMNOS); Leer(ALUMNOS, Reg)
	TotCarrera:= 0; TotGral:= 0
	ResCarrera:= Reg.Carrera
	Mientras No FDA(ALUMNOS) hacer
		Si Reg.Carrera <> ResCarrera entonces
			CorteCarrera
		FinSi
		TotCarrera:= TotCarrera + 1
		Leer(ALUMNOS, Reg)
	FinMientras
	CorteCarrera
	Escribir("Total general: ", TotGral)
	Cerrar(ALUMNOS)
Fin Acción
