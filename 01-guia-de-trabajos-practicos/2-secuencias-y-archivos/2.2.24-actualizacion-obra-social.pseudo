// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 2.2 - Ejercicio 2.2.24 (actualización por lotes)
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 2.2.24
// Una obra social lleva el control de los costos que le insume cada
// afiliado. Considerando como costos, los pagos que la misma debe realizar
// (en conceptos de honorarios, pagos a farmacias, etc) por los distintos
// servicios que el afiliado utiliza.
// Para esto la empresa cuenta con un archivo COSTOS_POR_AFILIADO, en el cual
// se registran la cantidad de atenciones y/o servicios que solicita el
// empleado y el costo total (en pesos) que la empresa debe pagar por estos.
// Este archivo está conformado por registros con el siguiente formato, y
// está ordenado Cod_Afiliado
//
// COSTOS_POR_AFILIADO Ordenado por Cod_Afiliado
//
// * Cod_Afiliado* Fecha_Alta* Fecha_Baja* Cant_Servicios* Costo
//
// Cada viernes en la organización, se lleva a cabo un proceso de
// actualización del archivo COSTOS_POR_AFILIADO. Para poder realizarlo se
// cuenta con un archivo SERVICIOS_SEMANALES, ordenado por cod_afiliado y
// fecha_at, en el cual se registran los servicios que solicitaron los
// afiliados durante cada semana. Cada registro de este archivo presenta el
// siguiente formato,
//
// SERVICIOS_SEMANALES Ordenado por Cod_Afiliado
//
// * Cod_Afiliado* Fecha_At* Cod_Servicio* Costo
//
// En el archivo SERVICIOS_SEMANALES puede existir más de un registro por
// cada afiliado.
//
// Para realizar el proceso de actualización se deben tener en cuenta las
// siguientes consideraciones.
//
// * Si algún Cod_Afiliado de serviciosSemanales, no se encuentra en ningún
// registro del archivo COSTOS_POR_AFILIADO, y el primer Cod_Servicio
// asociado al mismo es igual a 001 entonces se trata de un nuevo afiliado
// que fue dado de alta.
// * Si Cod_Afiliado de serviciosSemanales es igual al de COSTOS_POR_AFILIADO
// y el Cod_Servicio es igual a 000 se trata de un afiliado que fue dado de
// baja y se considera como fecha de baja el valor que reside en Fecha_At. Si
// en cambio, el Cod_Servicio tiene algún otro valor este representa un
// servicio o atención que solicitó el afiliado; por lo tanto deben
// contabilizarse la cantidad de servicios que solicitó; como así también los
// costos que estos insumen.
// * Si algún Cod_Afiliado de COSTOS_POR_AFILIADO no se encuentra en el
// archivo SERVICIOS_SEMANALES, se trata de un afiliado que no utilizó los
// servicios en la semana que se realiza la actualización.
// * Cualquier otro caso distinto a los considerados anteriormente se toma
// como un error, y deben ser informados por pantalla; indicando claramente
// el motivo del error.
// --------------------------------------------------------------------------

Accion Ejercicio2_2_24 es
Ambiente
	Fecha = Registro
		aa: N(4); mm: 1..12; dd: 1..31
	FinRegistro
	Costo = Registro
		Cod_Afiliado: N(8)
		Fecha_Alta, Fecha_Baja: Fecha
		Cant_Servicios: N(5)
		Costo: real
	FinRegistro
	Servicio = Registro
		Cod_Afiliado: N(8)
		Fecha_At: Fecha
		Cod_Servicio: N(3)
		Costo: real
	FinRegistro
	COSTOS, COSTOS_ACT: Archivo de Costo ordenado por Cod_Afiliado
	SERVICIOS: Archivo de Servicio ordenado por Cod_Afiliado y Fecha_At
	RC, Aux: Costo
	RS: Servicio
	HV = 99999999
	valido: booleano

	Procedimiento LeerCostos es
		Leer(COSTOS, RC)
		Si FDA(COSTOS) entonces RC.Cod_Afiliado:= HV FinSi
	FinProcedimiento

	Procedimiento LeerServ es
		Leer(SERVICIOS, RS)
		Si FDA(SERVICIOS) entonces RS.Cod_Afiliado:= HV FinSi
	FinProcedimiento

	Procedimiento AplicarServicios es // todos los servicios de Aux.Cod_Afiliado
		Mientras RS.Cod_Afiliado = Aux.Cod_Afiliado hacer
			Si RS.Cod_Servicio = 0 entonces // 000: baja
				Aux.Fecha_Baja:= RS.Fecha_At
			Sino
				Aux.Cant_Servicios:= Aux.Cant_Servicios + 1
				Aux.Costo:= Aux.Costo + RS.Costo
			FinSi
			LeerServ
		FinMientras
	FinProcedimiento

Proceso
	Abrir E/(COSTOS); LeerCostos
	Abrir E/(SERVICIOS); LeerServ
	Abrir /S(COSTOS_ACT)
	Mientras (RC.Cod_Afiliado <> HV) o (RS.Cod_Afiliado <> HV) hacer
		Si RC.Cod_Afiliado < RS.Cod_Afiliado entonces // no usó servicios esta semana
			Escribir(COSTOS_ACT, RC)
			LeerCostos
		Sino
			Si RC.Cod_Afiliado = RS.Cod_Afiliado entonces
				Aux:= RC
				AplicarServicios
				Escribir(COSTOS_ACT, Aux)
				LeerCostos
			Sino // afiliado que no está en el maestro
				Si RS.Cod_Servicio = 1 entonces // 001: alta
					Aux.Cod_Afiliado:= RS.Cod_Afiliado
					Aux.Fecha_Alta:= RS.Fecha_At
					Aux.Fecha_Baja.aa:= 0 // sin baja
					Aux.Cant_Servicios:= 0
					Aux.Costo:= 0
					LeerServ // el 001 es el alta, no un servicio
					AplicarServicios
					Escribir(COSTOS_ACT, Aux)
				Sino
					Escribir("Error: el afiliado ", RS.Cod_Afiliado, " no existe y su primer servicio no es un alta (001)")
					Aux.Cod_Afiliado:= RS.Cod_Afiliado
					Mientras RS.Cod_Afiliado = Aux.Cod_Afiliado hacer // descarto sus servicios
						LeerServ
					FinMientras
				FinSi
			FinSi
		FinSi
	FinMientras
	Cerrar(COSTOS); Cerrar(SERVICIOS); Cerrar(COSTOS_ACT)
Fin Acción
