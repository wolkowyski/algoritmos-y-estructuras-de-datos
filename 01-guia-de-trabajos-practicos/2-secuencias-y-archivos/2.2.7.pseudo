// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 2.2 - Archivos secuenciales
//  Primitivas: Abrir E/ (entrada) | Abrir /S (salida) | Leer | Escribir |
//              FDA (fin de archivo) | Cerrar
//  Ejercicio 2.2.7
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 2.2.7
// Se dispone de un archivo con los datos de un padrón electoral con la
// siguiente información:
//
// * Nombre y apellido
// * Clase
// * DNI
// * Dirección
// * Nº de Mesa
// * Observaciones
// * Nº de Circuito
// * Partido (0= independiente, 1=‘A’, 2=‘B’, 3=‘C’)
//
// Generar:
// a) Una secuencia de salida con nombre y apellido, DNI, y dirección de
// todas las personas afiliadas al partido “C”.
// b) Una secuencia de salida con nombre y apellido, DNI, y dirección de
// todas las personas no afiliadas a ningún partido y de clase posterior a
// 1940.
// --------------------------------------------------------------------------

Accion Ejercicio2_2_7 es
Ambiente
	PadronElectoral = Registro
		Nombre_Apellido: AN(60)
		Clase: N(4)
		DNI: N(8)
		Dirección: AN(100)
		Num_mesa: N(5)
		Observaciones: AN(255)
		Num_Circuito: N(4)
		Partido: 0..3 // 0 = independiente, 1 = 'A', 2 = 'B', 3 = 'C'
	FinRegistro
	ArchPadron: Archivo de PadronElectoral
	RegPadron: PadronElectoral

	Persona = Registro
		Nombre_Apellido: AN(60)
		DNI: N(8)
		Dirección: AN(100)
	FinRegistro
	SalidaC, SalidaIndep: Archivo de Persona // a) y b)
	RegSal: Persona
Proceso
	Abrir E/(ArchPadron)
	Leer(ArchPadron, RegPadron)
	Abrir /S(SalidaC)
	Abrir /S(SalidaIndep)
	Mientras No FDA(ArchPadron) hacer
		RegSal.Nombre_Apellido:= RegPadron.Nombre_Apellido
		RegSal.DNI:= RegPadron.DNI
		RegSal.Dirección:= RegPadron.Dirección
		Si RegPadron.Partido = 3 entonces // a) afiliados al partido C
			Escribir(SalidaC, RegSal)
		Sino
			Si (RegPadron.Partido = 0) y (RegPadron.Clase > 1940) entonces // b)
				Escribir(SalidaIndep, RegSal)
			FinSi
		FinSi
		Leer(ArchPadron, RegPadron)
	FinMientras
	Cerrar(ArchPadron)
	Cerrar(SalidaC)
	Cerrar(SalidaIndep)
Fin Acción
