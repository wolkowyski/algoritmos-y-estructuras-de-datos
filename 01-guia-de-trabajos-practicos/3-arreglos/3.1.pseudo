// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 3 - Arreglos - Ejercicio 3.1
// ==========================================================================

// Para cada una de las consignas siguientes, genere un algoritmo que permita
// solucionarla (3 algoritmos) usando un arreglo de 100 números enteros:
//   a. Almacenar 100 números.
//   b. Localizar el número de mayor valor y el de menor valor, informar sus
//      valores y sus posiciones.
//   c. Contar y sumar todos los números pares.


// a. Carga del arreglo
Acción Ejercicio3_1_a es
	Ambiente
		num: arreglo de [1..100] de entero
		i: 1..100
	Proceso
		Para i:= 1 a 100, 1 hacer
			Escribir("Por favor ingrese el elemento para la posición ", i)
			Leer(num[i])
		FinPara
FinAcción


// b. Mayor y menor con sus posiciones (el arreglo ya está cargado)
Acción Ejercicio3_1_b es
	Ambiente
		num: arreglo de [1..100] de entero
		i, posmax, posmin: 1..100
		max, min: entero
	Proceso
		// Arranco suponiendo que el primero es a la vez el mayor y el menor
		max:= num[1]
		min:= num[1]
		posmax:= 1
		posmin:= 1

		Para i:= 2 a 100, 1 hacer
			Si num[i] > max entonces
				max:= num[i]
				posmax:= i // la posición es el índice, no num[i]
			Sino
				Si num[i] < min entonces
					min:= num[i]
					posmin:= i
				FinSi
			FinSi
		FinPara

		Escribir("El mayor es ", max, " y está en la posición ", posmax)
		Escribir("El menor es ", min, " y está en la posición ", posmin)
FinAcción


// c. Cantidad y suma de los pares
Acción Ejercicio3_1_c es
	Ambiente
		num: arreglo de [1..100] de entero
		i: 1..100
		suma, cont: entero
	Proceso
		suma:= 0 // los acumuladores se inicializan antes del ciclo
		cont:= 0
		Para i:= 1 a 100, 1 hacer
			Si num[i] Mod 2 = 0 entonces
				suma:= suma + num[i]
				cont:= cont + 1
			FinSi
		FinPara
		Escribir("Hay ", cont, " números pares y suman ", suma)
FinAcción
