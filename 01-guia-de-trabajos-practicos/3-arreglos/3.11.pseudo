// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 3 - Arreglos - Ejercicio 3.11
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 3.11
// Dado un arreglo de 100 elementos, que contiene la siguiente información
// sobre videos: Título de la película, Nombre del Director, Categoría de
// película, Cantidad de personas que la vieron, Alquilado (si/no); y está
// ordenado por el Título de la película, diseñe un algoritmo que, ingresando
// una categoría, liste todas las películas que pertenecen a dicha categoría.
// --------------------------------------------------------------------------

// Ordenado por título, no por categoría: búsqueda lineal pura.
Acción Ejercicio3_11 es
	Ambiente
		Video = Registro
			Titulo: AN(50)
			Director: AN(30)
			Categoria: AN(20)
			Vistas: N(6)
			Alquilado: ("si", "no")
		FinRegistro
		Videos: arreglo de [1..100] de Video
		cat: AN(20)
		i, cant: entero
	Proceso
		Escribir("Ingrese la categoría")
		Leer(cat)
		cant:= 0
		Para i:= 1 a 100 hacer
			Si Videos[i].Categoria = cat entonces
				Escribir(Videos[i].Titulo)
				cant:= cant + 1
			FinSi
		FinPara
		Si cant = 0 entonces
			Escribir("No hay películas de esa categoría")
		FinSi
FinAcción
