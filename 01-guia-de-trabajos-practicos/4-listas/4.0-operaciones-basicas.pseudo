// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 4 - Listas: operaciones básicas (apunte)
// ==========================================================================

// Notación: p^.dato y *p.dato son equivalentes, significan "el campo dato
// del nodo al que apunta p". En los ejercicios se usan las dos.
//
//   Nuevo(p)      reserva memoria para un nodo nuevo y deja p apuntándolo
//   Disponer(p)   libera el nodo apuntado por p
//   nil           puntero que no apunta a nada (lista vacía / fin de lista)
//
// Cargar un nodo:  Leer(q^.dato)            // de manera directa
//                  Leer(algo); q^.dato:= algo // o con asignación
// Avanzar:         p:= p^.prox
// Mostrar:         Escribir(p^.dato)


// Carga apilada (cada nodo nuevo queda primero: la lista sale al revés)
Acción Carga es
    Ambiente
        Nodo = Registro
            dato: entero
            prox: puntero a Nodo
        FinRegistro
        prim, p: puntero a Nodo
        valor: entero

    Proceso
        prim:= nil
        Leer(valor)
        Mientras valor <> 0 hacer // 0 como marca de fin
            Nuevo(p)
            p^.dato:= valor
            p^.prox:= prim // el nuevo apunta al que era el primero
            prim:= p       // y pasa a ser el primero
            Leer(valor)
        FinMientras
FinAcción


// Carga ordenada (inserción manteniendo la lista ordenada de menor a mayor)
Acción Carga_Ordenada es
    Ambiente
        Nodo = Registro
            dato: entero
            prox: puntero a Nodo
        FinRegistro
        prim, p, q, anterior: puntero a Nodo
        valor: entero

    Proceso
        prim:= nil
        Leer(valor)
        Mientras valor <> 0 hacer
            Nuevo(p)
            p^.dato:= valor

            // Busco la posición: me detengo en el primer nodo mayor o igual
            anterior:= nil
            q:= prim
            Mientras (q <> nil) y (q^.dato < valor) hacer
                anterior:= q
                q:= q^.prox
            FinMientras

            Si anterior = nil entonces // va primero (lista vacía o es el menor)
                p^.prox:= prim
                prim:= p
            SiNo                       // va en el medio o al final
                p^.prox:= q
                anterior^.prox:= p
            FinSi

            Leer(valor)
        FinMientras
FinAcción


// Carga encolada (cada nodo nuevo va al final: se mantiene el orden de llegada)
// Se guarda un puntero al último para no recorrer la lista en cada alta.
Acción Carga_Encolada es
    Ambiente
        Nodo = Registro
            dato: entero
            prox: puntero a Nodo
        FinRegistro
        prim, ult, p: puntero a Nodo
        valor: entero

    Proceso
        prim:= nil
        Leer(valor)
        Mientras valor <> 0 hacer
            Nuevo(p)
            p^.dato:= valor
            p^.prox:= nil
            Si prim = nil entonces // primer nodo
                prim:= p
            SiNo
                ult^.prox:= p
            FinSi
            ult:= p
            Leer(valor)
        FinMientras
FinAcción


// Búsqueda de un valor (lista ordenada de menor a mayor: se corta en el
// primer nodo mayor; si no está ordenada, la condición es solo p^.dato <> buscado)
Acción Busqueda es
    Ambiente
        // (Nodo como arriba)
        prim, p: puntero a Nodo
        buscado: entero

    Proceso
        Leer(buscado)
        p:= prim
        Mientras (p <> nil) y (p^.dato < buscado) hacer // p <> nil siempre primero
            p:= p^.prox
        FinMientras
        Si (p <> nil) y (p^.dato = buscado) entonces
            Escribir("Encontrado")
        SiNo
            Escribir("No está en la lista")
        FinSi
FinAcción


// Eliminación de un valor: se busca guardando el anterior y se desengancha
Acción Eliminacion es
    Ambiente
        // (Nodo como arriba)
        prim, p, anterior: puntero a Nodo
        buscado: entero

    Proceso
        Leer(buscado)
        anterior:= nil
        p:= prim
        Mientras (p <> nil) y (p^.dato <> buscado) hacer
            anterior:= p
            p:= p^.prox
        FinMientras
        Si p = nil entonces
            Escribir("No está en la lista")
        SiNo
            Si anterior = nil entonces // era el primero
                prim:= p^.prox
            SiNo
                anterior^.prox:= p^.prox
            FinSi
            Disponer(p)
        FinSi
FinAcción

