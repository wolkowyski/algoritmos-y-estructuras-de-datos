// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 4 - Listas - Ejercicio 4.16 (pila LIFO)
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 4.16
// Supóngase que, utilizando una lista encadenada, se implementa una pila P
// (estructura 'LIFO', es decir, 'último en entrar, primero en salir').
// Diseñar un algoritmo que permita insertar o extraer un elemento,
// comprobando siempre si la pila está vacía o no.
// --------------------------------------------------------------------------

// Pila con un solo puntero al tope: se inserta y se extrae por el mismo lado
// (es la carga apilada de listas).
Accion Ejercicio4_16 es
Ambiente
	Nodo = Registro
		dato: entero
		prox: puntero a Nodo
	FinRegistro
	tope, q: puntero a Nodo
	valor: entero
	op: 1..3

	Función Vacia: booleano es
		Vacia:= (tope = nil)
	FinFunción

	Procedimiento Apilar (x: entero) es
		Nuevo(q)
		*q.dato:= x
		*q.prox:= tope
		tope:= q
	FinProcedimiento

	Procedimiento Desapilar (Var x: entero) es
		Si Vacia entonces
			Escribir("Error: la pila está vacía")
		Sino
			q:= tope
			x:= *q.dato
			tope:= *q.prox
			Disponer(q)
		FinSi
	FinProcedimiento

Proceso
	tope:= nil
	Repetir
		Escribir("1- Apilar  2- Desapilar  3- Salir")
		Leer(op)
		Según op hacer
			1: Leer(valor); Apilar(valor)
			2: Si No Vacia entonces Desapilar(valor); Escribir("Salió: ", valor) Sino Escribir("Pila vacía") FinSi
		FinSegún
	Hasta que op = 3
FinAccion
