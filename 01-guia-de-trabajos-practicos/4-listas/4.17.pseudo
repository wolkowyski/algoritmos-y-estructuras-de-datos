// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 4 - Listas - Ejercicio 4.17
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 4.17
// Teniendo en cuenta el ejercicio 1.20 del TP2:
//
// *Se posee 2 secuencias (S1 y S2) con las cuales se desea generar una nueva
// secuencia (SAL) donde se intercalen las palabras de las secuencias de
// entrada, de la siguiente manera: copiar de S1 aquellas palabras que
// empiezan y terminan con la misma letra y de S2 aquellas palabras que
// posean al menos un digito numérico y además estén en posición par.*
//
// Escribir un algoritmo que lo resuelva, teniendo en cuenta que conoce la
// estructura de listas.
// --------------------------------------------------------------------------

// Igual al 3.30, pero cada palabra se guarda en una lista de caracteres en
// lugar de un arreglo: no hace falta conocer el largo máximo.
Accion Ejercicio4_17 es
Ambiente
	S1, S2, SAL: secuencia de caracteres
	v1, v2: caracter
	Letra = Registro
		c: caracter
		prox: puntero a Letra
	FinRegistro
	prim, ult, q: puntero a Letra
	pos2: entero
	hay_digito: booleano

	Procedimiento LeerPalabra (Var S: secuencia de caracteres; Var v: caracter) es // carga encolada
		Mientras prim <> nil hacer // libero la palabra anterior
			q:= prim; prim:= *prim.prox; Disponer(q)
		FinMientras
		ult:= nil
		Mientras NFDS(S) y (v = " ") hacer
			AVZ(S, v)
		FinMientras
		Mientras NFDS(S) y (v <> " ") hacer
			Nuevo(q); *q.c:= v; *q.prox:= nil
			Si prim = nil entonces prim:= q Sino *ult.prox:= q FinSi
			ult:= q
			AVZ(S, v)
		FinMientras
	FinProcedimiento

	Procedimiento CopiarPalabra es
		q:= prim
		Mientras q <> nil hacer
			ESC(SAL, *q.c)
			q:= *q.prox
		FinMientras
		ESC(SAL, " ")
	FinProcedimiento

Proceso
	ARR(S1); AVZ(S1, v1)
	ARR(S2); AVZ(S2, v2)
	CREAR(SAL)
	prim:= nil
	pos2:= 0
	Mientras NFDS(S1) o NFDS(S2) hacer
		Repetir // de S1: empieza y termina con la misma letra
			LeerPalabra(S1, v1)
		Hasta que (prim = nil) o (*prim.c = *ult.c)
		Si prim <> nil entonces CopiarPalabra FinSi
		Repetir // de S2: posición par y al menos un dígito
			LeerPalabra(S2, v2)
			Si prim <> nil entonces
				pos2:= pos2 + 1
				hay_digito:= Falso
				q:= prim
				Mientras q <> nil hacer
					Si *q.c en {"0".."9"} entonces hay_digito:= Verdadero FinSi
					q:= *q.prox
				FinMientras
			FinSi
		Hasta que (prim = nil) o ((pos2 mod 2 = 0) y hay_digito)
		Si prim <> nil entonces CopiarPalabra FinSi
	FinMientras
	CERRAR(S1); CERRAR(S2); CERRAR(SAL)
FinAccion
