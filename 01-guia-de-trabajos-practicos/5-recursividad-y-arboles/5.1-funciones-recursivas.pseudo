// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos 5.1 - Funciones recursivas (5.1.1 a 5.1.8)
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 5.1.1
// Calcular el factorial de un número positivo n. Tener en cuenta la
// definición matemática de n!:
//
//  n! =
// \begin{cases}
// 1, & \text{si n = 0} \\
// n \times (n-1)!, & \text{si n > 0}
// \end{cases}
// --------------------------------------------------------------------------

Función Factorial (n: entero): entero es
	Si n = 0 entonces
		Factorial:= 1 // caso base
	Sino
		Factorial:= n * Factorial(n - 1) // caso recursivo
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.1.2
// Dado un número n como parámetro de entrada, calcular el n-ésimo número de
// la serie de Fibonacci. Tener en cuenta la siguiente definición:
//
//  Fib(n) =
// \begin{cases}
// 1, & \text{si n = 1, n = 2} \\
// Fib(n-1) + Fib(n-2), & \text{si n > 2}
// \end{cases}
// --------------------------------------------------------------------------

Función Fib (n: entero): entero es
	Si (n = 1) o (n = 2) entonces
		Fib:= 1
	Sino
		Fib:= Fib(n - 1) + Fib(n - 2) // dos llamadas recursivas por nivel
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.1.3
// Dados dos números: a y b. Calcule la potencia a^b, usando sólo
// multiplicaciones sucesivas.
// --------------------------------------------------------------------------

Función Potencia (a: real; b: entero): real es // b >= 0
	Si b = 0 entonces
		Potencia:= 1
	Sino
		Potencia:= a * Potencia(a, b - 1)
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.1.4
// Construir un algoritmo recursivo que permita determinar si los dígitos de
// un número n dado son todos pares.
// --------------------------------------------------------------------------

Función TodosPares (n: entero): booleano es
	Si n < 10 entonces // un solo dígito
		TodosPares:= (n mod 2 = 0)
	Sino
		TodosPares:= (n mod 2 = 0) y TodosPares(n div 10) // último dígito y el resto
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.1.5
// Dados dos números enteros, divídalos (división entera) y muestre el
// resultado, usando sólo la operación resta.
// --------------------------------------------------------------------------

Función Division (a, b: entero): entero es // a >= 0, b > 0
	Si a < b entonces
		Division:= 0
	Sino
		Division:= 1 + Division(a - b, b) // cada resta suma 1 al cociente
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.1.6
// Determine recursivamente si un número dado es par o impar, usando sólo la
// operación resta.
// --------------------------------------------------------------------------

Función EsPar (n: entero): booleano es // n >= 0
	Si n = 0 entonces
		EsPar:= Verdadero
	Sino
		Si n = 1 entonces
			EsPar:= Falso
		Sino
			EsPar:= EsPar(n - 2)
		FinSi
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.1.7
// El algoritmo de Euclides para encontrar el `MCD`(máximo común divisor) de
// dos números enteros positivos (`m` y `n`) se puede definir recursivamente.
// Algoritmo de Euclides: el `MCD` de dos enteros es el entero mayor que
// divide a ambos.
//
// | Dividendo | Divisor | Cociente | Resto |
// | --- | --- | --- | --- |
// | m | n | q1 | r1 |
// | n | r1 | q2 | r2 |
// | r1 | r2 | q3 | r3 |
//
// Cuando el último resto es cero (por ej. r3 = 0), el `MCD` es el último
// divisor (en ese caso, r2).
// El algoritmo recursivo se puede definir con los siguientes pasos:
//
// * `MCD (m,n) = n, si n <= m, n divide a m`
// * `MCD (m,n) = MCD (n, m), si m < n`
// * `MCD (m,n) = MCD (n, resto de m dividio por n)`
//
// Para simplificar el algoritmo considerar que siempre `m > n`
// --------------------------------------------------------------------------

Función MCD (m, n: entero): entero es // m > n > 0
	Si m mod n = 0 entonces // n divide a m
		MCD:= n
	Sino
		MCD:= MCD(n, m mod n)
	FinSi
FinFunción
// Prueba de escritorio: MCD(48, 18) -> MCD(18, 12) -> MCD(12, 6) -> 6


// --------------------------------------------------------------------------
// Ejercicio 5.1.8
// Dado un vector de 10 números enteros, calcular la suma de sus elementos
// --------------------------------------------------------------------------

Función SumaVector (V: arreglo [1..10] de entero; i: entero): entero es
	Si i = 10 entonces // caso base: último elemento
		SumaVector:= V[i]
	Sino
		SumaVector:= V[i] + SumaVector(V, i + 1)
	FinSi
FinFunción
// Llamada inicial: total:= SumaVector(V, 1)
