// --------------------------------------------------------------------------
// Ejercicio 5.3.3
// Dada la expresión de la siguiente línea, dibujar el árbol equivalente
//
// `[ ( x - y ) * z ] / ( m + n  p)`
// --------------------------------------------------------------------------

// El operador que se aplica último queda en la raíz (la división):
//
//                 /
//           *           +
//         -   z       m    **
//        x y              n  p


// --------------------------------------------------------------------------
// Ejercicio 5.3.4
// Dado el siguiente árbol:
//
// (ver figura en la guía)
//
// 1. Indique el resultado del recorrido post-orden
// 2. Indique el resultado del recorrido en-orden
// 3. Elabore un algoritmo para el recorrido en-orden
// --------------------------------------------------------------------------

// Árbol de la figura (img/5.3.4.svg):     40
//                                     28      70
//                                    9  32  52  10
// 1. Post-orden: 9 32 28 52 10 70 40
// 2. En-orden:   9 28 32 40 52 70 10
// 3. Algoritmo del recorrido en-orden:
Procedimiento EnOrden (p: puntero a Nodo) es
	Si p <> nil entonces
		EnOrden(*p.izq)
		Escribir(*p.dato)
		EnOrden(*p.der)
	FinSi
FinProcedimiento


// --------------------------------------------------------------------------
// Ejercicio 5.3.5
// Para las siguientes expresiones:
//
// ( 5 + 7 ) / 8 – ( 6 * 7 ) ** 2
// 3 – 6 + 6 * ( 8 / 3 )
// 4 / ( 8 – 6 * ( 8 + 3 ) )
//
// 1. Grafique el árbol equivalente
// 2. Indique las expresiones resultantes de los recorridos EN-ORDEN, PRE-
// ORDEN y POST-ORDEN
// 3. Calcule los resultados numéricos que arroja la ejecución de cada uno de
// los recorridos.
// --------------------------------------------------------------------------

// a) (5 + 7) / 8 – (6 * 7) ** 2
//                  -
//            /           **
//          +   8       *    2
//         5 7         6 7
//    EN-ORDEN:   5 + 7 / 8 - 6 * 7 ** 2
//    PRE-ORDEN:  - / + 5 7 8 ** * 6 7 2
//    POST-ORDEN: 5 7 + 8 / 6 7 * 2 ** -
//    Resultados: pre y post-orden respetan el árbol: 12/8 - 42**2 = 1,5 - 1764 = -1762,5.
//    El en-orden sin paréntesis se evalúa con la precedencia normal:
//    5 + 0,875 - 6*49 = -288,125 (no coincide: hacen falta los paréntesis).
//
// b) 3 – 6 + 6 * (8 / 3)
//                  +
//            -           *
//          3   6       6    /
//                          8 3
//    EN-ORDEN:   3 - 6 + 6 * 8 / 3
//    PRE-ORDEN:  + - 3 6 * 6 / 8 3
//    POST-ORDEN: 3 6 - 6 8 3 / * +
//    Resultados: -3 + 6 * 2,667 = 13 en los tres (acá el en-orden coincide).
//
// c) 4 / (8 – 6 * (8 + 3))
//              /
//          4       -
//               8      *
//                    6    +
//                        8 3
//    EN-ORDEN:   4 / 8 - 6 * 8 + 3
//    PRE-ORDEN:  / 4 - 8 * 6 + 8 3
//    POST-ORDEN: 4 8 6 8 3 + * - /
//    Resultados: pre y post-orden: 4 / (8 - 66) = 4 / -58 = -0,069.
//    En-orden sin paréntesis: 0,5 - 48 + 3 = -44,5.


// --------------------------------------------------------------------------
// Ejercicio 5.3.6
// Escriba un algoritmo que permita recorrer el siguiente árbol en los tres
// procedimientos, realice la prueba de escritorio
//
// (ver figura en la guía)
// --------------------------------------------------------------------------

// Árbol de la figura (img/5.3.6.svg):        F
//                                      C           I
//                                    A           G
//                                      B           H
Procedimiento PreOrden (p: puntero a Nodo) es
	Si p <> nil entonces
		Escribir(*p.dato)
		PreOrden(*p.izq)
		PreOrden(*p.der)
	FinSi
FinProcedimiento

Procedimiento EnOrden (p: puntero a Nodo) es
	Si p <> nil entonces
		EnOrden(*p.izq)
		Escribir(*p.dato)
		EnOrden(*p.der)
	FinSi
FinProcedimiento

Procedimiento PostOrden (p: puntero a Nodo) es
	Si p <> nil entonces
		PostOrden(*p.izq)
		PostOrden(*p.der)
		Escribir(*p.dato)
	FinSi
FinProcedimiento
// Prueba de escritorio:
//   Pre-orden:  F C A B I G H
//   En-orden:   A B C F G H I
//   Post-orden: B A C H G I F


// --------------------------------------------------------------------------
// Ejercicio 5.3.7
// Escribir una función recursiva que encuentre el número de nodos de un
// árbol binario.
// --------------------------------------------------------------------------

Función CantNodos (p: puntero a Nodo): entero es
	Si p = nil entonces
		CantNodos:= 0
	Sino
		CantNodos:= 1 + CantNodos(*p.izq) + CantNodos(*p.der)
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.3.8
// Escribir una función recursiva que encuentre la altura de un árbol
// binario.
// --------------------------------------------------------------------------

Función Altura (p: puntero a Nodo): entero es
	Ambiente
		ai, ad: entero
	Proceso
		Si p = nil entonces
			Altura:= 0
		Sino
			ai:= Altura(*p.izq)
			ad:= Altura(*p.der)
			Si ai > ad entonces
				Altura:= 1 + ai
			Sino
				Altura:= 1 + ad
			FinSi
		FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.3.9
// Se dispone de un árbol binario de enteros. Escribir funciones que
// calculen:
//
// 1. La suma de sus elementos.
// 2. La suma de sus elementos que son múltiplos de 3.
// --------------------------------------------------------------------------

Función Suma (p: puntero a Nodo): entero es
	Si p = nil entonces
		Suma:= 0
	Sino
		Suma:= *p.dato + Suma(*p.izq) + Suma(*p.der)
	FinSi
FinFunción

Función SumaMult3 (p: puntero a Nodo): entero es
	Si p = nil entonces
		SumaMult3:= 0
	Sino
		Si *p.dato mod 3 = 0 entonces
			SumaMult3:= *p.dato + SumaMult3(*p.izq) + SumaMult3(*p.der)
		Sino
			SumaMult3:= SumaMult3(*p.izq) + SumaMult3(*p.der)
		FinSi
	FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.3.10
// Suponiendo que un árbol está definido como la estructura recursiva de
// datos:
//
// arbol = registro
//     x: entero
//     izq, der: puntero a arbol
// fin registro
//
// Escribir un algoritmo que encuentre un elemento con una clave dada C, y
// realice una operación P con él.
// --------------------------------------------------------------------------

// Búsqueda en un árbol binario cualquiera (se recorren los dos subárboles).
// Si fuera un ABB alcanzaría con bajar por un solo lado según la clave.
Función Buscar (p: puntero a arbol; C: entero): puntero a arbol es
	Ambiente
		r: puntero a arbol
	Proceso
		Si (p = nil) o (*p.x = C) entonces
			Buscar:= p
		Sino
			r:= Buscar(*p.izq, C)
			Si r = nil entonces
				r:= Buscar(*p.der, C)
			FinSi
			Buscar:= r
		FinSi
FinFunción

// Uso: se busca la clave y, si está, se le aplica la operación P
//   q:= Buscar(raiz, C)
//   Si q <> nil entonces P(q) Sino Escribir("La clave no está") FinSi


// --------------------------------------------------------------------------
// Ejercicio 5.3.11
// Conviértase la expresión `((a + b) + c * (d + e) + f) * (g + h)` en
//
// 1. expresión prefija
// 2. expresión postfija
// --------------------------------------------------------------------------

// Árbol: la raíz es el último "*"; a la izquierda ((a + b) + c * (d + e)) + f
// (la suma es asociativa a izquierda) y a la derecha (g + h).
// 1. Prefija:  * + + + a b * c + d e f + g h
// 2. Postfija: a b + c d e + * + f + g h + *


// --------------------------------------------------------------------------
// Ejercicio 5.3.12
// El recorrido en pre-orden de un determinado árbol binario es:
// GEAIBMCLDFKJH y en-orden IABEGLDCFMKHJ.
//
// 1. Dibujar el árbol binario.
// 2. Dar el recorrido en post-orden.
// 3. Diseñar un algoritmo para recorrer el árbol en post-orden.
// --------------------------------------------------------------------------

// 1. La primera letra del pre-orden es la raíz (G); en el en-orden, lo que
//    está a su izquierda (IABE) es el subárbol izquierdo y lo demás el derecho.
//    Repitiendo eso en cada subárbol queda:
//
//                    G
//            E               M
//         A              C        K
//       I   B          L   F         J
//                        D          H
//
// 2. Post-orden: I B A E D L F C H J K M G
// 3. Algoritmo del recorrido post-orden:
Procedimiento PostOrden (p: puntero a Nodo) es
	Si p <> nil entonces
		PostOrden(*p.izq)
		PostOrden(*p.der)
		Escribir(*p.dato)
	FinSi
FinProcedimiento


// --------------------------------------------------------------------------
// Ejercicio 5.3.13
// Supongamos que tenemos una función valor tal que dado un valor de tipo
// char (una letra del alfabeto) devuelve un valor entero asociado a dicho
// identificador.
// Supongamos también la existencia de un árbol de expresión T cuyos nodos
// hoja son letras del alfabeto y cuyos nodos interiores son los caracteres
// *, +, -, /.
// Diseñar una función que tome como parámetros un nodo y un árbol binario y
// devuelva el resultado entero de la evaluación de la expresión
// representada.
// --------------------------------------------------------------------------

// La recursión reemplaza al ciclo: cada llamada resuelve un subárbol.
Función Evaluar (p: puntero a T): entero es
	Ambiente
		izquierda, derecha: entero
	Proceso
		Si (*p.izq = nil) y (*p.der = nil) entonces // hoja: una letra
			Evaluar:= Valor(*p.dato)
		Sino // operador con dos subárboles
			izquierda:= Evaluar(*p.izq)
			derecha:= Evaluar(*p.der)
			Según *p.dato hacer
				"+": Evaluar:= izquierda + derecha
				"-": Evaluar:= izquierda - derecha
				"*": Evaluar:= izquierda * derecha
				"/": Evaluar:= izquierda div derecha // resultado entero
			FinSegún
		FinSi
FinFunción


// --------------------------------------------------------------------------
// Ejercicio 5.3.14
// ¿Puede reconstruirse de forma única un ABB dado su inorden? ¿Y dados el
// preorden y el postorden?
// --------------------------------------------------------------------------

// - Solo con el inorden, no: el inorden de un ABB siempre es la lista de
//   claves ordenada, así que árboles con forma distinta dan el mismo inorden.
// - Con el preorden sí (y lo mismo con el postorden): como el inorden ya se
//   conoce (las claves ordenadas), con preorden + inorden el árbol queda
//   determinado. Equivale a insertar las claves en el ABB en el orden del
//   preorden. Por lo tanto, dados el preorden y el postorden, también.
// - En un árbol binario cualquiera (no ABB), preorden + postorden no alcanzan
//   si hay nodos con un solo hijo: no se sabe si es hijo izquierdo o derecho.


