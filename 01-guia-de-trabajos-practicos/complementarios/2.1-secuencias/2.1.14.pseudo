// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos - Complementarios 2.1: secuencias
//  Ejercicio 2.1.14
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 2.1.14
// Dada una secuencia de caracteres de entrada, desarrollar un algoritmo que
// produzca una secuencia de salida de caracteres; la que contendrá sólo los
// caracteres “numéricos” correspondientes a dígitos impares encontrados en
// la secuencia de entrada.
//
// Al final del proceso informar total de caracteres “numéricos” (dígitos) y
// porcentaje de pares e impares sobre el total de caracteres numéricos
// --------------------------------------------------------------------------

// Mismo ejercicio que el 2.1.1 de las secuencias extra
// (../../2-secuencias-y-archivos/2.1.1-extra.pseudo).
Acción Complementario2_1_14 es
Ambiente
    Sec, Salida: secuencia de caracteres
    v: caracter
    pares, impares: entero
Proceso
    ARR(Sec); AVZ(Sec, v)
    CREAR(Salida)
    pares:= 0; impares:= 0
    Mientras NFDS(Sec) hacer
        Si v en {"1", "3", "5", "7", "9"} entonces
            impares:= impares + 1
            ESC(Salida, v)
        Sino
            Si v en {"0", "2", "4", "6", "8"} entonces pares:= pares + 1 FinSi
        FinSi
        AVZ(Sec, v)
    FinMientras
    Escribir("Total de dígitos: ", pares + impares)
    Si pares + impares > 0 entonces
        Escribir("Pares: ", pares * 100 / (pares + impares), "% - Impares: ", impares * 100 / (pares + impares), "%")
    FinSi
    CERRAR(Sec); CERRAR(Salida)
FinAcción
