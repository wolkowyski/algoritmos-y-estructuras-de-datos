// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos - Complementarios 4: listas
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 4.1
// Dada la siguiente declaración y el siguiente esquema:
//
//   P, Q, R:  puntero a NODO
//     NODO: registro
//     DATO: entero
//     PROX: puntero a nodo
//   Fin registro
//
//    P↓              Q↓               R↓
//    _______        _______         _______
//   | 3 |   |----→ | 5 |   | ----→ | 9 |nil|
//    -------       ---------       --------
//
// | P | Q | R | Comentario |
// | --- | --- | --- | --- |
// |  |  |  |  |
// |  |  |  |  |
// |  |  |  |  |
//
// ¿Qué hacen las siguientes órdenes?
//
// Considerar que se ejecutan secuencialmente.
//
// 1.  P:= P↑. PROX
// 2.  Q:= P
// 3.  R:= P↑.PROX
// 4.  P↑.DATO:= Q↑. DATO
// 5.  P↑.DATO:= (Q↑.PROX)↑. DATO
// 6.  R↑.PROX:= P
// --------------------------------------------------------------------------

// Nodos: n1 (3) -> n2 (5) -> n3 (9) -> nil. Al principio P = n1, Q = n2, R = n3.
//
// | Orden                         | P  | Q  | R  | Comentario                                  |
// |-------------------------------|----|----|----|---------------------------------------------|
// | 1. P:= P↑.PROX                | n2 | n2 | n3 | P avanza al segundo nodo                    |
// | 2. Q:= P                      | n2 | n2 | n3 | Q ya apuntaba a n2: no cambia nada          |
// | 3. R:= P↑.PROX                | n2 | n2 | n3 | R ya apuntaba a n3: no cambia nada          |
// | 4. P↑.DATO:= Q↑.DATO          | n2 | n2 | n3 | P y Q son el mismo nodo: el dato sigue en 5 |
// | 5. P↑.DATO:= (Q↑.PROX)↑.DATO  | n2 | n2 | n3 | el dato de n2 pasa a ser 9 (el de n3)       |
// | 6. R↑.PROX:= P                | n2 | n2 | n3 | n3 apunta a n2: n2 y n3 forman un ciclo     |
//
// Al final: n2 (9) -> n3 (9) -> n2 ... (lista circular de dos nodos). El nodo
// n1 (3) sigue apuntando a n2 pero ningún puntero lo apunta a él: quedó
// inaccesible (memoria que ya no se puede liberar con Disponer).


// --------------------------------------------------------------------------
// Ejercicio 4.2
// Dada una lista simplemente encadenada de números enteros, diseñar un
// algoritmo que a partir de ella genere otra lista conteniendo los nodos
// cuyos datos sean múltiplos de 3, dichos elementos deberán ser eliminados
// de la lista original. Se asume que la lista está cargada y que el
// algoritmo recibe como parámetro de entrada la dirección del primer
// elemento.
// --------------------------------------------------------------------------

// Igual al 4.2 de la práctica (múltiplos de 10) con múltiplos de 3. Se
// mueven los mismos nodos, sin Nuevo ni Disponer.
Accion Complementario4_2 (Var prim: puntero a Nodo) es
Ambiente
	Nodo = Registro
		dato: entero
		prox: puntero a Nodo
	FinRegistro
	p, a, sig, prim2: puntero a Nodo
Proceso
	prim2:= nil
	a:= nil
	p:= prim
	Mientras p <> nil hacer
		sig:= *p.prox
		Si *p.dato mod 3 = 0 entonces
			Si a = nil entonces prim:= sig Sino *a.prox:= sig FinSi // lo saco
			*p.prox:= prim2 // carga apilada en la lista nueva
			prim2:= p
		Sino
			a:= p
		FinSi
		p:= sig
	FinMientras
FinAccion


// --------------------------------------------------------------------------
// Ejercicio 4.3
// Dada una lista doblemente encadenada que contiene datos de todas las
// provincias de la República Argentina: nombre, capital, cantidad total de
// habitantes y cantidad de analfabetos, y está ordenada alfabéticamente por
// nombre de provincia, se desea generar otra lista simplemente encadenada
// pero ordenada en orden decreciente por número de habitantes analfabetos.
// --------------------------------------------------------------------------

Accion Complementario4_3 (prim: puntero a NodoD) es
Ambiente
	Prov = Registro
		Nombre, Capital: AN(40)
		Habitantes, Analfabetos: N(9)
	FinRegistro
	NodoD = Registro
		dato: Prov
		ant, prox: puntero a NodoD
	FinRegistro
	NodoS = Registro
		dato: Prov
		prox: puntero a NodoS
	FinRegistro
	p: puntero a NodoD
	q, r, a, prim2: puntero a NodoS
Proceso
	prim2:= nil
	p:= prim
	Mientras p <> nil hacer // recorro la doble hacia adelante
		Nuevo(q)
		*q.dato:= *p.dato
		r:= prim2; a:= nil // inserción ordenada decreciente por analfabetos
		Mientras (r <> nil) y (*r.dato.Analfabetos > *q.dato.Analfabetos) hacer
			a:= r; r:= *r.prox
		FinMientras
		*q.prox:= r
		Si a = nil entonces prim2:= q Sino *a.prox:= q FinSi
		p:= *p.prox
	FinMientras
FinAccion


// --------------------------------------------------------------------------
// Ejercicio 4.4
// Dada una lista circular con los datos de los socios de un club: número,
// nombre y condición ( ´A´= alta, ´B´= baja); hacer un algoritmo que cree
// otra lista simplemente encadenada con los socios múltiplos de 100, que no
// estén dados de baja y eliminar de la lista original los socios dados de
// baja ( cond = ´B´).
// --------------------------------------------------------------------------

// Recorrido de una vuelta completa a la lista circular. Para borrar el
// primero hay que reenganchar el último con el nuevo primero.
Accion Complementario4_4 (Var prim: puntero a NodoC) es
Ambiente
	NodoC = Registro
		numero: N(6)
		nombre: AN(40)
		cond: ("A", "B")
		prox: puntero a NodoC
	FinRegistro
	NodoS = Registro
		numero: N(6)
		nombre: AN(40)
		prox: puntero a NodoS
	FinRegistro
	p, a, ult, sig: puntero a NodoC
	q, prim2, ult2: puntero a NodoS
	n, i: entero
Proceso
	prim2:= nil; ult2:= nil
	Si prim <> nil entonces
		n:= 1; ult:= prim // cuento los nodos y busco el último
		Mientras *ult.prox <> prim hacer ult:= *ult.prox; n:= n + 1 FinMientras
		a:= ult; p:= prim
		Para i:= 1 a n hacer // una vuelta
			sig:= *p.prox
			Si *p.cond = "B" entonces // baja: se elimina
				Si p = sig entonces // era el único nodo
					prim:= nil
				Sino
					*a.prox:= sig
					Si p = prim entonces prim:= sig FinSi
				FinSi
				Disponer(p)
			Sino
				Si *p.numero mod 100 = 0 entonces // carga encolada en la simple
					Nuevo(q)
					*q.numero:= *p.numero; *q.nombre:= *p.nombre; *q.prox:= nil
					Si prim2 = nil entonces prim2:= q Sino *ult2.prox:= q FinSi
					ult2:= q
				FinSi
				a:= p
			FinSi
			p:= sig
		FinPara
	FinSi
FinAccion


// --------------------------------------------------------------------------
// Ejercicio 4.5
// Una empresa FARMACÉUTICA, posee una lista simplemente enlazada de pedidos
// realizados por sus clientes en el último mes. Se desea generar dos grupos
// con la siguiente información:
//
// * Los pedidos de los clientes deudores.
// * Los pedidos de los clientes regulares.
//
// Para ello se cuenta con un archivo “CLIENTES” indexado por Nro_cliente.
//
// Deben tenerse en cuenta las siguientes consideraciones:
//
// * La lista de entrada está ordenada por Nro_cliente y pueden existir
// varios pedidos de un mismo cliente.
// * En el caso de recibir un pedido de un cliente que se encuentre dado de
// baja, debe ser dado de alta automáticamente.
// * El total (Monto $) de Dinero_deuda debe ser actualizado con la suma de
// los pedidos en Cuenta Corriente. Modificar la condición a Deudor si esa
// suma es mayor a cero.
//
// Formato lista de entrada
//
// * Nro_cliente* Nro pedido* Precio pedido* TipoPedido (C:Contado, R: Cuenta
// Corriente)
//
// Formato archivo “Clientes”
//
// * Nro_cliente* DNI* Domicilio* Dinero_deuda* Deudor (si/no)* Baja
//
// Formato lista salida
//
// * Nro_cliente* Total pedido
// --------------------------------------------------------------------------

// La lista está ordenada por cliente: corte de control por Nro_cliente sobre
// la lista. Por cada cliente se arma un nodo (Nro_cliente, total) en la lista
// de deudores o en la de regulares, según cómo quede después de actualizarlo.
Accion Complementario4_5 (prim: puntero a Pedido) es
Ambiente
	Pedido = Registro
		Nro_cliente: N(6)
		Nro_pedido: N(8)
		Precio: real
		Tipo: ("C", "R") // contado o cuenta corriente
		prox: puntero a Pedido
	FinRegistro
	Cliente = Registro
		Nro_cliente: N(6)
		DNI: N(8)
		Domicilio: AN(60)
		Dinero_deuda: real
		Deudor: ("si", "no")
		Baja: ("si", "no")
	FinRegistro
	Salida = Registro
		Nro_cliente: N(6)
		Total: real
		prox: puntero a Salida
	FinRegistro
	CLIENTES: Archivo de Cliente indexado por Nro_cliente
	RC: Cliente
	p: puntero a Pedido
	q, primDeud, primReg: puntero a Salida
	res: N(6)
	total, ctacte: real
Proceso
	Abrir E/S(CLIENTES)
	primDeud:= nil; primReg:= nil
	p:= prim
	Mientras p <> nil hacer
		res:= *p.Nro_cliente
		total:= 0; ctacte:= 0
		Mientras (p <> nil) y (*p.Nro_cliente = res) hacer
			total:= total + *p.Precio
			Si *p.Tipo = "R" entonces ctacte:= ctacte + *p.Precio FinSi
			p:= *p.prox
		FinMientras
		RC.Nro_cliente:= res
		Leer(CLIENTES, RC)
		Si EXISTE entonces
			Si RC.Baja = "si" entonces RC.Baja:= "no" FinSi // alta automática
			RC.Dinero_deuda:= RC.Dinero_deuda + ctacte
			Si RC.Dinero_deuda > 0 entonces RC.Deudor:= "si" FinSi
			Regrabar(CLIENTES, RC)
			Nuevo(q)
			*q.Nro_cliente:= res; *q.Total:= total
			Si RC.Deudor = "si" entonces
				*q.prox:= primDeud; primDeud:= q
			Sino
				*q.prox:= primReg; primReg:= q
			FinSi
		Sino
			Escribir("Error: el cliente ", res, " no está en el archivo")
		FinSi
	FinMientras
	Cerrar(CLIENTES)
FinAccion


// --------------------------------------------------------------------------
// Ejercicio 4.6
// Usando las operaciones de Lista, escribir un procedimiento AGRUPA (PRIM,
// ULT: puntero a nodo; A:entero) que, dada una lista doblemente encadenada
// de enteros L agrupe (sume) elementos de tal manera que en L queden sólo
// elementos mayores o iguales que A. El algoritmo recorre la lista y cuando
// encuentra un elemento menor empieza a agrupar (sumar) el elemento con los
// siguientes hasta llegar al valor A o hasta que se acabe la lista (el
// elemento menor se debe eliminar de la lista.)
//
// Por ejemplo si:
//
// L = {3,4,2,4,1,4,4,3,2,2,4,1,4,1,4,4,1,4,4,2},
//
// entonces AGRUPA(PRIM, ULT,10) da
//
// L = {13,12,13,10,10}.
//
// En la lista final NO deben quedar elementos menores que A, salvo,
// eventualmente, el último.
// --------------------------------------------------------------------------

// Cuando un elemento es menor que A, se le van sumando los siguientes (que
// se eliminan de la lista) hasta llegar a A o al final.
Procedimiento AGRUPA (Var PRIM, ULT: puntero a nodo; A: entero) es
	Ambiente
		p, s: puntero a nodo
	Proceso
		p:= PRIM
		Mientras p <> nil hacer
			Mientras (*p.dato < A) y (*p.prox <> nil) hacer
				s:= *p.prox // el siguiente se suma a p y se elimina
				*p.dato:= *p.dato + *s.dato
				*p.prox:= *s.prox
				Si *s.prox <> nil entonces
					*(*s.prox).ant:= p
				Sino
					ULT:= p
				FinSi
				Disponer(s)
			FinMientras
			p:= *p.prox
		FinMientras
FinProcedimiento
// Con L = {3,4,2,4,1,4,4,3,2,2,4,1,4,1,4,4,1,4,4,2} y A = 10:
// 3+4+2+4 = 13 | 1+4+4+3 = 12 | 2+2+4+1+4 = 13 | 1+4+4+1 = 10 | 4+4+2 = 10


// --------------------------------------------------------------------------
// Ejercicio 4.7
// La empresa "Remises Yapú S.A." necesita solucionar el problema de
// asignación de vehículos para sus clientes. La empresa posee 105 autos, y
// maneja dos colas (estructuras FIFO) una llamada "No Asignados" y otra
// llamada "Asignados".
// En la primera se encuentran todos los autos que no han sido asignados a
// algún cliente en lo que va del día y en la segunda los autos que ya han
// sido asignados. La idea de la cola “Asignados” es manejar en forma
// equitativa la asignación de turnos, es decir que cada vehículo tenga igual
// oportunidad de obtener un cliente.
// Los vehículos se asignan de la siguiente forma:
//
// * Si existen autos “No Asignados”, se toma uno de ellos y se lo mueve a la
// cola de “Asignados”.
// * Si no existen autos “No Asignados”, se toma uno de la cola de
// “Asignados” , y se lo coloca al final de la cola.
//
// Siempre que se asigna un vehículo se debe incrementar en uno un campo
// “cantidad_de_clientes", a fin de saber cuantos clientes tuvo.
// Por final de proceso se requiere saber la cantidad total de clientes de
// ese día.
// Se pide: Confeccionar una subacción que realice la asignación de vehículos
// y el mantenimiento de las colas, usando listas.
// --------------------------------------------------------------------------

// Las dos colas son listas con frente y fondo. Se asume que al empezar el día
// los 105 autos están en "No Asignados".
Accion Complementario4_7 es
Ambiente
	Auto = Registro
		nro_auto: N(3)
		cantidad_de_clientes: N(4)
		prox: puntero a Auto
	FinRegistro
	frenteNA, fondoNA, frenteA, fondoA, p: puntero a Auto
	total_clientes: entero
	op: ("S", "N")

	Procedimiento Encolar (Var frente, fondo: puntero a Auto; x: puntero a Auto) es
		*x.prox:= nil
		Si frente = nil entonces frente:= x Sino *fondo.prox:= x FinSi
		fondo:= x
	FinProcedimiento

	Procedimiento Desencolar (Var frente, fondo: puntero a Auto; Var x: puntero a Auto) es
		x:= frente
		frente:= *frente.prox
		Si frente = nil entonces fondo:= nil FinSi
	FinProcedimiento

	Procedimiento AsignarVehiculo es
		Si frenteNA <> nil entonces
			Desencolar(frenteNA, fondoNA, p) // un auto que todavía no salió hoy
		Sino
			Desencolar(frenteA, fondoA, p) // el que hace más que no tiene cliente
		FinSi
		*p.cantidad_de_clientes:= *p.cantidad_de_clientes + 1
		total_clientes:= total_clientes + 1
		Encolar(frenteA, fondoA, p) // queda al final de Asignados
		Escribir("Auto asignado: ", *p.nro_auto)
	FinProcedimiento

Proceso
	frenteA:= nil; fondoA:= nil
	total_clientes:= 0
	// (la cola No Asignados ya está cargada con los 105 autos)
	Escribir("¿Hay un cliente? S/N")
	Leer(op)
	Mientras op = "S" hacer
		AsignarVehiculo
		Escribir("¿Otro cliente? S/N")
		Leer(op)
	FinMientras
	Escribir("Total de clientes del día: ", total_clientes)
FinAccion


// --------------------------------------------------------------------------
// Ejercicio 4.8
// Se dispone de una lista doblemente enlazada con un conjunto de números
// naturales. Este conjunto está dividido en 10 grupos. En cada grupo el
// primer elemento indica la cantidad de números subsiguientes a él que
// integran dicho grupo.
// Se desea generar una nueva lista circular, simplemente encadenada, en la
// cual cada nodo contendrá el valor máximo de cada grupo. Dicha lista debe
// quedar ordenada en forma ascendente y, al final se debe informar cuál es
// el promedio de todos los máximos.
// --------------------------------------------------------------------------

Accion Complementario4_8 (prim: puntero a NodoD) es
Ambiente
	NodoD = Registro
		dato: entero
		ant, prox: puntero a NodoD
	FinRegistro
	NodoC = Registro
		max: entero
		prox: puntero a NodoC
	FinRegistro
	p: puntero a NodoD
	q, r, a, primC, ultC: puntero a NodoC
	g, i, cant, maximo, suma: entero
Proceso
	primC:= nil; ultC:= nil
	suma:= 0
	p:= prim
	Para g:= 1 a 10 hacer
		cant:= *p.dato // el primero del grupo indica cuántos siguen
		p:= *p.prox
		maximo:= *p.dato
		Para i:= 1 a cant hacer
			Si *p.dato > maximo entonces maximo:= *p.dato FinSi
			p:= *p.prox
		FinPara
		suma:= suma + maximo
		// inserción ordenada ascendente en la lista circular
		Nuevo(q); *q.max:= maximo
		Si primC = nil entonces
			*q.prox:= q; primC:= q; ultC:= q
		Sino
			Si maximo <= *primC.max entonces // nuevo primero
				*q.prox:= primC; *ultC.prox:= q; primC:= q
			Sino
				a:= primC; r:= *primC.prox
				Mientras (r <> primC) y (*r.max < maximo) hacer
					a:= r; r:= *r.prox
				FinMientras
				*q.prox:= r; *a.prox:= q
				Si r = primC entonces ultC:= q FinSi // quedó último
			FinSi
		FinSi
	FinPara
	Escribir("Promedio de los máximos: ", suma / 10)
FinAccion


// --------------------------------------------------------------------------
// Ejercicio 4.9
// El ciclo de desarrollo de software tradicional, incremental e iterativo
// cuenta con las siguientes etapas: Captura de Requisitos, Análisis, Diseño,
// Desarrollo, Implementación y Prueba.
// De la última etapa se obtiene un informe que contiene las modificaciones
// que deben realizarse al software para que cumpla con las funcionalidades
// para las cuales fue creado inicialmente.
//
// Suponga que cuenta con una lista de proyectos de software de los cuales se
// tiene la siguiente información:
//
// * Proy AN(20)* Resp AN(30)* Fch_Ini Fecha* C_Error N(3)
//
// El dato Cant_Errores indica la cantidad de errores que deben solucionarse
// en cada proyecto.
//
// La información respecto a cada Error se almacena en una lista de acuerdo
// al orden de los proyectos y teniendo en cuenta la cantidad que le
// corresponden a éste. Por ejemplo si en la Lista 1 el Proyecto A tiene 3
// errores, los 3 primeros nodos de la Lista 2 corresponden al Proyecto A. La
// información que se almacena por Error es la siguiente:
//
// * Desc_E AN(30)* Est AN(1)
//
// Est – M: En Modificación | O: En Observación | R: Resuelto
//
// Durante el proceso de Control de Proyectos se analiza cada error de cada
// proyecto, y se le consulta al Responsable el estado del Error (en caso que
// no haya sido Resuelto) para actualizarlo.
// El Responsable debe tener la opción de recorrer todos los proyectos, en el
// orden almacenados, las veces que considere necesario, luego de analizar el
// último en la lista.
//
// Suponiendo que se necesita simular el control de los proyectos, creando
// dos listas para almacenar por un lado Proyectos y por otro Errores. Y que
// además se debe informar al final del proceso qué cantidad de proyectos
// pasaron el control con todos sus errores resueltos. Se le solicita a ud:
//
// 1. Dado el Algoritmo resuelto pero incompleto, analice la propuesta
// presentada e indique las sentencias incorrectas, encerrándolas con un
// círculo, e indique las modificaciones necesarias para que funcione,
// complete la líneas de puntos y agregue las acciones que falten.
// 2. Desarrolle la acción Control_Proyectos y complete el ambiente si fuera
// necesario
//
//   Accion Ej_1  (PRIM: Puntero a Nodo, PRIM2: Puntero a Nodo2) Es
//      Ambiente
//       NODO = Registro
//        Proy: N(30)
//        Resp: AN(30)
//        Fecha: Fecha
//        C_error: N(3)
//        Prox: Puntero a Nodo
//       FinRegistro
//       NODO1 = Registro
//        Desc_E: AN(30)
//        Est: AN(1)
//        Prox: Puntero
//       FinRegistro
//       P, K: Puntero a Nodo
//       Q : Puntero a Nodo1
//       Cont, cant_proy: N(3)
//       Opc: caracter
//
//       Subaccion Cargar_Proyectos es
//         Escribir(“Ingrese ‘S’ para empezar o cualquier otro caracter para salir“)
//         Leer(opc)
//         Mientras opc = ‘S’ hacer          …………………
//           Leer(*P.Proy, *P.Resp, *P.Fch_Ini, *P.C)
//
//           Si ……………… Entonces
//                      P := *P.prox;
//                       PRIM:=P;
//           Sino
//                      K := PRIM
//                      Mientras (*K.prox <> PRIM) hacer
//                         K := *K.prox
//                      FinMientras
//                      *K.prox := P
//                      *P.prox := PRIM
//           Fsi;
//         Cont:= 0
//          Cargar_Errores
//          Escribir(“Ingrese ‘S’ para seguir cargando proyectos o cualquier
//           otro caracter para salir”)
//           Leer(opc)
//         Fin Mientras
//       Fin Subaccion
//
//     Subacción Cargar_Errores es
//       Mientras Cont <= *P.C_error hacer
//            NUEVO(Q)
//            Escribir(*Q.Desc_E, *P.Est)
//            Si PRIM2 = NIL Entonces
//                      *Q.prox := Nil
//
//                      ……… := Q
//             Sino
//                      *Q.prox := PRIM2
//                      PRIM2 := Q
//              FinSi
//
//              …………………………………
//       Fin Mientras
//     FinSubaccion
//
//   Algoritmo
//      Cargar_Proyectos;
//      Control_Proyectos;
//      Escribir(‘La cantidad de proyectos con errores resueltos es de’, *P.C_error)
//   Fin Accion
// --------------------------------------------------------------------------

// 1. Sentencias incorrectas del algoritmo dado y su corrección:
//   - NODO.Proy está como N(30) y es AN(20); el campo es Fch_Ini (no Fecha).
//   - NODO1.Prox: "Puntero" sin tipo -> Puntero a Nodo1; el parámetro PRIM2
//     es Puntero a Nodo2 (no existe): debe ser Puntero a Nodo1.
//   - Cargar_Proyectos: antes de leer falta Nuevo(P); se lee *P.C (el campo
//     es C_error); la condición que falta es "PRIM = nil", y en ese caso no
//     se hace P:= *P.prox sino *P.prox:= P (lista circular de un nodo) y PRIM:= P.
//   - Cargar_Errores: "Cont <= C_error" con Cont en 0 carga un error de más
//     (debe ser Cont < C_error); "Escribir" debe ser Leer(*Q.Desc_E, *Q.Est)
//     (no *P.Est); la carga apilada invierte el orden de los errores: tienen
//     que quedar en el orden de los proyectos -> carga encolada con un puntero
//     al último (Ult2); la línea que falta es Cont:= Cont + 1.
//   - En el algoritmo se informa *P.C_error en lugar del contador cant_proy.
//
// 2. Versión corregida, con Control_Proyectos:
Accion Ej_1 (PRIM: Puntero a Nodo; PRIM2: Puntero a Nodo1) Es
Ambiente
	Fecha = Registro
		aa: N(4); mm: 1..12; dd: 1..31
	FinRegistro
	NODO = Registro // lista circular de proyectos
		Proy: AN(20)
		Resp: AN(30)
		Fch_Ini: Fecha
		C_error: N(3)
		Prox: Puntero a Nodo
	FinRegistro
	NODO1 = Registro // errores, en el mismo orden que los proyectos
		Desc_E: AN(30)
		Est: AN(1) // M, O o R
		Prox: Puntero a Nodo1
	FinRegistro
	P, K: Puntero a Nodo
	Q, Ult2: Puntero a Nodo1
	Cont, cant_proy: N(3)
	Opc: caracter
	todos_resueltos: booleano

	Subaccion Cargar_Errores es
		Cont:= 0
		Mientras Cont < *P.C_error hacer
			Nuevo(Q)
			Leer(*Q.Desc_E, *Q.Est)
			*Q.Prox:= nil
			Si PRIM2 = nil entonces PRIM2:= Q Sino *Ult2.Prox:= Q FinSi
			Ult2:= Q
			Cont:= Cont + 1
		FinMientras
	FinSubaccion

	Subaccion Cargar_Proyectos es
		PRIM:= nil; PRIM2:= nil
		Escribir("Ingrese 'S' para empezar o cualquier otro caracter para salir")
		Leer(Opc)
		Mientras Opc = "S" hacer
			Nuevo(P)
			Leer(*P.Proy, *P.Resp, *P.Fch_Ini, *P.C_error)
			Si PRIM = nil entonces
				*P.Prox:= P
				PRIM:= P
			Sino
				K:= PRIM
				Mientras *K.Prox <> PRIM hacer K:= *K.Prox FinMientras
				*K.Prox:= P
				*P.Prox:= PRIM
			FinSi
			Cargar_Errores
			Escribir("Ingrese 'S' para seguir cargando proyectos o cualquier otro caracter para salir")
			Leer(Opc)
		FinMientras
	FinSubaccion

	// Recorre los proyectos en orden (la lista es circular: después del último
	// vuelve al primero) mientras el responsable quiera seguir.
	Subaccion Control_Proyectos es
		Si PRIM <> nil entonces
			Repetir
				P:= PRIM
				Q:= PRIM2
				cant_proy:= 0
				Repetir // una pasada por todos los proyectos
					todos_resueltos:= Verdadero
					Para Cont:= 1 a *P.C_error hacer
						Si *Q.Est <> "R" entonces
							Escribir(*P.Proy, " - ", *Q.Desc_E, ": estado actual ", *Q.Est, ". Nuevo estado (M/O/R)")
							Leer(*Q.Est)
						FinSi
						Si *Q.Est <> "R" entonces todos_resueltos:= Falso FinSi
						Q:= *Q.Prox
					FinPara
					Si todos_resueltos entonces cant_proy:= cant_proy + 1 FinSi
					P:= *P.Prox
				Hasta que P = PRIM
				Escribir("¿Recorrer de nuevo los proyectos? S/N")
				Leer(Opc)
			Hasta que Opc <> "S"
		FinSi
	FinSubaccion

Algoritmo
	Cargar_Proyectos
	Control_Proyectos
	Escribir("La cantidad de proyectos con errores resueltos es de ", cant_proy)
Fin Accion
