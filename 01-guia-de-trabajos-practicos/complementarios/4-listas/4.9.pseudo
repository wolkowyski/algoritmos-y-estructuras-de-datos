// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos - Complementarios 4: listas
//  Ejercicio 4.9
// ==========================================================================

// --------------------------------------------------------------------------
// Ejercicio 4.9
// El ciclo de desarrollo de software tradicional, incremental e iterativo
// cuenta con las siguientes etapas: Captura de Requisitos, Análisis, Diseño,
// Desarrollo, Implementación y Prueba.
// De la última etapa se obtiene un informe que contiene las modificaciones
// que deben realizarse al software para que cumpla con las funcionalidades
// para las cuales fue creado inicialmente.
//
// Suponga que cuenta con una lista de proyectos de software de los cuales se
// tiene la siguiente información:
//
// * Proy AN(20)* Resp AN(30)* Fch_Ini Fecha* C_Error N(3)
//
// El dato Cant_Errores indica la cantidad de errores que deben solucionarse
// en cada proyecto.
//
// La información respecto a cada Error se almacena en una lista de acuerdo
// al orden de los proyectos y teniendo en cuenta la cantidad que le
// corresponden a éste. Por ejemplo si en la Lista 1 el Proyecto A tiene 3
// errores, los 3 primeros nodos de la Lista 2 corresponden al Proyecto A. La
// información que se almacena por Error es la siguiente:
//
// * Desc_E AN(30)* Est AN(1)
//
// Est – M: En Modificación | O: En Observación | R: Resuelto
//
// Durante el proceso de Control de Proyectos se analiza cada error de cada
// proyecto, y se le consulta al Responsable el estado del Error (en caso que
// no haya sido Resuelto) para actualizarlo.
// El Responsable debe tener la opción de recorrer todos los proyectos, en el
// orden almacenados, las veces que considere necesario, luego de analizar el
// último en la lista.
//
// Suponiendo que se necesita simular el control de los proyectos, creando
// dos listas para almacenar por un lado Proyectos y por otro Errores. Y que
// además se debe informar al final del proceso qué cantidad de proyectos
// pasaron el control con todos sus errores resueltos. Se le solicita a ud:
//
// 1. Dado el Algoritmo resuelto pero incompleto, analice la propuesta
// presentada e indique las sentencias incorrectas, encerrándolas con un
// círculo, e indique las modificaciones necesarias para que funcione,
// complete la líneas de puntos y agregue las acciones que falten.
// 2. Desarrolle la acción Control_Proyectos y complete el ambiente si fuera
// necesario
//
//   Accion Ej_1  (PRIM: Puntero a Nodo, PRIM2: Puntero a Nodo2) Es
//      Ambiente
//       NODO = Registro
//        Proy: N(30)
//        Resp: AN(30)
//        Fecha: Fecha
//        C_error: N(3)
//        Prox: Puntero a Nodo
//       FinRegistro
//       NODO1 = Registro
//        Desc_E: AN(30)
//        Est: AN(1)
//        Prox: Puntero
//       FinRegistro
//       P, K: Puntero a Nodo
//       Q : Puntero a Nodo1
//       Cont, cant_proy: N(3)
//       Opc: caracter
//
//       Subaccion Cargar_Proyectos es
//         Escribir(“Ingrese ‘S’ para empezar o cualquier otro caracter para salir“)
//         Leer(opc)
//         Mientras opc = ‘S’ hacer          …………………
//           Leer(*P.Proy, *P.Resp, *P.Fch_Ini, *P.C)
//
//           Si ……………… Entonces
//                      P := *P.prox;
//                       PRIM:=P;
//           Sino
//                      K := PRIM
//                      Mientras (*K.prox <> PRIM) hacer
//                         K := *K.prox
//                      FinMientras
//                      *K.prox := P
//                      *P.prox := PRIM
//           Fsi;
//         Cont:= 0
//          Cargar_Errores
//          Escribir(“Ingrese ‘S’ para seguir cargando proyectos o cualquier
//           otro caracter para salir”)
//           Leer(opc)
//         Fin Mientras
//       Fin Subaccion
//
//     Subacción Cargar_Errores es
//       Mientras Cont <= *P.C_error hacer
//            NUEVO(Q)
//            Escribir(*Q.Desc_E, *P.Est)
//            Si PRIM2 = NIL Entonces
//                      *Q.prox := Nil
//
//                      ……… := Q
//             Sino
//                      *Q.prox := PRIM2
//                      PRIM2 := Q
//              FinSi
//
//              …………………………………
//       Fin Mientras
//     FinSubaccion
//
//   Algoritmo
//      Cargar_Proyectos;
//      Control_Proyectos;
//      Escribir(‘La cantidad de proyectos con errores resueltos es de’, *P.C_error)
//   Fin Accion
// --------------------------------------------------------------------------

// 1. Sentencias incorrectas del algoritmo dado y su corrección:
//   - NODO.Proy está como N(30) y es AN(20); el campo es Fch_Ini (no Fecha).
//   - NODO1.Prox: "Puntero" sin tipo -> Puntero a Nodo1; el parámetro PRIM2
//     es Puntero a Nodo2 (no existe): debe ser Puntero a Nodo1.
//   - Cargar_Proyectos: antes de leer falta Nuevo(P); se lee *P.C (el campo
//     es C_error); la condición que falta es "PRIM = nil", y en ese caso no
//     se hace P:= *P.prox sino *P.prox:= P (lista circular de un nodo) y PRIM:= P.
//   - Cargar_Errores: "Cont <= C_error" con Cont en 0 carga un error de más
//     (debe ser Cont < C_error); "Escribir" debe ser Leer(*Q.Desc_E, *Q.Est)
//     (no *P.Est); la carga apilada invierte el orden de los errores: tienen
//     que quedar en el orden de los proyectos -> carga encolada con un puntero
//     al último (Ult2); la línea que falta es Cont:= Cont + 1.
//   - En el algoritmo se informa *P.C_error en lugar del contador cant_proy.
//
// 2. Versión corregida, con Control_Proyectos:
Accion Ej_1 (PRIM: Puntero a Nodo; PRIM2: Puntero a Nodo1) Es
Ambiente
	Fecha = Registro
		aa: N(4); mm: 1..12; dd: 1..31
	FinRegistro
	NODO = Registro // lista circular de proyectos
		Proy: AN(20)
		Resp: AN(30)
		Fch_Ini: Fecha
		C_error: N(3)
		Prox: Puntero a Nodo
	FinRegistro
	NODO1 = Registro // errores, en el mismo orden que los proyectos
		Desc_E: AN(30)
		Est: AN(1) // M, O o R
		Prox: Puntero a Nodo1
	FinRegistro
	P, K: Puntero a Nodo
	Q, Ult2: Puntero a Nodo1
	Cont, cant_proy: N(3)
	Opc: caracter
	todos_resueltos: booleano

	Subaccion Cargar_Errores es
		Cont:= 0
		Mientras Cont < *P.C_error hacer
			Nuevo(Q)
			Leer(*Q.Desc_E, *Q.Est)
			*Q.Prox:= nil
			Si PRIM2 = nil entonces PRIM2:= Q Sino *Ult2.Prox:= Q FinSi
			Ult2:= Q
			Cont:= Cont + 1
		FinMientras
	FinSubaccion

	Subaccion Cargar_Proyectos es
		PRIM:= nil; PRIM2:= nil
		Escribir("Ingrese 'S' para empezar o cualquier otro caracter para salir")
		Leer(Opc)
		Mientras Opc = "S" hacer
			Nuevo(P)
			Leer(*P.Proy, *P.Resp, *P.Fch_Ini, *P.C_error)
			Si PRIM = nil entonces
				*P.Prox:= P
				PRIM:= P
			Sino
				K:= PRIM
				Mientras *K.Prox <> PRIM hacer K:= *K.Prox FinMientras
				*K.Prox:= P
				*P.Prox:= PRIM
			FinSi
			Cargar_Errores
			Escribir("Ingrese 'S' para seguir cargando proyectos o cualquier otro caracter para salir")
			Leer(Opc)
		FinMientras
	FinSubaccion

	// Recorre los proyectos en orden (la lista es circular: después del último
	// vuelve al primero) mientras el responsable quiera seguir.
	Subaccion Control_Proyectos es
		Si PRIM <> nil entonces
			Repetir
				P:= PRIM
				Q:= PRIM2
				cant_proy:= 0
				Repetir // una pasada por todos los proyectos
					todos_resueltos:= Verdadero
					Para Cont:= 1 a *P.C_error hacer
						Si *Q.Est <> "R" entonces
							Escribir(*P.Proy, " - ", *Q.Desc_E, ": estado actual ", *Q.Est, ". Nuevo estado (M/O/R)")
							Leer(*Q.Est)
						FinSi
						Si *Q.Est <> "R" entonces todos_resueltos:= Falso FinSi
						Q:= *Q.Prox
					FinPara
					Si todos_resueltos entonces cant_proy:= cant_proy + 1 FinSi
					P:= *P.Prox
				Hasta que P = PRIM
				Escribir("¿Recorrer de nuevo los proyectos? S/N")
				Leer(Opc)
			Hasta que Opc <> "S"
		FinSi
	FinSubaccion

Algoritmo
	Cargar_Proyectos
	Control_Proyectos
	Escribir("La cantidad de proyectos con errores resueltos es de ", cant_proy)
Fin Accion
