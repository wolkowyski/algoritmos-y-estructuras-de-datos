// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de Trabajos Prácticos X - Ejercicio tipo parcial: actualización de terrenos
// ==========================================================================


// --------------------------------------------------------------------------
// Ejercicio 1
// La Municipalidad de Resistencia desea actualizar los valores de los
// terrenos luego de una rezonificación de los mismos.
// El valor final de cada terreno se calcula de la siguiente manera
//
// Valor del Terreno = Superficie terreno (en M2) * valor del M2 *
// coeficiente de incremento
//
// Para ello cuenta con la siguiente información:
//
// 1. Un archivo maestro de los terrenos con los siguientes datos:
//
//    MAESTRO Ordenado por Nro_Terreno
//    * Nro_Terreno* Zona* Ubicacion* Superficie* Valor
//
//    Zona: codificadas de A a F
//    Ubicación: codificada de 1 a 10
// 2. Un arreglo V que contiene los valores del M2 por zona.
// 3. Un archivo de movimientos
//
//    MOVIMIENTO Ordenado por Nro_Terreno
//    * Nro_Terreno* Zona* Ubicacion* Superficie* Cod_Mov
//
// Se solicita actualizar (Alta Baja y Modificacion) los valores del archivo
// maestro, teniendo en cuenta que los unicos valores que se pueden
// actualizar es la zona y su valor.
// --------------------------------------------------------------------------

// Actualización secuencial (alta, baja y modificación) del maestro de
// terrenos. El coeficiente de incremento no está en ningún archivo: se asume
// un arreglo C con un coeficiente por ubicación, igual que V por zona.
// Cod_Mov: "A" alta, "B" baja, "M" modificación de la zona.
Accion EjercicioX_1 (V: arreglo ["A".."F"] de real; C: arreglo [1..10] de real) es
Ambiente
	Terreno = Registro
		Nro_Terreno: N(8)
		Zona: "A".."F"
		Ubicacion: 1..10
		Superficie: real
		Valor: real
	FinRegistro
	Movimiento = Registro
		Nro_Terreno: N(8)
		Zona: "A".."F"
		Ubicacion: 1..10
		Superficie: real
		Cod_Mov: ("A", "B", "M")
	FinRegistro
	MAESTRO, MAESTRO_NUEVO: Archivo de Terreno ordenado por Nro_Terreno
	MOVIMIENTO: Archivo de Movimiento ordenado por Nro_Terreno
	RT, RS: Terreno
	RM: Movimiento
	HV = 99999999

	Procedimiento LeerMae es
		Leer(MAESTRO, RT)
		Si FDA(MAESTRO) entonces RT.Nro_Terreno:= HV FinSi
	FinProcedimiento

	Procedimiento LeerMov es
		Leer(MOVIMIENTO, RM)
		Si FDA(MOVIMIENTO) entonces RM.Nro_Terreno:= HV FinSi
	FinProcedimiento

	Función Valor (t: Terreno): real es
		Valor:= t.Superficie * V[t.Zona] * C[t.Ubicacion]
	FinFunción

Proceso
	Abrir E/(MAESTRO); LeerMae
	Abrir E/(MOVIMIENTO); LeerMov
	Abrir /S(MAESTRO_NUEVO)
	Mientras (RT.Nro_Terreno <> HV) o (RM.Nro_Terreno <> HV) hacer
		Si RT.Nro_Terreno < RM.Nro_Terreno entonces
			Escribir(MAESTRO_NUEVO, RT)
			LeerMae
		Sino
			Si RT.Nro_Terreno = RM.Nro_Terreno entonces
				Según RM.Cod_Mov hacer
					"A": Escribir("Error: alta de un terreno que ya existe")
					     Escribir(MAESTRO_NUEVO, RT)
					"B": // baja: no se graba
					"M": RT.Zona:= RM.Zona // solo se actualiza la zona y su valor
					     RT.Valor:= Valor(RT)
					     Escribir(MAESTRO_NUEVO, RT)
				FinSegún
				LeerMae
				LeerMov
			Sino
				Si RM.Cod_Mov = "A" entonces
					RS.Nro_Terreno:= RM.Nro_Terreno
					RS.Zona:= RM.Zona
					RS.Ubicacion:= RM.Ubicacion
					RS.Superficie:= RM.Superficie
					RS.Valor:= Valor(RS)
					Escribir(MAESTRO_NUEVO, RS)
				Sino
					Escribir("Error: baja o modificación de un terreno inexistente")
				FinSi
				LeerMov
			FinSi
		FinSi
	FinMientras
	Cerrar(MAESTRO); Cerrar(MOVIMIENTO); Cerrar(MAESTRO_NUEVO)
Fin Acción
