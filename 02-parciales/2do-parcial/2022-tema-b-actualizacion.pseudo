// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  2do Parcial 2022 - Tema B - Ejercicio 1 (actualización secuencial)
//
//  Álbum de figuritas (maestro, ordenado por CodFig) y solicitudes de
//  intercambio con amigos (movimientos, ordenado por CodFig y CodAmig).
//  - Si la figurita ya está y admite duplicadas, se suma una por solicitud.
//  - Si no está, se agrega (cantidad 1) solo si la solicitud tiene como
//    máximo 7 días.
//  Al final se informa cuántas duplicadas se admitieron.
//  Enunciado: enunciados/2022-tema-b.jpg
// ==========================================================================

Accion Figuritas_Ejer_1 ES

Ambiente

	Fecha=Registro
		AA: 2000...2100
		MM: 1...12
		DD: 1...31
	Fin Registro

	Album=Registro
		CodFig: N(5)
		Cantidad: N(2)
		PerDup: ("si","no")
	Fin Registro

	NewMae,Arch_A: Archivo secuencial de Album ordenado por CodFig
	reg_A,reg_S,aux: Album

	Intercambio=Registro
		CodFig: N(5)
		CodAmig: N(5)
		FechSol: Fecha
	Fin Registro

	Arch_I: Archivo secuencial de Intercambio ordenado por CodFig y CodAmig
	reg_I: Intercambio

	HV = 99999 // mayor que cualquier CodFig
	cont_dup: entero

	// diff_dias(n, f): función de la cátedra; verdadero si entre la fecha f y
	// hoy pasaron como máximo n días

	Procedimiento Leer_Album() ES
		Leer(Arch_A,reg_A)
		Si FDA(Arch_A) entonces // se pregunta por el archivo, no por el registro
			reg_A.CodFig:= HV
		Fin Si
	Fin Procedimiento

	Procedimiento Leer_Inter() ES
		Leer(Arch_I,reg_I)
		Si FDA(Arch_I) entonces
			reg_I.CodFig:= HV
		Fin Si
	Fin Procedimiento

Proceso
	Abrir E/(Arch_A)
	Leer_Album()
	Abrir E/(Arch_I)
	Leer_Inter()
	Abrir /S(NewMae)

	cont_dup:= 0

	Mientras (reg_A.CodFig <> HV) o (reg_I.CodFig <> HV) hacer

		Si (reg_A.CodFig < reg_I.CodFig) entonces // figurita sin solicitudes: se copia
			reg_S:= reg_A
			Grabar(NewMae,reg_S)
			Leer_Album()
		SiNo
			Si (reg_A.CodFig = reg_I.CodFig) entonces // figurita que ya tengo
				aux:= reg_A // parto del registro del álbum

				Si (reg_A.PerDup = "si") entonces
					Mientras (aux.CodFig = reg_I.CodFig) hacer // una por cada solicitud
						aux.Cantidad:= aux.Cantidad + 1
						cont_dup:= cont_dup + 1
						Leer_Inter()
					Fin Mientras
				SiNo
					Mientras (aux.CodFig = reg_I.CodFig) hacer // no admite: descarto las solicitudes
						Leer_Inter()
					Fin Mientras
				Fin Si

				reg_S:= aux
				Grabar(NewMae,reg_S)
				Leer_Album()
			SiNo // figurita nueva (no está en el álbum)
				aux.CodFig:= reg_I.CodFig

				Si diff_dias(7,reg_I.FechSol) entonces
					aux.Cantidad:= 1
					aux.PerDup:= "no"
					reg_S:= aux
					Grabar(NewMae,reg_S)
				Fin Si

				Mientras (aux.CodFig = reg_I.CodFig) hacer // las demás solicitudes de la misma figurita se descartan
					Leer_Inter()
				Fin Mientras
			Fin Si
		Fin Si
	Fin Mientras

	Esc("La cantidad de figuritas duplicadas que se admitieron fue: ",cont_dup)

	Cerrar(Arch_A)
	Cerrar(Arch_I)
	Cerrar(NewMae)
Fin Accion
