// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  2do Parcial 2022 - Tema B - Ejercicio 2 (arreglos + indexado)
//
//  Archivo de álbumes de 10 usuarios ordenado por CodUser, con la cantidad
//  de figuritas por tipo de álbum (Dorado, Común, Virtual). Se arma una
//  matriz de 11 x 4 (fila 11 y columna 4 de totales), se informa el usuario
//  que más figuritas coleccionó (nombre desde el indexado de amigos) y el
//  porcentaje de figuritas de cada usuario sobre el total.
//  Enunciado: enunciados/2022-tema-b.jpg
// ==========================================================================

Accion Figuritas_Ejer_2 ES

Ambiente

	Album=Registro
		CodUser: N(5)
		CodFig: N(5)
		Cantidad: N(2)
		Tipo: ("D","C","V")
	Fin Registro

	Arch_Al: Archivo secuencial de Album ordenado por CodUser
	regAl: Album

	Amigos=Registro
		CodUser: N(5)
		Apellido: AN(30)
		Nombre: AN(30)
		Celular: N(10)
	Fin Registro

	Arch_AM: Archivo de Amigos indexado por CodUser
	regAM: Amigos

	Matriz: arreglo [1...11,1...4] de entero

	i,j: entero

	res_CodUser,mayor_cantidad: entero
	res_apellido,res_nombre: alfanumerico

	// Se ejecuta cuando cambia el usuario: la fila i ya tiene sus totales
	Procedimiento Corte_User() ES
		Si (Matriz[i,4] > mayor_cantidad) entonces
			regAM.CodUser:= res_CodUser // el usuario que terminó, no el del registro actual
			Leer(Arch_AM,regAM)
			Si (existe) entonces
				res_apellido:= regAM.Apellido
				res_nombre:= regAM.Nombre
				mayor_cantidad:= Matriz[i,4]
			Fin Si
		Fin Si

		i:= i + 1 // el próximo usuario va en la fila siguiente
		res_CodUser:= regAl.CodUser
	Fin Procedimiento

Proceso
	Abrir E/(Arch_Al)
	Leer(Arch_Al,regAl)
	Abrir E/(Arch_AM)

	Para i:=1 hasta 11 hacer
		Para j:=1 hasta 4 hacer // el ciclo interno recorre las columnas (j)
			Matriz[i,j]:= 0
		Fin Para
	Fin Para

	res_CodUser:= regAl.CodUser
	i:= 1
	mayor_cantidad:= 0

	Mientras NFDA(Arch_Al) hacer
		Si (res_CodUser <> regAl.CodUser) entonces
			Corte_User()
		Fin Si

		Segun (regAl.Tipo) hacer
			"D": j:=1
			"C": j:=2
			"V": j:=3
		Fin Segun

		Matriz[i,j]:= Matriz[i,j] + regAl.Cantidad
		Matriz[i,4]:= Matriz[i,4] + regAl.Cantidad
		Matriz[11,j]:= Matriz[11,j] + regAl.Cantidad
		Matriz[11,4]:= Matriz[11,4] + regAl.Cantidad

		Leer(Arch_Al,regAl)
	Fin Mientras

	Corte_User() // el último usuario

	Cerrar(Arch_Al)
	Cerrar(Arch_AM)

	Esc("Usuario	Album Dorado	Album Comun		Album Virtual		Total x Usuario")
	Para i:=1 hasta 11 hacer
		Si (i < 11) entonces
			Esc(i)
		SiNo
			Esc("Total x Album")
		Fin Si

		Para j:=1 hasta 4 hacer
			Esc(Matriz[i,j])
		Fin Para
	Fin Para

	Esc("El usuario que más figuritas coleccionó fue: ",res_nombre," ",res_apellido)
	Para i:=1 hasta 10 hacer
		// porcentaje sobre el total general (fila 11, columna 4)
		Esc("Usuario ",i,"; porcentaje de figuritas: ", Matriz[i,4] * 100 / Matriz[11,4])
	Fin Para
Fin Accion
