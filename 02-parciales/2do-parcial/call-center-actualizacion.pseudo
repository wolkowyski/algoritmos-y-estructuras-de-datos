// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  2do Parcial - Modelo "Call Center" - Ejercicio 1 (actualización indexada)
//
//  Los reclamos (secuencial, ordenado por Región y código) actualizan el
//  reporte de cada región (indexado por Región): cantidad de reclamos por
//  urgencia y fecha del último reclamo. Después se recorre el reporte y se
//  pide auditoría en las regiones con más del doble de urgencias altas que
//  bajas, siempre que la región tenga menos de 10 auditorías (arreglo H).
//  Enunciado: enunciados/call-center.pdf
// ==========================================================================

Accion CallCenter_Act (H: arreglo [1...20] de entero) ES

Ambiente

	Fecha=Registro
		AA: 1900...2100
		MM: 1...12
		DD: 1...31
	Fin Registro

	Reclamos=Registro
		Region: N(2)
		CodRecl: N(10)
		FecRecl: Fecha
		MailCliente: AN(20)
		Urgencia: AN(1)
		Detalle: AN(100)
	Fin Registro

	Arch_1: Archivo secuencial de Reclamos ordenado por Region y CodRecl
	reg_1: Reclamos

	Reporte=Registro
		Region: N(2)
		UltFecRec: Fecha
		UrgAlt: N(6)
		UrgMed: N(6)
		UrgBaj: N(6)
		NueAud: ("si","no")
	Fin Registro

	Arch_2: Archivo de Reporte indexado por Region
	reg_2: Reporte

	i,cont_aud: entero
	res_region: N(2)

Proceso
	Abrir E/(Arch_1)
	Leer(Arch_1,reg_1)
	Abrir E/S(Arch_2)

	cont_aud:= 0

	// Parte 1: actualizo el reporte de cada región (una lectura directa por región)
	Mientras NFDA(Arch_1) hacer
		res_region:= reg_1.Region
		reg_2.Region:= reg_1.Region
		Leer(Arch_2,reg_2)
		Si (existe) entonces
			Mientras NFDA(Arch_1) y (reg_1.Region = res_region) hacer // todos los reclamos de la región
				Segun (reg_1.Urgencia) hacer
					"A": reg_2.UrgAlt:= reg_2.UrgAlt + 1
					"M": reg_2.UrgMed:= reg_2.UrgMed + 1
					"B": reg_2.UrgBaj:= reg_2.UrgBaj + 1
				Fin Segun
				reg_2.UltFecRec:= reg_1.FecRecl
				Leer(Arch_1,reg_1)
			Fin Mientras
			Regrabar(Arch_2,reg_2)
		SiNo
			Esc("Error! Región ",reg_1.Region," no está en el archivo")
			Mientras NFDA(Arch_1) y (reg_1.Region = res_region) hacer // salteo sus reclamos
				Leer(Arch_1,reg_1)
			Fin Mientras
		Fin Si
		// No hace falta otro Leer acá: el ciclo interno ya dejó leído el próximo
	Fin Mientras

	Cerrar(Arch_1)

	// Parte 2: recorro el indexado en forma secuencial
	Leer(Arch_2,reg_2)
	Mientras NFDA(Arch_2) hacer
		i:= reg_2.Region

		Si (H[i] < 10) y ((reg_2.UrgBaj * 2) < reg_2.UrgAlt) entonces
			Esc("Se requiere auditoría en la región: ",i)
			H[i]:= H[i] + 1
			reg_2.NueAud:= "si"
			cont_aud:= cont_aud + 1
		SiNo
			Esc("No se requiere auditoría en la región ",i)
			reg_2.NueAud:= "no"
		Fin Si
		Regrabar(Arch_2,reg_2)

		Leer(Arch_2,reg_2)
	Fin Mientras

	Esc("Se solicitaron ",cont_aud," auditorías en total")
	Cerrar(Arch_2)
Fin Accion
