// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  3er Parcial 2022 - Recuperatorio - Ejercicio 1 (Mundial: recursividad + listas)
//
//  Lista de los 32 países del Mundial. Se ingresa el grupo de cada país, se
//  calcula con una función recursiva el promedio de edad de sus jugadores
//  (informar el equipo más joven y el más grande) y al final se ordena la
//  lista por grupo.
//  Enunciado: ../enunciados/2022-recuperatorio.jpg
// ==========================================================================

Accion Recuperatorio_2022_Ejer1 (Prim: puntero a Nodo) ES

Ambiente

	Nodo=Registro
		pais: AN(20)
		edad_jugadores: arreglo[1...26] de enteros
		grupo: caracter
		puntos: N(2)
		T_amarillas: N(2)
		T_rojas: N(2)
		prox: puntero a Nodo
	Fin Registro

	P,A,Q,sig,Prim_Ord: puntero a Nodo

	i: entero
	menor_prom_edad,mayor_prom_edad,aux_promedio: entero
	equip_menor_edad,equip_mayor_edad,aux_pais: alfanumerico
	aux_grupo: caracter

	Funcion Promedio(Arr: arreglo[1...26] de enteros, j: entero): entero ES

		Si (j = 26) entonces

			Promedio:= Arr[j] div 26
		SiNo
			Promedio:= (Arr[j] div 26) + Promedio(Arr,j + 1)
		Fin Si
	Fin Funcion

Proceso
	menor_prom_edad:= 99 // ninguna edad promedio llega a 99
	mayor_prom_edad:= 0

	Para (i:= 1 hasta 32) hacer
		Esc("Ingrese el pais del equipo. A continuacion, ingrese el grupo al que pertenece")
		Leer(aux_pais)
		Leer(aux_grupo)

		P:= Prim
		Mientras (P <> nil) y (*P.pais <> aux_pais) hacer
			A:= P
			P:= *P.prox
		Fin Mientras

		Si (P = nil) entonces
			Esc("ERROR!! Pais no encontrado")
		SiNo
			*P.grupo:= aux_grupo
			aux_promedio:= Promedio(*P.edad_jugadores,1) // el arreglo del nodo actual

			Si (aux_promedio < menor_prom_edad) entonces
				menor_prom_edad:= aux_promedio
				equip_menor_edad:= *P.pais
			Fin Si

			Si (aux_promedio > mayor_prom_edad) entonces
				mayor_prom_edad:= aux_promedio
				equip_mayor_edad:= *P.pais
			Fin Si
		Fin Si
	Fin Para

	// ORDENAR POR GRUPO
	// Voy sacando cada nodo de la lista original e insertándolo en orden en
	// una lista nueva (Prim_Ord). No se crean nodos: se mueven los mismos.
	Prim_Ord:= nil
	Q:= Prim
	Mientras (Q <> nil) hacer
		sig:= *Q.prox // guardo el siguiente antes de mover Q

		P:= Prim_Ord
		A:= nil
		Mientras (P <> nil) y (*P.grupo <= *Q.grupo) hacer
			A:= P
			P:= *P.prox
		Fin Mientras

		*Q.prox:= P
		Si (A = nil) entonces
			Prim_Ord:= Q
		SiNo
			*A.prox:= Q
		Fin Si

		Q:= sig
	Fin Mientras
	Prim:= Prim_Ord

	Esc("El equipo con mayor edad promedio es: ",equip_mayor_edad)
	Esc("El equipo con menor edad promedio es: ",equip_menor_edad)
Fin Accion
