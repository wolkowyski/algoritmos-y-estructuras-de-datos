Procedimiento EliminacionDobles(prim, ult, p: puntero a nodo)es
    Si (prim = nil) entonces
        Escribir("Error, lista vacia")
    SiNo
    p:= prim
    p:= ult
    Mientras (p <> nil) y (*p.dato <> k) hacer
        p:= *p.dato
    FinMientras

    Si (prim = ult) entonces
        prim:= nil
        ult:= nil
    SiNo
