Procedimiento Insercion es
    Nuevo(q) //creamos nuevo nodo a insertar
    Si (prim = nil) entonces //lista vacia
        prim:= q
        *q.prox:= nil
    SiNo
        ant:= nil
        p:= *p.prox
        Mientras (p <> nil) y (*p.dato < *q.dato) hacer
            ant:= p
            p:= *p.prox
        FinMientras

        Si (p == prim) entonces
            prim:= q
            *q.prox:= p
        SiNo
            *ant.prox:= q
            *q.prox:= p
        FinSi
    FinSi
FinProcedimiento

