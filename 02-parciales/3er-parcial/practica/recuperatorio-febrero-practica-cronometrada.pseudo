Procedimiento Insercion es
    Nuevo(q)
    Si (prim = nil) entonces //lista vacia
        prim:= q
        *q.prox:= nil
    SiNo
        p:= prim
        ant:= nil
        Mientras (p <> nil) y (*p.dato < *q.dato) hacer
            ant:= p
            p:= *p.prox
        FinMientras

        Si ( p = prim) entonces
            prim:= q
            *q.prox:= p
        SiNo
            *ant.prox:= q
            *q.prox:= p
        FinSi
    FinSi
FinProcedimiento

Procedimiento Eliminacion es
    Mientras (p <> nil) y (*p.dato <> k) hacer
        ant:= p
        p:= *p.prox
    FinMientras

    Si (p = nil entonces)
        Escribir("Error, lista vacia")
    SiNo
        Si ( p = prim ) entonces
            prim:= *p.prox
        SiNo
            *ant.prox:= *p.prox
        FinSi
        Disponer(p)
    FinSi
FinProcedimiento

