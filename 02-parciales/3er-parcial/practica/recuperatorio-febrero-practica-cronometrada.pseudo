Procedimiento EliminacionSimples(prim, p, ant: puntero a nodo)es
    ant:= nil
    p:= prim
    Leer(k)

    Si (prim = nil) entonces
        Escribir("Error, lista vacia")
    SiNo
        Mientras (p <> nil) y (*p.datp <> k) hacer
            ant:= nil
            p:= *p.dato
        FinMientras

        Si (p = prim) entonces
            prim:= *p.prox
        SiNo
            *ant.prox:= *p.prox
        FinSi
        Disponer(p)
    FinSi
FinProcedimiento



