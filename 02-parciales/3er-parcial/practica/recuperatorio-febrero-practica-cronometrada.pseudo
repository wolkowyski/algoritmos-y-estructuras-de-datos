Procedimiento InsercioDoble(prim, ult, p, q: puntero a nodo): es
    Nuevo(q)
    Si (prim = nil) entonces
        prim:= q
        ult:= q
        *q.prox:= nil
        *q.ant:= nil
    SiNo
        p:= prim
        p:= ult
        Mientras (p <> nil) y (*p.dato < *q.dato) hacer
            p:= *p.prox
        FinMientras

        Si (p = prim) entonces
            prim:= q
            *q.prox:= p
            *q.ant:= nil
            *p.ant:= q
        SiNo
            Si (p =  nil) entonces
                *q.prox:= nil
                *q.ant:= ult
                ult:= q
                *ult.ant:= q
            SiNo
                *q.prox:= p
                *q.ant:= *p.ant
                *p.ant:= q
                *(*p.ant).prox:= q
            FinSi
        FinSi
    FinSi
FinProcedimiento

