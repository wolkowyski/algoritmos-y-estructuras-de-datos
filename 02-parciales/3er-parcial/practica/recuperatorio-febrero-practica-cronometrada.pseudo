def InsercionDobles(prim, ult, p, q: puntero a nodo);
    Nuevo(q)
    if (prim = nil)
        prim:= q
        ult:= q
        *q.prox:= nil
        *q.ant:= nil
    else
        p:= prim
        p:= ult
        while (p <> nil) and (*p.dato < *q.dato) do
            p:= *p.prox
        end

        Si (p = prim) entonces
            prim:= q
            *q.prox:= p
            *q.ant:= nil
            *p.ant:= q
        SiNo
            Si (p = nil) entonces
                *q.prox:= nil
                *q.ant:= ult
                ult:= q
                *ult.prox:= q
            SiNo
                *q.prox:= p
                *q.ant:= *p.ant
                *p.ant:= q
                *(*p.ant).prox:= q
            FinSi
        FinSi
    FinSi
FinProcedimiento

