Accion Ejercicio2 es
    Ambiente
        Reg = Registro
            ID: N(6)
            p_Acceso: (1..4)
            Prioridad: (1..6)
            Estado: ("EXITOSO", "FALLIDO")
        FinRegistro

        Arch: archivo de Reg secuencial

        Estadistico: Arreglo [1..5, 1..7] de entero

        menor: entero
        mayor: entero

    Proceso
        Abrir E/(Arch)

        cont_exitoso:= 0
        cont_fallido:= 0

        Para i:= 1 a 5 hacer
            Para j:= 1 a 7 hacer
                Estadistico[i,j]:= 0
            FinPara
        FinPara

        Leer(Arch, Reg)
        Mientras NFDA(Arch) hacer
            cont_total := cont_total + 1

            Si (Reg.Estado) = "EXITOSO" entonces // cont de exitosos para el punto E
                cont_exitoso:= cont_exitoso + 1
            FinSi

            // Sumamos a la celda específica (Cruce de Punto de Acceso y Prioridad)
            Estadistico[Reg.p_Acceso, Reg.Prioridad] := Estadistico[Reg.p_Acceso, Reg.Prioridad] + 1

            // TOTAL DE FILA: Acumulamos en la columna 7 (Total por Punto de Acceso)
            Estadistico[Reg.p_Acceso, 7] := Estadistico[Reg.p_Acceso, 7] + 1

            // TOTAL DE COLUMNA: Acumulamos en la fila 5 (Total por Prioridad)
            Estadistico[5, Reg.Prioridad] := Estadistico[5, Reg.Prioridad] + 1

            // TOTAL GENERAL: Acumulamos en la esquina [5, 7]
            Estadistico[5, 7] := Estadistico[5, 7] + 1

            Leer(Arch, Reg)
        FinMientras


        // Consigna B
        menor := Estadistico[1, 1]
        punto_acc_min := 1
        prioridad_min := 1

        Para i := 1 hasta 4 hacer
            Para j := 1 hasta 6 hacer
                Si Estadistico[i, j] < menor entonces
                    menor := Estadistico[i, j]
                    punto_acc_min := i
                    prioridad_min := j
                FinSi
            FinPara
        FinPara

        Escribir("Menor volumen: Punto ", punto_min, " y Prioridad ", prioridad_min)


        // Consigna C
        mayor_trafico := Estadistico[5, 1]
        prioridad_max := 1

        Para j := 2 hasta 6 hacer
            Si Estadistico[5, j] > mayor_trafico entonces
                mayor_trafico := Estadistico[5, j]
                prioridad_max := j
            FinSi
        FinPara

        Escribir("La prioridad con mayor demanda es la: ", prioridad_max)

FinAccion















