Algoritmo Final ES
Ambiente

critcar: caracter;
critdigito,critdigitt:N
res_ID: N;
res_firma: AN;
datos_textuales_an: AN;
res_num: N;
res_dec,res_uni: N;


aux: secuencia de caracter;
aux_car: caracter;

prim, P, Q : puntero a nodo;
bandera : logico;

nodo : registro
    firma: AN (7);
    ID: AN(7);
    criticidad:(1);
    datos_textuales:AN;
    tot_car:N
    cant_error:N;
    prox: puntro a trata
fin_registro


procedimiento ListaVacia es
    prim := Q;
    *q.prox := nil;
fin_procedimiento

procedimiento UNSOLOELEMENTO es
    *prim.prox := Q;
    *Q.prox := nil;
fin_procedimiento

procedimiento INSERCIÓN_AL_FIAL es
    *P.prox := Q;
    *Q.prox := nil;

procedimiento INSERCION_AL_MEDIO es
    *Q.prox := *P.prox;
    *P.prox := Q;
fin_procedimiento

sec: secuencia de caracter;
v: caracter;


función pasonum (caracter: caracter): numérico
    segun caracter hacer
        "0"  : pasonum := 0;
        "1"  : pasonum := 1;
        "2"  : pasonum := 2;
        "3"  : pasonum := 3;
        "4"  : pasonum := 4;
        "5"  : pasonum := 5;
        "6"  : pasonum := 6;
        "7"  : pasonum := 7;
        "8"  : pasonum := 8;
        "9"  : pasonum := 9;
    fin_segun
fin_funcion

funcion pascar (numero:numerico): caracter
    segun numero hacer
        0  : pasonum := "0";
        1  : pasonum := "1";
        2  : pasonum := "2";
        3  : pasonum := "3";
        4  : pasonum := "4";
        5  : pasonum := "5";
        6  : pasonum := "6";
        7  : pasonum := "7";
        8  : pasonum := "8";
        9  : pasonum := "9";
    fin_segun
fin_funcion



funcion concatenar(var:AN,caracter:caracter):AN;
    AN := AN ++ caracter;
fin_funcion

procedimiento inciciar es
ARR(sec);AVZ(sec,v);
prim := nil; P := prim
CREAR_SEC(aux);
fin_procedimiento

PROCESO
    INICIAR;
    Mientras NFDS sec hacer
    NUEVO(Q);
    res_ID := ""
    para i := 6 hasta 1 hacer
        res_ID := res_ID pasonum(v) * 10 ** i-1 ;
        AVZ(sec,v);
    fin_para
    res_firma := "";
    para i := 1 hasta 7 hacer
        res_firma := concatenar(res_firma,v);
        AVZ(sec,v)
    fin_para
    critcar := v;
    critdigito := pasonum(v);
    AVZ(sec,v);
    datos_textuales := "";
        AVZ(sec,v);
    Mientras v <> "+" o "-" hacer
        aux_car := v;
        ESCRIBIR(aux,aux_car);
        AVZ(sec,v);
    fin_mientras
    CERRAR(aux);
    ARR(aux); AVZ(aux,aux_car);
    *Q.tot_car := 0;
    *Q.cant_error := 0;
    Si v = "+" entonces
        Mientras NFDS aux hacer
            *Q.tot_car := tot_car + 1;
            Si aux_car <> ["0".."9"] y aux_car = ["a".."z"] entonces
                segun aux_car hacer
                    "a" : aux_car := "o";datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                    "e" : aux_car := "u";datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                    "i" : aux_car := "a";datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                    "o" : aux_car := "e";datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                    "u" : aux_car := "i";datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                    otro caso
                        aux_car := ASCII(aux_car);datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                fin_segun
            sino
                Si aux_car = ["0".."9"] entonces
                    datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                sino
                *Q.cant_error := *Q.cant_error + 1;
            AVZ(sec,aux_car);
        fin_mientras;
        CERRAR(aux);
        CREAR_SEC(aux);
    sino
        Mientras NFDS aux hacer
            *Q.tot_car := tot_car + 1;
            Si aux_car <> ["a".."z"] y aux_car = ["0".."0"] entonces
                res_num := pasonum(aux_car);
                Si res_num MOD 2 <> 0 entonces
                    res_num := res_num ** 3;
                sino
                    res_num := res_num * 2;
                fin_si
                si res_num >= 10 entonces
                    res_dec := res_num DIV 10;
                    res_uni := res_num - res_dec
                    res_dec := pascar(res_dec);
                    res_uni := pascar(res_uni);
                    datos_textuales_an := concatenar(datos_textuales_an,res_dec);
                    datos_textuales_an := concatenar(datos_textuales_an,res_uni);
                fin_si
            sino
                Si aux_car = ["a".."z"] entonces
                    datos_textuales_an := concatenar(datos_textuales_an,aux_car);
                sino
                *Q.cant_error := *Q.cant_error + 1;
            AVZ(sec,aux_car);
        fin_mientras;
        CERRAR(aux);
        CREAR_SEC(aux);
    fin_si
    *Q.ID := res_ID;
    *Q.critdigito := pasonum(critcar);
    *Q.datos_textuales := datos_textuales_an;
    P := prim;
    Si prim = nil entonces
    ListaVacia;
    sino
    Mientras (P.prox <> nil) y *Q.criticidad < *P.criticidad hacer
        P := *P.prox;
    fin_mientras
    Mientras *Q.ID < *P.ID hacer
        P := *P.prox;
    fin_mientras
    si p = prim entonces
    UNSOLOELEMENTO;
    sino
    Si *P.prox = nil entonces
    INSERCIÓN_AL_FIAL;
    sino
    INSERCION_AL_MEDIO;
fin_mientras

P := prim;
Mientras P <> nil hacer
    ESC("El elemento",*P.ID "con nivel de criticidad" *P.criticidad "contiene los datos textuales" *P.datos_textuales "Ha contado con un prcentaje de error del:" *P.cant_error // *P.tot_car ** 100 "%");
fin_mientras

fin_accion

















ACCION FINAL PARTE 2 ES
Ambiente

resi,resj,res:N

reg_arch = registro
    ID_TERMINAL: N(6);
    Punto_Acceso : N(1..4);
    Prioridad : N(1..6);
    Estado: ("EXITOSO", "FALLIDO");
fin_registro

arch_mae: archivo de reg_arch

matriz: arreglo de [1..5,1..7] de entero;

tot_fallado: N
prcoeso

ABRIR E/ (arch_mae);

para i := 0 hasta 4 hacer
    para j := 0 hasta 6 hacer
        matriz[i,j] := 0;
    fin_para;
fin_para;

tot_fallado := 0;

LEER(arch_mae,reg_arch);

Mientras NFDA arch_mae hacer
    Si reg_arch.Estado = "FALLIDO" entonces
        tot_fallado := := tot_fallado + 1
    fin_si
    A[reg_arch.Punto_Acceso, reg_arch.Prioridad] := A[reg_arch.Punto_Acceso,reg_arch.Prioridad] + 1;
    // o sino asi :3 SI HAGO EL ARREGLO DE 1..5 y no 0..4
    A[reg_arch.Punto_Acceso + 1, reg_arch.Prioridad + 1] := A[reg_arch.Punto_Acceso + 1,reg_arch.Prioridad + 1] + 1;
    LEER(arch_mae,reg_arch);
fin_mientras

para j := 1 hasta 6 hacer // fila total extra
    para i := 1 hasta 4 hacer
        A[0,i] := A[j] + A[i,j];
    fin_para
fin_para

para j := 1 hasta 4 hacer // columna total extra
    para i := 1 hasta 6 hacer
        A[i,0] := A[i] + A[i,j];
    fin_para
fin_para

para i := 1 hasa 4 hacer // total general de la esquina
    A[0,0] := A[0,0] + A[i,0]
fin_para

para j := 1 hasa 6 hacer
    A[0,0] := A[0,0] + A[0,j]
fin_para

resi := 1;
resj:= 1;
res := A[1,1];

// resguardo para el mayor por 2 criterios
para i := 1 hasta 4 hacer
    para j := 1 hasta 6 hacer
    si res > A[i,j] entonces
        res := A[i,j];
        resi := i;
        resj:= j;
    fin_si
    fin_para
fin_para

ESC("El menor fue la combiación Punto_Acceso:" resi "prioridad" resj "con u total de " res "solicitudes" );

res := A[0,1];

// resguardo para prioridad independiente del tipo
para j := 1 hasta 6 hacer
    si A[0,j] > res entonces // algoritmo de busqueda teorico de mayor o menor
        res := A[0,j];
        resj := j;
    fin_si
fin_para

ESC("el nivel de prioridad que más trafico registró fue" resj "con un total de" res "consultas");

ESC("El porcentaje de consultas exitosas fue de" A[0,0] DIV A[0,0]+tot_fallado * 100);
Fin_accion











Accion Final_Abril_Ejercio2 es // CONTROL DE SANIDAD - BROMATOLOGIA DE LA MUNINCIPALIDAD

    Ambiente

        Reg = Registro
            Mes_de_Visita: N(2)
            NroEmp: N(6)
            RazSoc: AN(15)
            Categoria: 1..3
            Habilitado: ("SI", "NO")
            Capacidad: N(3)
        FinRegistro

        Control: Archivo de Reg ordenado por Mes_de_Visita y NroEmp

        Estadistico: Arreglo[1..13, 1..4] de entero

    Proceso
        Abrir E/(Control)

        Para i:= 1 a 13, 1 hacer // incilaizo
            Para j:= 1 a 4, 1 hacer
                Estadistico[i,j]:= 0
            FinPara
        FinPara

        Leer(Control, Reg)
        Mientras NFDA(Control) hacer

            SI (Reg.Habilitado) = "SI" entonces
                Estadistico[Reg.Mes_de_Visita, Reg.Categoria]:= Estadistico[Reg.Mes_de_Visita, Reg.Categoria] + 1 // consigna a + estadistico

                Estadistico[13, Reg.Categoria]:= Estadistico[13, Reg.Categoria] + 1 // totales por mes

                Estadistico[Reg.Mes_de_Visita, 4]:= Estadistico[Reg.Mes_de_Visita, 4] + 1 // totales por categorias

                Estadistico[13, 4]:= Estadistico[13, 4] + 1 // total general

            SiNo // sino no esta habilitando

                cont_no_habilitados:= cont_no_habilitados + 1 // cuento como no habilitados para la consinga d
                Si (Reg.Capacidad) < 100 entonces // consigna b - si o si, da igual si esta habilitado o no, por eso va a parte como otro condicional
                    cont_capacidad:= cont_capacidad + 1
                FinSi
            FinSi
            total:= total + 1
            Leer(Control, Reg)
        FinMientras

        menor_mes:= HV // high value
        menor_categoria:= HV

        posicion_menor_mes:= 0
        posicion_menor_categoria:= 0

        Para i:= 1 a 12, 1 hacer
            Escribir("La cantidad de restaurantes habilitados para el mes numero: ", i, " es: ", Estadistico[i, 4]) // informo la primer parte de la consigna a
            Si menor_mes > Estadistico[i, 4] entonces
                menor_mes:= Estadistico[i, 4]
                posicion_menor_mes:= i
            FinSi
        FinPara

        Para j:= 1 a 3, 1 hacer
            Escribir("La cantidad de restaurantes habilitados para la categoria: ", j, " es: ", Estadistico[13, j]) // informo la segunda parte de la consigna a
            Si menor_categoria > Estadistico[13, j] entonces // busco el menor de las
                menor_categoria:= Estadistico[13, j]
            posicion_menor_categoria:= j
            FinSi
        FinPara

        Escribir("Fin del listado")

FinAccion




















Una empresa de energía eléctrica registra las mediciones mensuales de consumo de sus clientes.
Se dispone de un archivo secuencial ordenado por:
Zona (1..5) , Número_Cliente (N(5))

Cada registro contiene:
Zona (1..5)
Número_Cliente (N(5))
Tipo_Cliente ("R" Residencial / "C" Comercial)
Consumo_kwh (N(6))
Pagó ("S" / "N")

Se pide desarrollar un algoritmo que:
Informe el consumo total por zona.
Informe el consumo total por tipo de cliente (R / C).
Determine qué zona tuvo mayor consumo total.
Calcule el porcentaje de clientes que NO pagaron sobre el total de clientes.
Informe el número de cliente con mayor consumo.

⚠ Considerar corte de control por Zona.


Accion CorteControl es
    Ambiente
        Sechep = Registro
            Zona: (1..5)
            Número_Cliente: N(5)
            Tipo_Cliente: ("R", "C")
            Consumo_kwh: N(6)
            Pagó: ("S", "N")
        FinRegistro

        Sec: Archivo de Sechep secuencial ordenado por Zona y Numero_Cliente
        Reg: Registro de Sechep

        Procedimiento Corte_Zona es
            Escribir("Para la Zona: ", Res_Zona " hay un total de: ", Tot_Zona)
            // acumulo al totalizador pero como es un corte no hago nada
            Tot_Zona:= 0 // inicializo totalizador
            Res_Zona:= Reg.Zona // actualizo resguardo de la zona
        FinProcedimiento

    Proceso
        Abrir E/(Sec)
        Leer(Sec, Reg)
        Mientras NFDA(Sec) hacer
            Si

            Leer(Sec, Reg)
        FinMientras
FinAccion




Funcion Escape(c: entero): entero es
    c:= Random()

    Si c = 3 entonces
        Escape :=  7
    SiNo
        Si c = 1 entonces
            Escape := 3 + Escape()
        SiNo
            Si c = 2 entonces
                Escape := 5 + Escape()
            FinSi
        FinSi
    FinSi
FinFuncion


Accion Ejercicio1 es
    Ambiente
        Cliente = Registro
            Codigo: N(6)
            Precio: N(8, 2)
            Descripcion: AF(255)
        FinRegistro

        NodoCliente = Registro
            N_Carrito: N(3)
            Cant_Articulos: N(3)
            F_Pago: ["E", "TD", "TC"]
            prox: puntero a NodoCliente
        FinRegistro
        prim, p, ant, puntero a NodoCliente

        Funcion ObtenerSIguienteArticulo(n: entero): entero es
        FinFuncion

        Procedimiento AtenderCliente es
            Si prim = nil entonces
                Escribir("Error, cola vacia :p")
            SiNo
                p:= prim
                // proceso los datos

                prim := prim^.prox

                Si prim = nil entonces
                    ant := nil // Si la cola quedó vacía, el puntero del final también va a nil
                FinSi
                Disponer(p)
            FinSi
        FinProcedimiento

        Procedimiento AgregarCliente es
            Nuevo(q) // carga encolada
            Escribir("Ingrese Numero de Carrito")
            Leer(q^.N_Carrito)
            Escribir("Ingrese cantidad de articulos")
            Leer(q^.Cant_Articulos)
            Escribir("Ingrese Forma de Pago")
            Leer(q^.F_Pago)

            q^.prox:= nil

            Si prim = nil entonces
                prim := q
            Sino
                ant^.prox:= q
            FinSi
            ant:= q
        FinProcedimiento

    Proceso
        tot_efectivo:= 0
        tot_TD:= 0
        tot_TC:= 0
        Abrir E/ (Arch)
        prim:= nil

        Escribir("Ingrese la opcion a realizar")
        Escribir("1- Agregar cliente a la cola    2- Atender cliente        3- Salir")
        Leer(opcion)
        Mientras (opcion) <> 0 hacer
            Segun (opcion) hacer
                = 1: AgregarCliente
                = 2: AtenderCliente
            FinSegun
            Escribir("Ingrese la opcion a realizar")
            Escribir("1- Agregar cliente a la cola    2- Atender cliente        3- Salir")
            Leer(opcion)
        FinMientras






Accion Ejercicio1 es
    Ambiente

    Proceso
        Arrancar(Sec)
        Avanzar(Sec, c)

        Mientras NFDS(Sec) hacer
            cont_persona:= cont_persona + 1
            Mientras (c) <> "$" hacer // cada $ simboliza una cuenta, o sea una persona
                Mientras (c) <> "&" hacer // cada & simboliza un mensaje
                    Si (c) = "<" entonces
                        cont_mensaje_ilicito:= cont_mensaje_ilicito + 1
                        Mientras (c) <> ">" hacer
                            frase_ilicita:= frase_ilicita ++ (c)
                            Avanzar(Sec, c)
                        FinMientras
                    FinSi
                    Avanzar(Sec, c)
                FinMientras
                cont_mensaje:= cont_mensaje + 1
            FinMientras
        FinMientras














Accion RepasoEstadistico es

Arr1: Arreglo [1..12, 1..13, 1..5] de entero

Para i:=





// Datos de manera DESORDENADA en un ARCHIVO SECUENCIAL ---> proceso estadistico

Accion Ejercicio2 es
    Ambiente
        Satelite = Registro
            ID: N(6)
            p_Acceso: [1,2,3,4]
            Priori: (1..6)
            Estado: ("Exitoso", "Fallido")
        FinRegistro

        ArchSatelite: Archivo de Satelite secuencial no-ordenado
        Reg: Registro de Satelite

        ArrSatelite: Arreglo de (1..7, 1..5) de entero

    Proceso
        Abrir E/ (ArchSatelite)
        Leer(ArchSatelite, Reg)
        Para i:= 1 a 5 hacer
            Para j:= 1 a 7 hacer
                ArrSatelite:= 0
            FinPara
        FinPara

        Mientras NFDA(ArchSatelite) hacer
            ArrSatelite[Reg.Priori, Reg.p_Acceso] := ArrSatelite[Reg.Priori, Reg.p_Acceso] + 1

            ArrSatelite[Reg.Priori, 5] := ArrSatelite[Reg.Priori, 5] + 1 // Total de la FILA (Prioridad)
            ArrSatelite[7, Reg.p_Acceso] := ArrSatelite[7, Reg.p_Acceso] + 1 // Total de la COLUMNA (Punto Acceso)
            ArrSatelite[7, 5] := ArrSatelite[7, 5] + 1 // Gran Total

            Si (Reg.Estado) = "Exitoso" entonces // consigna e
                cont_exitosos:= cont_exitosos + 1
            FinSi
            Leer(ArchSatelite, Reg)
        FinMientras


        resguardo_menor:= HV
        pos_menor:= (0,0)

        Para i := 1 a 6 hacer        // Solo filas de datos
            Para j := 1 a 4 hacer    // Solo columnas de datos
                Si ArrSatelite[i, j] < resguardo_menor entonces
                    resguardo_menor := ArrSatelite[i, j]
                    pos_menor_priori := i
                    pos_menor_punto := j
                FinSi
            FinPara
        FinPara


        resguardo_mayor:= 0
        pos_mayor:= (0,0)

        Para i := 1 a 6 hacer // Miramos las filas de prioridades
            Si ArrSatelite[i, 5] > resguardo_mayor entonces
                resguardo_mayor := ArrSatelite[i, 5]
                prioridad_ganadora := i
            FinSi
        FinPara


        // PUNTO D: Volumen por Punto de Acceso
        Para j := 1 a 4 hacer
            Escribir ("Punto de Acceso ", j, ": ", ArrSatelite[7, j])
        FinPara


        // PUNTO E: Porcentaje de Exitosos
        // Usamos el Gran Total que ya tenemos en ArrSatelite[7, 5]
        Si ArrSatelite[7, 5] > 0 entonces
            Porcentaje := (cont_exitosos / ArrSatelite[7, 5]) * 100
            Escribir ("El porcentaje de éxito es: ", Porcentaje, "%")
        FinSi




// LISTA NUMERO UNO ---> LISTA ANUAL SIN ORDEN
p:= prim
a:= nil

// busco si el cliente existe ya como nodo para solamente actualizarlo o ver para crearlo como nuevo
Mientras (p <> nil) y (p^.cliente <> Reg.Cliente) hacer
    a:= p
    p:= p^.prox
FinMientras

Si (p <> nil) entonces // el cliente existe, entonces lo actualizo
    p^.total_operado:= p^.total_operado + convertir_a_peso(Reg.Importe, Reg.Moneda)
    p^.cant_op:= p^.cant_op + 1
SiNo
    Nuevo(q) // el cliente no existe, inserto nuevo nodo sin necesidad de orden
    q^.total_operado:= q^.total_operado + convertir_a_peso(Reg.Importe, Reg.Moneda)
    q^.cant_op:= 1

    q^.prox:= prim
    prim:= q
FinSi



// RECORRO LA LISTA Y CALCULO AHORA LOS IAF
p:= prim
a:= nil
Mientras (p <> nil) hacer
    p^.IAF:= (p^.total_operado * p^.cant_op)
    p:= p^.prox
FinMientras



// LISTA NUMERO DOS ---> LISTA ORDENADA TIPO RANKING
prim2:= nil
a2:= nil

Nuevo(q2)
q2^.total_operado:
q2^.cant_operado
q2^.
q2^.
Mientras (p2 <> nil) y ( (p2^.iaf > q2^.iaf) o ( (p2^.iaf = q2^.iaf) y (p2^.cant_op >= q2^.cant_op) ) ) hacer
    a2 := p2
    p2 := p2^.prox
FinMientras

Si (a2 = nil) entonces
    q2^.prox:= prim2
    prim2:= q2
SiNo
    a2^.prox:= q2
    q2^.prox:= p2
FinSi



























p := prim;
a := nil;

// Busco si el cliente ya existe
Mientras (p <> nil) y (p^.cliente <> Reg.Cliente) hacer
    a := p;
    p := p^.prox;
FinMientras;

Si (p <> nil) entonces
    // El cliente existe → actualizo
    p^.total_operado := p^.total_operado + convertir_a_peso(Reg.Importe, Reg.Moneda);
    p^.cant_op := p^.cant_op + 1;
Sino
    // Cliente nuevo → creo nodo
    Nuevo(q);
    q^.cliente := Reg.Cliente;
    q^.total_operado := convertir_a_peso(Reg.Importe, Reg.Moneda);
    q^.cant_op := 1;
    q^.IAF := 0;   // todavía no calculado

    q^.prox := prim;
    prim := q;
FinSi



p := prim;

Mientras (p <> nil) hacer
    p^.IAF := p^.total_operado * p^.cant_op;
    p := p^.prox;
FinMientras



prim2 := nil;
p := prim; // p recorre la lista desordenada

Mientras (p <> nil) hacer
    // 1. Creamos el nodo copia
    Nuevo(q2);
    q2^.cliente := p^.cliente;
    q2^.total_operado := p^.total_operado;
    q2^.cant_op := p^.cant_op;
    q2^.IAF := p^.IAF;

    // 2. Buscamos posición en prim2
    p2 := prim2;
    a2 := nil;
    Mientras (p2 <> nil) y ( (p2^.IAF > q2^.IAF) o ( (p2^.IAF = q2^.IAF) y (p2^.cant_op >= q2^.cant_op) ) ) hacer
        a2 := p2;
        p2 := p2^.prox;
    FinMientras;

    // 3. Insertamos el nodo q2
    Si (a2 = nil) entonces
        q2^.prox := prim2;
        prim2 := q2;
    Sino
        a2^.prox := q2;
        q2^.prox := p2;
    FinSi;

    p := p^.prox;
FinMientras;

// 4. Mostrar solo los 5 mejores
Escribir("| POS | CLIENTE | IAF |");
p2 := prim2;
i := 1;
Mientras (p2 <> nil) y (i <= 5) hacer
    Escribir(i, p2^.cliente, p2^.IAF);
    p2 := p2^.prox;
    i := i + 1;
FinMientras;



























Accion Ejercicio2 es
    Ambiente
        Estudiante = Registro
            facultad
            carrera
            legajoprom
            aprobadas
            desaprobadas
            condicion
        FinRegistro

        archestudiantes: archivo de estudiante secuencial ordenado por facultad y carrera
        reg: registro de estudiante

		funcion riesgo_estudiantes(prom, apro, repro): booleano es
			si (prom < 6) y  (repro > apro) entonces
				riesgo_estudiantes:= verdadero
			sino
				riesgo_estudiantes:= falso
			fin si
		fin funcion

        Procedimiento corte_carrera () es
            rta1:= tot_estudiantes / tot_regular * 100%
            escribir("para la carrera: ", resg_carrera " el porcentaje de estudiantes en condicion regular fue de: ", rta1)
            escribir("el estudiante de mejor promedio fue: " resg_mejor_prom, " con un promedio de: ", resg_prom_max)
            escribir("el estudiante de peor  promedio fue: " resg_peor_prom, " con un promedio de: ", resg_prom_min)


        Procedimiento corte_facultad () es













// ----------------------------------------------------------
Busqueda de elemento en lista + insercion ordenada FORMA UNO
// ----------------------------------------------------------

p:= prim
a:= nil
Mientras (p <> nil) y (p.nombre <> reg.nombre) hacer
    a:= p
    p:= p.prox
FinMientras

si (p <> nil) entonces
    p.nombre:= reg.nombre
    p.edad:= reg.edad
    p.sueldo:= p.sueldo + reg.importe
sino
    nuevo(q)
    q.nombre:= reg.nombre
    q.edad:= reg.edad
    q.sueldo:= reg.importe

    p:= prim
    a: nil
    Mientras (p <> nil) y (p.nombre < q.nombre) hacer
        a:= p
        p:= p.prox
    FinMientras

    si (a = nil) entonces
        q.prox:= prim
        prim:= q
    sino
        a.prox:= q
        q.prox:= p
    finsi
finsi








// ----------------------------------------------------------
Busqueda de elemento en lista + insercion ordenada FORMA DOS
// ----------------------------------------------------------

p:= prim
a:= nil
Mientras (p <> nil) y (p.nombre < reg.nombre) hacer
    a:= p
    p:= p.prox
FinMientras

si (p <> nil) y (p.nombre = reg.nombre) entonces
    p.nombre:= reg.nombre
    p.edad:= reg.edad
    p.sueldo:= p.sueldo + reg.importe
sino
    nuevo(q)
    q.nombre:= reg.nombre
    q.edad:= reg.edad
    q.sueldo:= reg.importe

    si (a = nil) entonces
        q.prox:= prim
        prim:= q
    sino
        a.prox:= q
        q.prox:= p
    finsi
finsi
