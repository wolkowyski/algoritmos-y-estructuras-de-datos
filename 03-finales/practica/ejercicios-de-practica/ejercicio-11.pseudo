// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Práctica para el final - Ejercicio 11
//  Ejercicios integradores (secuencias, listas, arreglos) resueltos como práctica.
// ==========================================================================

Accion Ejercicio 11 es

 Ambiente
  sec1: secuencia de caracter;
  a:caracter;
  sec2: secuencia de caracter;
  b: caracter;

  mes: N(2);

  pasajes:N(5);
  cont1:N(5);
  cont2:N(5);
  cont3:N(5);
  cont8:N(5);
  cont10:N(5);

  Funcion convertir(a:caracter):entero
   Según a hacer
    "0": convertir:=0;
    "1": convertir:=1;
    "2": convertir:=2;
    "3": convertir:=3;
    "4": convertir:=4;
    "5": convertir:=5;
    "6": convertir:=6;
    "7": convertir:=7;
    "8": convertir:=8;
    "9": convertir:=9;
    finSegun
   finFuncion




 Algoritmo

  ARR(sec1);
  AVZ(sec1,a);
  Crear(sec2);

  pasajes:=0;
  cont1:=0;
  cont2:=0;
  cont3:=0;
  cont8:=0;
  cont10:=0;


  Escribir("Ingrese el número correspondiente al mes sobre el que desea saber los pasajes");
  Leer(mes);

 Mientras NFDS(sec1) hacer

   Repetir
    AVZ(sec1,a);
   Hasta que a = "#"

  Mientras a <> "&" hacer

   pasajes:= pasajes +1;

   AVZ(sec1,a);
   AVZ(sec1,a);
   AVZ(sec1,a);

   mesu:=convertir(a)*10;

   AVZ(sec1,a);

   mesu:=mesu + convertir(a);

   Para i:=1 hasta 4 hacer
    AVZ(sec1,a);
   finPara


   Si mesu = mes entonces
     Escribir(sec2,a);
     Si a = "1" entonces
      cont1:= cont1 +1;
      Sino
       Si a = "2" entonces
        cont2:= cont2 +1;
        Sino
         Si a = "3" entonces
          cont3:= cont3 +1;
         finSi
        finSino
       finSi
      finSino
     finSi
     Repetir
      AVZ(sec1,a);
      Escribir(sec2,a);
     Hasta que a="-"
     AVZ(sec1,a);
     AVZ(sec1,a);
     Escribir(sec2,"2");

     Si a = "0" entonces
      cont8:= cont8 +1;
      Sino
       cont10:= cont10 +1;
      finSino
     finSi
     Mientras a<> "!" hacer
      Escribir(sec2,a);
      AVZ(sec1,a);
     finMientras
     Sino
      Si a = "1" entonces
       cont1:= cont1 +1;
       Sino
        Si a = "2" entonces
         cont2:= cont2 +1;
         Sino
          Si a = "3" entonces
           cont3:= cont3 +1;
          finSi
         finSino
        finSi
       finSino
      finSi
      Mientras a <> "-" hacer
       AVZ(sec1,a);
      finMientras
      AVZ(sec1,a);
      AVZ(sec1,a);
      Si a = "0" entonces
      cont8:= cont8 +1;
      Sino
       cont10:= cont10 +1;
      finSino
     finSi
     Mientras a <> "!" hacer
      AVZ(sec1,a);
     finMientras
     finSino
    finSi
    AVZ(sec1,a);

   finMientras
  finMientras

  Escribir("La cantidad de pasajes vendidos es: ", pasajes);
  Escribir("La cantidad de pasajes del vuelo 1 es: ", cont1);
  Escribir("La cantidad de pasajes del vuelo 2 es: ", cont2);
  Escribir("La cantidad de pasajes del vuelo 3 es: ", cont3);
  Escribir("El promedio de vuelos a las 20:30hs es:", cont8*100/pasajes, "%");
  Escribir("El promedio de vuelos a las 22:30hs es:", cont10*100/pasajes, "%");


  finAccion



Accion Ejercicio 11.corte es

 Ambiente

  Expedientes=Registro
   Jurisdiccion: [1..6];
   Fuero: {"P", "C", "F", "A"};
   Nro: N(8);
   Caratula: AN(250);
   Fecha=Registro
    AA:N(4);
    MM:[1..12];
    DD: [1..31];
   finRegistro
   Estado: [1..3];
  finRegistro

  Arche: archivo de Expedientes ordenado por Jurisdiccion, fuero, Nro;
  e: Expedientes;

  Salida=Registro
   Jurisdiccion: [1..6];
   Fuero: {"P", "C", "F", "A"};
   cant_i: N(4);
   cant_e: N(4);
   cant_f: N(4);
  finRegistro

  Archs: archivo de salida ordenado por Jurisdiccion, fuero;
  s: salida;

  res_fuero: {"P", "C", "F", "A"};
  res_jurisdiccion: [1..6];

  cant_fuero_i:=entero;
  cant_fuero_f:=entero;
  cant_fuero_e:=entero;
  cant_jurisdiccion_f:=entero;
  cant_jurisdiccion_i:=entero;
  cant_tot_f:=entero;
  cant_tot_i:=entero;

  Procedimiento corte_fuero es
   Escribir("El total de expedientes ingresados en el fuero ", res_fuero, ", en la jurisdiccion ", res_jurisdiccion, " es:", cant_fuero_i);
   Escribir("El total de expedientes finalizados en el fuero ", res_fuero, ", en la jurisdiccion "
   res_jurisdiccion, " es:", cant_fuero_f),
   Escribir("El porcentaje de expedientes finalizados en el fuero ", res_fuero, ", en la jurisdiccion ", res_jurisdiccion, "  es:", cant_fuero_f*100/cant_fuero_i);

   cant_jurisdiccion_i:= cant_jurisdiccion_i + cant_fuero_i;
   cant_jurisdiccion_f:= cant_jurisdiccion_f + cant_fuero_f;

   s.Jurisdiccion:=res_jurisdiccion;
   s.fuero:=res_fuero;
   s.cant_i:=cant_fuero_i;
   s.cant_e:=cant_fuero_e;
   s.cant_f:=cant_fuero_f;
   Escribir(Archs,s);

   cant_fuero_e:=0;
   cant_fuero_f:=0;
   cant_fuero_i:=0;

   res_fuero:=e.fuero;
  finProcedimiento

  Procedimiento corte_jurisdiccion es
   corte_fuero;

   Escribir("El total de expedientes ingresados en la jurisdiccion ", res_jurisdiccion, " es:", cant_jurisdiccion_i);
   Escribir("El total de expedientes finalizados en la jurisdiccion ", res_jurisdiccion, " es:", cant_jurisdiccion_f),
   Escribir("El porcentaje de expedientes finalizados en la jurisdiccion ",res_jurisdiccion, "  es:", cant_jurisdiccion_f*100/cant_jurisdiccion_i);

   cant_tot_i:= cant_tot_i + cant_jurisdiccion_i;
   cant_tot_f:= cant_tot_f + cant_jurisdiccion_f;

   cant_jurisdiccion_f:=0;
   cant_jurisdiccion_i:=0;

   res_jurisdiccion:=e.jurisdiccion;
  finProcedimiento



 Algoritmo

  Abrir(Arche);
  Leer(Arche,e);
  Abrir(Archs);

  res_fuero:= e.fuero;
  res_jurisdiccion:= e.jurisdiccion;

  cant_fuero_i:=0;
  cant_fuero_f:=0;
  cant_fuero_e:=0;
  cant_jurisdiccion_f:=0;
  cant_jurisdiccion_i:=0;
  cant_tot_f:=0;
  cant_tot_i:=0;



  Mientras NFDA(Arche) hacer

  Si res_jurisdiccion <> e.Jurisdiccion entonces
   corte_jurisdiccion
   Sino
    Si res_fuero <> e.fuero entonces
     corte_fuero
    finSi
   finSino
  finSi

  Si e.estado = 1 entonces
   cant_fuero_i:=cant_fuero_i+1;
   Sino
    Si e.estado = 2 entonces
     cant_fuero_e:= cant_fuero_e+1;
     Sino
      Si e.estado = 3 entonces
       cant_fuero_f:= cant_fuero_f+1;
      finSi
     finSino
    finSi
   finSino
  finSi

  Leer(Arche,e);
 finMientras
 corte_jurisdiccion

finAccion
