//consigna 1 en final 21

//consigna 2

Accion ticketec() es

Ambiente

	sec: secuencia de caracter de entrada
	v: caracter

	sec_s: secuencia de caracter de salida

	A: Arreglo [1..18] de alfanumerico

	tot_20, tot_22, tot_gral, por0, por2: entero

Proceso

	ARR(sec)
	AVZ(sec, v)
	CREAR(sec_s)

	tot_20:=0
	tot_22:=0

	Mientras NFDS (sec) hacer

		Mientras (v<>"!") hacer

			Para i:=1 a 11 hacer
				A[i]:=v
				AVZ(sec, v)
			Fin Para

			Si (v="1") entonces

				Para i:=12 a 18 hacer
					A[i]:=v
					AVZ(sec, v)
				Fin Para

				Si (v="0") entonces

					Para i:=1 a 18 hacer
						ESC(sec_s, A[i])
					Fin Para

					Mientras (v<>"!") hacer
						ESC(sec_s, v)
						AVZ(sec, v)
					Fin Mientras
					ESC(sec_s,"!")

					tot_20:=tot_20+1
				Sino
					tot_22:=tot_22+1
					Mientras (v<>"!") hacer
						AVZ(sec, v)
					Fin Mientras
				Fin Si
			Sino
				Para i:=1 a 7 hacer
					AVZ(sec, v)
				Fin Para

				Si (v="0") entonces
					tot_20:=tot_20+1
				Sino
					tot_22:=tot_22+1
				Fin Si

				Mientras (v<>"!") hacer
					AVZ(sec, v)
				Fin Mientras

			Fin Si

		Fin Mientras
		AVZ(sec, v)

	Fin Mientras

	tot_gral:=tot_20+tot_22

	por0:=(tot_20*100)/tot_gral
	por2:=(tot_22*100)/tot_gral

	Escribir("El porcentaje de ventas de tickets en el horario 20.30 es del ",por0,"%")
	Escribir("El porcentaje de ventas de tickets en el horario 22.30 es del ",por2,"%")

Fin Proceso
