//consigna 1
//asumo que todas las claves tienen 7 caracteres sino no se cuando terminan

Accion encriptadas() es

Ambiente

	sec: secuencia de caracter de entrada
	v: caracter

	sal: secuencia de caracter de salida

	vocal:{"a","e","i","o","u"}
	impar:{"1","3","5","7","9"}
	par:{"2","4","6","8","0"}

	cant, err, cont, porcentaje: entero

	A: Arreglo [1..7] de caracter

	correcto: booleano

Proceso

	ARR(sec)
	AVZ(sec, v)

	CREAR(sal)

	err:=0
	cant:=0

	Mientras NFDS (sec) hacer

		cant:=cant+1

		Si (v en par) O (v en impar) entonces
			correcto:=Falso
			Para i:=1 a 7 hacer
				AVZ(sec, v)
			Fin Para
		Sino
			Si (v en vocal) entonces
				cont:=1
				correcto:=Verdadero

				Mientras (cont<=7) hacer
					A[cont]:=v

					Si (v en impar) entonces
						correcto:=Falso
						Para i:=cont a 7 hacer
							AVZ(sec, v)
						Fin Para
						cont:=8
					Fin Si

					Si (cont=7) entonces
						Si (v en vocal) o (v en impar) o (v en par) entonces
							correcto:=Falso
						Fin Si
					Fin Si
					cont:=cont+1
					AVZ(sec, v)
				Fin Mientras

			Sino
				correcto:=Falso
				Para i:=1 a 7 hacer
					A[i]:=v
					Si (v en par) entonces
						correcto:=Verdadero
					Fin Si
				Fin Para

			Fin Si

		Fin Si

		Si (correcto=Verdadero) entonces
			Para i:=1 a 7 hacer
				ESC(sal, A[i])
			Fin Para
			Escribir("La clave ",cant," es correcta")
		Sino
			err:=err+1
			Escribir("La clave ",cant," es errónea")
		Fin Si

	Fin Mientras

	Escribir("La secuencia de entrada tiene ",cant," palabras")
	porcentaje:=(err*100)/cant
	Escribir("El porcentaje de palabras erróneas es del ",porcentaje,"%")

	cerrar(sec)
	cerrar(sal)


Fin Proceso


//consigna 2

Accion clientes(N: Arreglo [1..20] de alfanumerico) es

Ambiente

	fecha=registro
		año:N(4)
		mes:1..12
		dia:1..31
	fin registro

	opiniones=registro
		clave=registro
			usuario:AN(20)
			fecha_op: fecha
		fin registro
		fecha_ult_comp: fecha
		calif: 1..5
		servicio: 1..20
	fin registro

	reg_o: opiniones
	arch_o: archivo de opiniones ordenado por clave

	usuarios=registro
		clave=registro
			usuario:AN(20)
		fin registro
		apenom:AN(50)
		cat:"Silver","Gold"
	fin registro

	reg_u: usuarios
	arch_u: archivo de usuarios indexado por usuario

	A: Arreglo [1..20] de enteros

	cant_op, mayor, may_cant: entero

	usu: alfanumerico

Proceso

	Para i:=1 a 20 hacer
		A[i]:=0
	Fin Para


	ABRIR E/ (arch_o)
	ABRIR E/S (arch_u)

	LEER (arch_o, reg_o)

	Mientras NFDA (arch_o) hacer

		cant_op:=0

		reg_u.clave.usuario:=reg_o.clave.usuario
		LEER (arch_u, reg_u)

		Si (existe) entonces

			Si (reg_o.calif<=2) entonces
				A[reg_o.servicio]:=A[reg_o.servicio]+1
			Fin Si

			usu:=reg_o.clave.usuario

			Mientras (usu=reg_o.clave.usuario) hacer
				cant_op:=cant_op+1
				LEER(arch_o, reg_o)
			Fin Mientras

			Si (cant_op>5) entonces
				reg_u.cat:="Gold"
				REGRABAR(arch_u, reg_u)
			Fin Si

		Sino

			Escribir("No existe el usuario en el archivo usuarios")
			usu:=reg_o.clave.usuario

			Mientras (usu=reg_o.clave.usuario) hacer
				LEER (arch_o, reg_o)
			Fin Mientras

		Fin Si

	Fin Mientras

	mayor:=0

	Para i:=1 a 20 hacer
		Si (A[i]>mayor) entonces
			mayor:=A[i]
			may_cant:=i
		Fin Si
	Fin Para


	Escribir("El servicio con mayor cantidad de calificaciones minimas es ",N[may_cant]", con ",mayor" calificaciones")


	CERRAR(arch_o)
	CERRAR(arch_u)

Fin Proceso
