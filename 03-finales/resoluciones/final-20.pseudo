// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Final - Resolución del modelo de final 20
//  Enunciado: ../enunciados/final-20.jpg
//  Estado: incompleto (resolución sin terminar).
// ==========================================================================

Accion utn() es

Ambiente

	fecha=registro
		año:N(4)
		mes:1..12
		dia:1..31
	fin registro

	notas=registro
		clave=registro
			carrera:1..5
			legajo:N(8)
			materia:1..50
		fin registro
		nota:N(2)
		fecha_ap: fecha
		plan:N(4)
	fin registro

	reg_n: notas
	arch_n: archivo de notas ordenado por clave


	alumnos=registro
		clave=registro
			legajo:N(8)
		fin registro
		nombre:AN(20)
		fecha_ing: fecha
		cant_mat_ap:N(3)
		email:AN(30)
	fin registro

	reg_a: alumnos
	arch_a: archivo de alumnos indexado por legajo

	resg_car, resg_leg, resg_mat, nota, cant, cant_mat, prom_l, prom_m, prom_c, porc, cant_al: entero

	A: Arreglo [1..3, 1..2] de enteros

	Procedimiento corte_mat() es

		Escribir("Carrera: ",resg_car)
		Escribir("Legajo: ",resg_leg)
		Escribir("Materia :",resg_mat)
		Escribir("Alumno: ",reg_a.nombre)

		prom_m:=nota/cant
		Segun (prom_m) hacer
			>6: Escribir("Situación: Promocionado")
			    A[1,1]:=A[1,1]+1
			    reg_a.cant_mat_ap:=reg_a.cant_mat_ap+1
			    REGRABAR(arch_a, reg_a)

			=6: Escribir("Situación: Regular")
			    A[2,1]:=A[2,1]+1
			<6: Escribir("Situación: Recupera")
			    A[3,1]:=A[3,1]+3
		Fin Segun

		resg_mat:=reg_n.clave.mat
		prom_l:=prom_l+prom_m
		nota:=0
		cant:=0

	Fin Procedimiento

	Procedimiento corte_leg()
		corte_mat()

		prom_c:=prom_c+prom_l

		nuevo(q)
		*q.legajo:=resg_leg
		prom_l:=prom_l/cant_mat
		*q.promedio:=prom_l

		Si (prim=nil) entonces
			prim:=q
			*q.prox:=nil
		Sino
			p:=prim
			Mientras (p<>nil) Y (*p.promedio>prom_l) hacer
				a:=p
				p:=*p.prox
			Fin Mientras
			Si (p=prim) entonces
				*q.prox:=p
				prim:=q
			Sino
				*a.prox:=q
				*q.prox:=p
			Fin Si
		Fin Si

		Escribir("Legajo: ",resg_leg)
		Para i:=1 a 3 hacer
			porc:=(A[i,1]*100)/cant_mat
			Segun (i) hacer
				=1: Escribir(porc ,"% de materias promocionadas")
				=2: Escribir(porc ,"% de materias regularizadas")
				=3: Escribir(porc ,"% de materias que debe recuperar")
			Fin Segun
			A[i,2]:=A[i,2]+A[i,1]
			A[i,1]:=0
		Fin Para
		Escribir("Promedio general: ",prom_l)

		cant_mat:=0
		prom_l:=0
		resg_leg:=reg_n.clave.legajo

	Fin Procedimiento

	Procedimiento corte_car()
		corte_mat()
		corte_leg()

		prom_c:=prom_c/cant_al

		Escribir("Carrera: ",resg_car)
		Para i:=1 a 3 hacer
			porc:=(A[i,2]*100)/cant_al
			Segun (i) hacer
				=1: Escribir(porc ,"% de materias promocionadas")
				=2: Escribir(porc ,"% de materias regularizadas")
				=3: Escribir(porc ,"% de materias que debe recuperar")
			Fin Segun
			A[i,2]:=0
		Fin Para

		Escribir("Promedio general: ",prom_c)

		cant_al:=0
		prom_c:=0
		resg_c:=reg_n.clave.carrera
	Fin Procedimiento


	nodo=registro
		legajo: N(8)
		promedio: N(2)
		prox: puntero a nodo
	fin registro

	prim, p, q, a: puntero a nodo


Proceso

	Para i:=1 a 3 hacer
		Para j:=1 a 2 hacer
			A[i,j]:=0
		Fin Para
	Fin Para

	prim:=nil

	ABRIR E/ (arch_n)
	ABRIR E/S (arch_a)
	LEER (arch_n, reg_n)

	nota:=0
	cant:=0
	cant_mat:=0
	prom_l:=0
	prom_c:=0
	cant_al:=0

	resg_car:=reg_n.clave.carrera
	resg_leg:=reg_n.clave.legajo
	resg_mat:=reg_n.clave.materia

	Mientras NFDA (arch_n) hacer

		reg_a.clave.legajo:=reg_n.clave.legajo
		LEER (arch_a, reg_a)

		Si (existe) entonces

			Si (resg_car<>reg_n.clave.carrera) entonces
				corte_car()
			Sino
				Si (resg_leg<>reg_n.clave.legajo) entonces
					cant_al:=cant_al+1
					corte_leg()
				Sino
					Si (resg_mat<>reg_n.clave.materia) entonces
						cant_mat:=cant_mat+1
						corte_mat()
					Fin Si
				Fin Si
			Fin Si



			nota:=nota+reg_n.nota
			cant:=cant+1

		Sino
			Escribir("No existe el legajo en el archivo alumnos")
		Fin Si

		LEER (arch_n ,reg_n)

	Fin Mientras
