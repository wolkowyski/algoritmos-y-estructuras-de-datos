//consigna 1

Accion Audit() es

Ambiente

	horas=registro
		hora:1..24
		min:1..59
		seg:1..59
	Fin registro

	formato1=registro
		val1:N(3)
		val2:N(3)
		val3:N(3)
		val4:N(3)
	fin registro

	formato2=registro
		val1:N(3)
		val2:N(3)
		val3:N(3)
	fin registro

	traffic_global=registro
		clave=registro
			id:N(10)
		fin registro
		prot_red:1..3
		prot_transp:1..2
		puerto_or:(1024..65535)
		puerto_dest:1..1023
		horario: horas
		ip_or: formato1
		ip_dest: formato1
	fin registro

	reg_t: traffic_global
	arch_t: archivo de traffic_global ordenado por id

	iana=registro
		clave=registro
			red:formato2
		fin registro
		cod_isp:N(10)
		descripción:AN(50)
	fin registro

	reg_ia: iana
	arch_ia: archivo de iana indexado por red

	isp=registro
		clave=registro
			cod_isp:N(10)
		fin registro
		cod_cont:1..5
		descripción:AN(50)
	fin registro

	reg_is: isp
	arch_is: archivo de isp indexado por cod_isp

	nodo=registro
		cod_isp:N(10)
		red:formato2
		cant_paq:N(10)
		prox: puntero a nodo
	fin registro

	prim, p, a, q: puntero a nodo

	A: Arreglo [1..6, 1..6] de entero

	x, puerto: entero


Proceso

	prim:=nil

	ABRIR E/ (arch_t)
	ABRIR E/ (arch_ia)
	ABRIR E/ (arch_is)

	Para i:=1 a 6 hacer
		Para j:=1 a 6 hacer
			A[i,j]:=0
		Fin Para
	Fin Para

	LEER(arch_t, reg_t)

	Mientras NFDA (arch_t) hacer

		reg_ia.clave.red.val1:=reg_t.ip_or.val1
		reg_ia.clave.red.val2:=reg_t.ip_or.val2
		reg_ia.clave.red.val3:=reg_t.ip_or.val3
		LEER(arch_ia, reg_ia)

		Si (existe) entonces

			reg_is.clave.cod_isp:=reg_ia.cod_isp
			LEER(arch_is, reg_is)

			Si (existe) entonces

				Si (prim=nil) entonces
					nuevo(q)
					*q.cod_isp:=reg_ia.cod_isp
					*q.red:=reg_ia.clave.red
					*q.cant_paq:=1
					prim:=q
					*q.prox:=nil
				Sino
					p:=prim
					Mientras (p<>nil) Y (*p.cod_isp<>reg_ia.cod_isp) Y (*p.red<>reg_ia.clave.red) hacer
						a:=p
						p:=*p.prox
					Fin Mientras

					Si (p=nil) entonces
						nuevo(q)
						*q.cod_isp:=reg_ia.cod_isp
						*q.red:=reg_ia.clave.red
						*q.cant_paq:=1
						*a.prox:=q
						*q.prox:=nil
					Sino
						*p.cant_paq:=*p.cant_paq+1
					Fin Si

				Fin Si

				x:=0

				Segun (reg_t.puerto_dest) hacer
					=21: x:=1
					=80: x:=2
					=53: x:=3
					=110: x:=4
					=555: x:=5
				Fin Segun

				A[reg_is.cod_cont,6]:=A[reg_is.cod_cont,6]+1

				Si (x<>0) hacer
					A[reg_is.cod_cont,x]:=A[reg_is.cod_cont,x]+1
					A[6,x]:=A[6,x]+1
				Fin Si
			Sino
				Escribir("No existe en el archivo ISP")
			Fin Si

		Sino
			Escribir("No existe en el archivo IANA")
		Fin Si

		LEER (arch_t, reg_t)

	Fin Mientras

	p:=prim
	Mientras (p<>nil) hacer
		Escribir("Codigo ISP: ",*p.cod_isp)
		Escribir("Red: ",*p.red)
		Escribir("Cantidad de paquetes: ",*p.cant_paq)
		p:=*p.prox
	Fin Mientras

	Para i:=1 a 5 hacer
		Para j:=1 a 5 hacer
			Segun (j) hacer
				=1: puerto:=21
				=2: puerto:=80
				=3: puerto:=53
				=4: puerto:=110
				=5: puerto:=555
			Fin Segun

			Escribir("En el continente ",i," y en el puerto ",puerto," hubo ",A[i,j]," paquetes")

		Fin Para
	Fin Para

	Para i:=1 a 5 hacer
		Segun (i) hacer
			=1: puerto:=21
			=2: puerto:=80
			=3: puerto:=53
			=4: puerto:=110
			=5: puerto:=555
		Fin Segun
		Escribir("En el continente ",i," hubo en total ",A[i,6]," paquetes")
		Escribir("En el puerto ",puerto, "hubo en total ",A[6,i]," paquetes")
	Fin Para

	CERRAR (arch_t)
	CERRAR (arch_ia)
	CERRAR (arch_is)

Fin Proceso


//consigna 2

Accion recital() es

Ambiente

	sec: secuencia de caracter de entrada
	v: caracter

	vip: secuencia de caracter de salida

	nodo=registro
		sector: Arreglo [1..2] de caracter
		cant: N(5)
		prox: puntero a nodo
	fin registro

	prim, p, a, q: puntero a nodo

	A: Arreglo [1..8] de caracter

	car1: caracter

	Procedimiento lista() es
		Si (prim=nil) entonces
			nuevo(q)
			*q.sector[1]:=car1
			*q.sector[2]:=v
			*q.cant:=1
			prim:=q
			*q.prox:=nil
		Sino
			p:=prim
			Mientras (p<>nil) Y (*p.sector[1]<>car1) Y (*p.sector[2]<>v) hacer
				a:=p
				p:=*p.prox
			Fin Mientras

			Si (p=nil) entonces
				nuevo(q)
				*q.sector[1]:=car1
				*q.sector[2]:=v
				*q.cant:=1
				*a.prox:=q
				*q.prox:=nil
			Sino
				*p.cant:=*p.cant+1
			Fin Si

		Fin Si
	Fin Procedimiento

	par: {"0","2","4","6","8"}

Proceso

	prim:=nil

	ARR(sec)
	AVZ(sec, v)

	CREAR(vip)

	Mientras NFDS (sec) hacer

		Mientras (v<>"!") hacer

			Para i:=1 a 8 hacer
				A[i]:=v
				AVZ(sec, v)
			Fin Para

			car1:=v
			AVZ(sec, v)

			lista()

			Si (v en par) entonces

				Para i:=1 a 8 hacer
				ESC(vip, A[i])
				Fin Para

				ESC(vip, car1)

				Mientras (v<>"!") hacer
					ESC(vip, v)
					AVZ(sec, v)
				Fin Mientras

			Sino

				Mientras (v<>"!") hacer
					AVZ(sec, v)
				Fin Mientras

			Fin Si

		Fin Mientras

		AVZ(sec, v)

	Fin Mientras

	p:=prim

	Mientras (p<>nil) hacer

		Escribir("Sector: ",*p.sector[1],*p.sector[2])
		Escribir("Cantidad de entradas: ",*p.cant)
		p:=*p.prox

	Fin Mientras


Fin Proceso
