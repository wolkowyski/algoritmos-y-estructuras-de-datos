// --------------------------------------------------------------------------
// Ejercicio 1 (40 puntos)
// En los últimos años diversos negocios adoptaron plataformas de e-commerce
// para comercializar sus productos al público. Tal es el caso de
// "DigitalArt", una empresa de venta de cuadros y obras de arte. Uno de los
// procesos asociados al negocio online tiene que ver con el seguimiento de
// las preferencias de clientes en las categorías de productos.
// Para ello cuenta con una secuencia de caracteres donde almacena:
//   TipoCte AN(1) CodCte N(6) Edad N(2) CodProd AN(variable) -
//   Pref(M-máxima D-deseable N-nula)/
// (AN = carácter alfanumérico, N = carácter dígito numérico)
// Por ejemplo: B23412320ABEEPP-M/B1897864329IK-D/P90876532UJHYN9-M
// El tipo de cliente puede ser B-Básico P-Premium. Los datos de cada registro
// de preferencia se separan entre sí con el símbolo /.
// Se desconoce la cantidad de productos que han sido registrados. Por ello se
// pide un algoritmo que permita procesar cada preferencia de forma tal de
// obtener:
//   - Cantidad de compras por Código de Producto.
//   - Promedio de edad de clientes que han indicado preferencias del tipo Nula.
//   - Información sobre productos para los cuales se han registrado mayor
//     cantidad de preferencia Nula que Deseable.
// --------------------------------------------------------------------------

// Como no se sabe cuántos productos hay, se usa una lista con un nodo por
// código de producto (ordenada por código para cortar la búsqueda antes).
// Cada registro de preferencia cuenta como una compra del producto.
// Supuesto: el último registro puede terminar en "/" o directamente en el
// fin de la secuencia.

Accion digitalart() es

Ambiente

	sec: secuencia de caracter
	v: caracter

	nodo=registro
		cod_prod: AN(20)
		compras: entero
		nulas: entero
		deseables: entero
		prox: puntero a nodo
	fin registro

	prim, p, a, q: puntero a nodo

	cod: AN(20)
	pref: caracter
	edad, i, suma_edad, cant_nula: entero

	Funcion car_a_ent(c: caracter): entero es
		Segun (c) hacer
			="0": car_a_ent:=0
			="1": car_a_ent:=1
			="2": car_a_ent:=2
			="3": car_a_ent:=3
			="4": car_a_ent:=4
			="5": car_a_ent:=5
			="6": car_a_ent:=6
			="7": car_a_ent:=7
			="8": car_a_ent:=8
			="9": car_a_ent:=9
		Fin Segun
	Fin Funcion

	// deja en p el nodo del producto cod (lo crea si no existe)
	Procedimiento buscar_producto() es
		a:=nil
		p:=prim
		Mientras (p<>nil) y (*p.cod_prod<cod) hacer
			a:=p
			p:=*p.prox
		Fin Mientras
		Si (p=nil) o (*p.cod_prod<>cod) entonces
			nuevo(q)
			*q.cod_prod:=cod
			*q.compras:=0
			*q.nulas:=0
			*q.deseables:=0
			*q.prox:=p
			Si (a=nil) entonces
				prim:=q
			Sino
				*a.prox:=q
			Fin Si
			p:=q
		Fin Si
	Fin Procedimiento

Proceso

	prim:=nil
	suma_edad:=0
	cant_nula:=0

	ARR(sec)
	AVZ(sec, v)

	Mientras NFDS(sec) hacer

		AVZ(sec, v)                 // salteo TipoCte (no se usa)
		Para i:=1 a 6 hacer         // salteo CodCte
			AVZ(sec, v)
		Fin Para

		edad:=car_a_ent(v)*10
		AVZ(sec, v)
		edad:=edad+car_a_ent(v)
		AVZ(sec, v)

		cod:=""
		Mientras (v<>"-") hacer
			cod:=cod + v
			AVZ(sec, v)
		Fin Mientras
		AVZ(sec, v)                 // salteo el "-"
		pref:=v
		AVZ(sec, v)                 // queda en "/" o en el fin de la secuencia
		Si NFDS(sec) entonces
			AVZ(sec, v)             // salteo el "/"
		Fin Si

		buscar_producto()
		*p.compras:=*p.compras+1
		Segun (pref) hacer
			="N":
				*p.nulas:=*p.nulas+1
				suma_edad:=suma_edad+edad
				cant_nula:=cant_nula+1
			="D":
				*p.deseables:=*p.deseables+1
		Fin Segun

	Fin Mientras
	CERRAR(sec)

	Escribir("Compras por código de producto:")
	p:=prim
	Mientras (p<>nil) hacer
		Escribir("  ", *p.cod_prod, ": ", *p.compras)
		p:=*p.prox
	Fin Mientras

	Si (cant_nula>0) entonces
		Escribir("Promedio de edad de los clientes con preferencia Nula: ", suma_edad/cant_nula)
	Sino
		Escribir("Ningún cliente indicó preferencia Nula")
	Fin Si

	Escribir("Productos con más preferencias Nula que Deseable:")
	p:=prim
	Mientras (p<>nil) hacer
		Si (*p.nulas>*p.deseables) entonces
			Escribir("  ", *p.cod_prod, " (", *p.nulas, " nulas, ", *p.deseables, " deseables)")
		Fin Si
		p:=*p.prox
	Fin Mientras

Fin Accion


// --------------------------------------------------------------------------
// Ejercicio 2 (40 puntos)
// Trabajamos en el área de Control de Proyectos de Software. Y tenemos un
// archivo que almacena tickets resueltos por cada equipo de proyecto, con
// registros que tienen el siguiente formato:
//   SITE AN(10), AREA AN(5), VERSIÓN (W-Web / M-Mobile), INTEGRANTES 3..6,
//   TICKETS RESUELTOS N(3), ESTADO DEL PROYECTO (F-Finalizado E-En proceso)
// El archivo está ordenado por Site, Area y Versión.
// Se necesita emitir un informe de la cantidad de tickets resueltos de todos
// los proyectos de equipos de más de 4 integrantes que no estén Finalizados.
// Informar el total de proyectos, en estas condiciones, por Site, Area,
// Versión y Total General.
// Obtener un archivo de salida con el siguiente formato:
//   SITE - Total de Tickets Resueltos
// --------------------------------------------------------------------------

// Corte de control de tres niveles (Site > Area > Versión).
// corregido: los resguardos de área y versión se inicializaban con reg_a
// (que no existe) en vez de reg_t; se agregó la cantidad de proyectos que
// cumplen la condición, que la consigna también pide.

Accion proyectos() es

Ambiente

	tickets=registro
		clave=registro
			site:AN(10)
			area:AN(5)
			version:"W","M"
		fin registro
		integrantes:3..6
		tickets_res:N(3)
		est_proy:"F","E"
	fin registro

	reg_t: tickets
	arch_t: archivo de tickets ordenado por clave

	// el archivo de salida lleva el total de tickets de cada site (de todos
	// los proyectos, porque la consigna no le pone las condiciones del informe)

	salida=registro
		site:AN(10)
		tot_tickets:N(5)
	fin registro

	reg_s: salida
	arch_s: archivo de salida

	resg_s, resg_a, resg_v: alfanumerico
	tot_s, tot_a, tot_v, tot_gral, tick_s: entero
	pro_s, pro_a, pro_v, pro_gral: entero   // proyectos que cumplen

	Procedimiento corte_version() es
		Escribir("El total de tickets resueltos para proyectos no finalizados con más de 4 integrantes para la versión: ",resg_v," es de ",tot_v," (",pro_v," proyectos)")
		tot_a:=tot_a+tot_v
		pro_a:=pro_a+pro_v
		tot_v:=0
		pro_v:=0
		resg_v:=reg_t.clave.version
	Fin Procedimiento

	Procedimiento corte_area() es
		corte_version()
		Escribir("El total de tickets resueltos para proyectos no finalizados con mas de 4 integrantes para el area: ",resg_a," es de ",tot_a," (",pro_a," proyectos)")
		tot_s:=tot_s+tot_a
		pro_s:=pro_s+pro_a
		tot_a:=0
		pro_a:=0
		resg_a:=reg_t.clave.area
	Fin Procedimiento

	Procedimiento corte_site() es
		corte_area()
		Escribir("El total de tickets resueltos para proyectos no finalizados con mas de 4 integrantes para el site: ",resg_s," es de ",tot_s," (",pro_s," proyectos)")
		tot_gral:=tot_gral+tot_s
		pro_gral:=pro_gral+pro_s
		tot_s:=0
		pro_s:=0

		reg_s.site:=resg_s
		reg_s.tot_tickets:=tick_s
		GRABAR(arch_s, reg_s)

		tick_s:=0

		resg_s:=reg_t.clave.site

	Fin Procedimiento

Proceso

	ABRIR E/ (arch_t)
	ABRIR /S (arch_s)
	LEER (arch_t, reg_t)

	resg_s:=reg_t.clave.site
	resg_a:=reg_t.clave.area       // corregido: decía reg_a
	resg_v:=reg_t.clave.version

	tot_s:=0
	tot_a:=0
	tot_v:=0
	tot_gral:=0
	tick_s:=0
	pro_s:=0
	pro_a:=0
	pro_v:=0
	pro_gral:=0


	Mientras No FDA (arch_t) hacer

		Si (resg_s<>reg_t.clave.site) entonces
			corte_site()
		Sino
			Si (resg_a<>reg_t.clave.area) entonces
				corte_area()
			Sino
				Si (resg_v<>reg_t.clave.version) entonces
					corte_version()
				Fin Si
			Fin Si
		Fin Si

		Si (reg_t.integrantes>4) entonces
			Si (reg_t.est_proy="E") entonces
				tot_v:=tot_v+reg_t.tickets_res
				pro_v:=pro_v+1
			Fin Si
		Fin Si

		tick_s:=tick_s+reg_t.tickets_res

		LEER(arch_t, reg_t)

	Fin Mientras

	corte_site()

	Escribir("El total general de tickets resueltos para proyectos no finalizados con mas de 4 integrantes es de ",tot_gral," (",pro_gral," proyectos)")

	CERRAR(arch_t)
	CERRAR(arch_s)

Fin Proceso


// --------------------------------------------------------------------------
// Ejercicio 3 (20 puntos)
// El recorrido en pre-orden de un determinado árbol binario es:
// GEAIBMCLDFKJH y en-orden IABEGLDCFMKHJ. Resolver:
//   A. Dibujar el árbol binario.
//   B. Dar el recorrido en post-orden.
//   C. Escribir una función recursiva que encuentre un valor dado en un
//      árbol binario.
// --------------------------------------------------------------------------

// A. La raíz es la primera del pre-orden (G). En el en-orden, lo que está a
//    la izquierda de G (IABE) es el subárbol izquierdo y lo de la derecha
//    (LDCFMKHJ) el derecho; se repite con cada subárbol.
//
//                 G
//              /     \
//            E         M
//           /        /   \
//          A        C     K
//         / \      / \     \
//        I   B    L   F     J
//                  \       /
//                   D     H
//
// B. Post-orden: I B A E D L F C H J K M G
//
// C. No es un ABB, así que no se puede elegir una rama: si no está en la
//    raíz, se busca en los dos subárboles.

Funcion Buscar(r: puntero a nodo, x: caracter): booleano es
	Si (r=nil) entonces
		Buscar:=falso                       // caso base: árbol vacío
	Sino
		Si (*r.dato=x) entonces
			Buscar:=verdadero               // caso base: lo encontré
		Sino
			Buscar:=Buscar(*r.izq, x) o Buscar(*r.der, x)
		Fin Si
	Fin Si
Fin Funcion
