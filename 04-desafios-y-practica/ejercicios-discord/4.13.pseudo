// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de TP 4 (Listas) - Ejercicio 4.13 - resolución compartida en Discord
//  Revisado: los cambios están marcados con "// corregido"
// ==========================================================================

// Dada una lista doblemente encadenada de enteros, ordenada en forma
// creciente, escriba un algoritmo que elimine las entradas repetidas. El
// algoritmo debe verificar al inicio que la lista que se pasa como argumento
// está ordenada; en caso afirmativo realizar la depuración y emitir un
// mensaje de 'ÉXITO'; en caso contrario, emitir un mensaje de 'ERROR'.

ACCION Ejercicio4_13 ES(prim: puntero a NODO)
AMBIENTE
NODO = registro
    dato: N(8)
    prox: puntero a NODO
    ant: puntero a NODO
FIN_REGISTRO
a,p,s: puntero a NODO
bandera: booleano                   // verdadero = la lista NO está ordenada

ALGORITMO
bandera := falso                    // corregido: se usaba sin inicializar
SI prim <> nil ENTONCES             // corregido: con la lista vacía *prim.prox se rompía
    a := prim
    p := *prim.prox
    MIENTRAS p <> nil HACER
        SI *a.dato > *p.dato ENTONCES
            bandera := verdadero
        FIN_SI
        a := p
        p := *p.prox
    FIN_MIENTRAS
FIN_SI

SI bandera = verdadero ENTONCES
    ESCRIBIR("ERROR")
SINO
    SI prim <> nil ENTONCES
        a := prim
        p := *prim.prox
        MIENTRAS p <> nil HACER
            SI *a.dato = *p.dato ENTONCES   // p es repetido: lo saco y a se queda
                s := *p.prox
                *a.prox := s
                SI s <> nil ENTONCES        // corregido: si p era el último, *s.ant se rompía
                    *s.ant := a
                FIN_SI
                DISPONER(p)
                p := s                      // corregido: antes se salteaba un nodo
            SINO
                a := p
                p := *p.prox
            FIN_SI
        FIN_MIENTRAS
    FIN_SI
    ESCRIBIR("EXITO")               // corregido: el mensaje va después de depurar
FIN_SI
FIN_ACCION.                         // corregido: faltaba el cierre
