// Dada una lista simplemente encadenada de números diseñar un algoritmo que
// calcule en forma independiente la suma de los números impares y la suma
// de los números pares.

ACCION Ejercicio4_3 ES(prim: puntero a NODO)
AMBIENTE
NODO = registro
    dato: entero
    prox: puntero a NODO
FIN_REGISTRO
p: puntero a NODO
impares, pares: entero

ALGORITMO
impares := 0
pares := 0
p := prim
MIENTRAS p <> nil HACER
    SI *p.dato MOD 2 = 0 ENTONCES
        pares := pares + *p.dato
    SINO
        impares := impares + *p.dato
    FIN_SI
    p := *p.prox
FIN_MIENTRAS
ESCRIBIR("SUMA DE PARES: ", pares, " SUMA DE IMPARES: ", impares)
FIN_ACCION.
