// ==========================================================================
//  Algoritmos y Estructuras de Datos - UTN FRRe (Ing. en Sistemas)
//  Guía de TP 4 (Listas) - Ejercicio 4.9 - resolución compartida en Discord
//  Revisado: los cambios están marcados con "// corregido"
// ==========================================================================

// Dada una lista circular de 8 elementos que contienen, cada uno, un valor
// numérico entero para encriptación, encriptar un texto ingresado por teclado
// (arreglo de caracteres de 255 elementos como máximo). El texto encriptado
// debe almacenarse en una lista de salida simplemente encadenada y, por
// último, mostrar por pantalla.
//
//   ENCRIPTAR: | Multiplicador N(5) | Prox Puntero |
//
// La encriptación se realiza según las siguientes pautas:
//   1. Dada la posición del carácter dentro del texto, buscar en la lista
//      circular de encriptación el multiplicador correspondiente, de acuerdo
//      a su posición lógica en la lista. Por ejemplo: como solo hay 8
//      multiplicadores, si se ingresa un arreglo de 10 caracteres, para
//      encriptar los últimos dos se utilizarían los multiplicadores 1 y 2.
//   2. Se usa la función ASCII(Carácter) para convertir cada carácter del
//      arreglo en un entero.
//   3. Se multiplican los valores obtenidos en los 2 pasos anteriores.
//   4. Se descompone el resultado obtenido en 3 en cada uno de sus dígitos,
//      se los suma y se guarda en la lista de salida.
//      Ej: si en el paso 3 dio 123, 1+2+3 = 6.

// Supuesto: además del texto se recibe n, la cantidad de caracteres
// ingresados (antes se cortaba en texto[i] <> "", que en un arreglo de
// caracteres no sirve: no hay un carácter "vacío").
// Como la lista es circular, al avanzar p1 después del octavo se vuelve
// solo al primero, que es justo lo que pide el paso 1.

ACCION Ejercicio4_9 ES(prim1: puntero a NODO1, texto: arreglo [1..255] de caracter, n: entero)
AMBIENTE
NODO1 = registro
    Multiplicador: N(5)
    prox: puntero a NODO1           // corregido: apuntaba a NODO
FIN_REGISTRO
NODO2 = registro
    numero: entero
    prox: puntero a NODO2
FIN_REGISTRO
p1: puntero a NODO1
prim2,p2,a2: puntero a NODO2        // corregido: no tenían tipo
multiplicacion,i: entero

FUNCION Suma(a: entero): entero     // suma de los dígitos de a
    AMBIENTE
        b: entero
    ALGORITMO
        b := 0
        MIENTRAS a >= 10 HACER
            b := b + (a MOD 10)
            a := a DIV 10
        FIN_MIENTRAS
        Suma := a + b
FIN_FUNCION

ALGORITMO
prim2 := nil
p1 := prim1                         // corregido: decía p1:prim1
PARA i := 1 hasta n HACER
    multiplicacion := *p1.Multiplicador * ASCII(texto[i])
    NUEVO(p2)
    *p2.numero := Suma(multiplicacion)
    *p2.prox := nil                 // corregido: el último quedaba sin cerrar
    SI prim2 = nil ENTONCES
        prim2 := p2
    SINO
        *a2.prox := p2
    FIN_SI
    a2 := p2
    p1 := *p1.prox
FIN_PARA

// corregido: faltaba mostrar el texto encriptado
p2 := prim2
MIENTRAS p2 <> nil HACER
    ESCRIBIR(*p2.numero)
    p2 := *p2.prox
FIN_MIENTRAS
FIN_ACCION.
